# विश्लेषकपरीक्षा — the Vāk-written analyser, made machine-readable so the Python
# analyser and this one can be compared line by line.  Each diagnostic prints as
#     दोषः|सङ्केतः|पङ्क्तिः|सन्देशः
# See tests/test_vak.py :: TestVakAnalyzer.

आनय "स्वयंसिद्धिः/शब्दविभाजकः" इति विभाजकः।
आनय "स्वयंसिद्धिः/व्याकरणम्" इति व्याकरणम्।
आनय "स्वयंसिद्धिः/अर्थविश्लेषकः" इति विश्लेषकः।

सूची प्रा = प्राचलाः()।
शब्दः मूलम् = सञ्चिकापठ(प्रा[०])।
सूची सूचनाः = विश्लेषकः.विश्लेषय(व्याकरणम्.रचय_वाक्यरचनाम्(विभाजकः.विभज_मूलम्(मूलम्)))।
प्रत्येकम् (सू अन्तः सूचनाः) {
    शब्दः चिह्नम् = "सूचना"।
    यदि (सू.घातकः) { चिह्नम् = "दोषः"। }
    मुद्रय चिह्नम् + "|" + सू.सङ्केतः + "|" + देवनागरी(सू.पङ्क्तिः) + "|" + सू.सन्देशः।
}
