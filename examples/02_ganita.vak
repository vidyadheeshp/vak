# ०२ — गणितम् / Arithmetic and operators

मान अ = १२।
मान ब = ५।

मुद्रय("अ =", अ, " ब =", ब)।
मुद्रय("योगः      अ + ब =", अ + ब)।
मुद्रय("व्यवकलनम्  अ - ब =", अ - ब)।
मुद्रय("गुणनम्     अ * ब =", अ * ब)।
मुद्रय("भागः      अ / ब =", अ / ब)।
मुद्रय("शेषः      अ % ब =", अ % ब)।
मुद्रय("घातः      अ ^ २ =", अ ^ २)।

# तुलना / comparison
मुद्रय("अ > ब :", अ > ब)।
मुद्रय("अ == १२ :", अ == १२)।
मुद्रय("अ != ब :", अ != ब)।

# तर्कः — च (and), वा (or), न (not)
मुद्रय("(अ > ० च ब > ०) =", अ > ० च ब > ०)।
मुद्रय("(अ < ० वा ब > ०) =", अ < ० वा ब > ०)।
मुद्रय("न सत्य =", न सत्य)।

# अङ्काः देवनागर्याम् अथवा रोमन्-लिप्याम् — उभयम् समानम्
# Devanagari and ASCII numerals mean exactly the same thing
मुद्रय("१०० + 100 =", १०० + 100)।

# गणितकार्याणि / math built-ins
मुद्रय("मूल(१४४) =", मूल(१४४))।
मुद्रय("पूर्ण(७.९) =", पूर्ण(७.९))।
मुद्रय("न्यूनतम / अधिकतम:", न्यूनतम([४, २, ९]), अधिकतम([४, २, ९]))।
मुद्रय("योग([१..५]) =", योग(परास(१, ६)))।
