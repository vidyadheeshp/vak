# ०९ — प्रत्येकम् — पाशाः / For-each loops, nesting, break and continue

# सूच्याम् भ्रमणम् / over a list
प्रत्येकम् (ऋतुः अन्तः ["वसन्तः", "ग्रीष्मः", "वर्षा", "शरद्", "हेमन्तः", "शिशिरः"]) {
    मुद्रय("ऋतुः:", ऋतुः)।
}

# परासे भ्रमणम् / over a range
मुद्रय("")।
प्रत्येकम् (क अन्तः परास(१, ६)) {
    मुद्रय("वर्गः", देवनागरी(क), "=", देवनागरी(क ^ २))।
}

# शब्दस्य अक्षरेषु / over the characters of a string
मुद्रय("")।
मान अक्षराणि = []।
प्रत्येकम् (अ अन्तः "वाक्") {
    योजय(अक्षराणि, अ)।
}
मुद्रय("अक्षराणि:", अक्षराणि)।

# घटितपाशाः — गुणनसारणी / nested loops: a multiplication table
मुद्रय("")।
मुद्रय("गुणनसारणी / multiplication table")।
प्रत्येकम् (पङ्क्तिः अन्तः परास(१, ६)) {
    मान रेखा = ""।
    प्रत्येकम् (स्तम्भः अन्तः परास(१, ६)) {
        रेखा = रेखा + देवनागरी(पङ्क्तिः * स्तम्भः) + "\t"।
    }
    मुद्रय(रेखा)।
}

# विरम / अनुवर्त — प्रथमः त्र्यङ्कः यः ७ इत्यनेन भाज्यः
मुद्रय("")।
प्रत्येकम् (क अन्तः परास(१००, १०००)) {
    यदि (क % ७ != ०) {
        अनुवर्त।
    }
    मुद्रय("प्रथमः त्र्यङ्कः सप्तभाज्यः:", देवनागरी(क))।
    विरम।
}

# अभाज्याः / prime numbers below 50
कार्यम् अभाज्यः_वा(संख्या_) {
    यदि (संख्या_ < २) { प्रत्यागच्छ असत्य। }
    मान भाजकः = २।
    यावत् (भाजकः * भाजकः <= संख्या_) {
        यदि (संख्या_ % भाजकः == ०) {
            प्रत्यागच्छ असत्य।
        }
        भाजकः = भाजकः + १।
    }
    प्रत्यागच्छ सत्य।
}

मान अभाज्याः = []।
प्रत्येकम् (क अन्तः परास(२, ५०)) {
    यदि (अभाज्यः_वा(क)) {
        योजय(अभाज्याः, क)।
    }
}
मुद्रय("")।
मुद्रय("५० तः न्यूनाः अभाज्याः:", अभाज्याः)।
