# ११ — प्रकाराः / Declared types
#
# प्रकारः वैकल्पिकः — यत्र लिखितः तत्र पाल्यते।
# Types are optional; where you write one, it is enforced — at declaration,
# at assignment, when an argument is passed, and when a कार्यम् returns.

# ---------------------------------------------------- प्रकारसहिता घोषणा
पूर्णाङ्कः वयः = ३०।
दशांशः भारः = ६७.५।
शब्दः नाम = "आर्यभटः"।
सत्यता छात्रः = सत्य।
सूची विषयाः = ["गणितम्", "ज्योतिषम्"]।
कोशः विवरणम् = { "नगरम्": "कुसुमपुरम्" }।

मुद्रय नाम, वयः, भारः, छात्रः।
मुद्रय विषयाः, विवरणम्।

# समः अर्थः — 'मान' सह प्रकारः, अथवा ':' चिह्नेन
मान पूर्णाङ्कः गणकः = ०।
मान अन्तरम् : दशांशः = २.५।
ध्रुव दशांशः पाई = ३.१४१५९।
मुद्रय गणकः, अन्तरम्, पाई।

# प्रकाररहिता घोषणा — 'किमपि' मूल्यम् स्वीकरोति
मान किमपि_मूल्यम् = "अद्य शब्दः"।
किमपि_मूल्यम् = ४२।                 # दोषः नास्ति — प्रकारः न घोषितः
मुद्रय "प्रकाररहितम्:", किमपि_मूल्यम्, प्रकार(किमपि_मूल्यम्)।

# ---------------------------------------------------- प्रकारसहितानि कार्याणि
कार्यम् क्षेत्रफलम्(दशांशः दैर्घ्यम्, दशांशः विस्तारः) : दशांशः {
    प्रत्यागच्छ दैर्घ्यम् * विस्तारः।
}
मुद्रय "क्षेत्रफलम् =", क्षेत्रफलम्(७.५, ४)।

कार्यम् अभिवादनम्(शब्दः कस्य) : शब्दः {
    प्रत्यागच्छ "नमस्ते " + कस्य + "!"।
}
मुद्रय अभिवादनम्("गार्गि")।

# प्राचलः ':' चिह्नेन अपि लिख्यते
कार्यम् वर्गः(अङ्कः : अङ्कः) : अङ्कः {
    प्रत्यागच्छ अङ्कः ^ २।
}
मुद्रय "वर्गः(१२) =", वर्गः(१२)।

# ---------------------------------------------------- स्थैतिकम् गतिकम् च
# अर्थविश्लेषकः (python -m vaak --check) यत् सिद्धम् तत् प्रोग्रामस्य चालनात् पूर्वमेव
# गृह्णाति — यथा  'पूर्णाङ्कः क = "अ"।'  इति स्पष्टः दोषः।
# अधः 'अनिश्चितम्' इति कार्यम् 'किमपि' प्रत्यागच्छति, अतः विश्लेषकः न जानाति यत्
# किम् आगमिष्यति — तादृशः दोषः कार्यकाले एव प्रकटति, प्रयत्नेन च गृह्यते।
कार्यम् अनिश्चितम्(म) { प्रत्यागच्छ म। }

# ---------------------------------------------------- प्रकारदोषाः (कार्यकाले)
प्रयत्नः {
    वयः = अनिश्चितम्("त्रिंशत्")।      # पूर्णाङ्कः इति घोषितः!
} दोषे (द) {
    मुद्रय "गृहीतः →", द.प्रकारः।
    मुद्रय "        ", द.सन्देशः।
}

प्रयत्नः {
    मुद्रय अभिवादनम्(अनिश्चितम्(४२))। # शब्दः अपेक्षितः
} दोषे (द) {
    मुद्रय "गृहीतः →", द.प्रकारः।
    मुद्रय "        ", द.सन्देशः।
}

प्रयत्नः {
    कार्यम् दुष्टम्() : पूर्णाङ्कः { प्रत्यागच्छ अनिश्चितम्("न अङ्कः")। }
    दुष्टम्()।
} दोषे (द) {
    मुद्रय "गृहीतः →", द.प्रकारः।
    मुद्रय "        ", द.सन्देशः।
}

# पूर्णाङ्कः दशांशः च — पूर्णाङ्कः दशांशत्वेन स्वीक्रियते, न विपरीतम्
दशांशः विस्तृतः = ५।                  # ५ → दशांशः, साधु
मुद्रय "दशांशः विस्तृतः =", विस्तृतः।
प्रयत्नः {
    पूर्णाङ्कः सङ्कुचितः = अनिश्चितम्(५.५)।   # दशांशः → पूर्णाङ्कः, न साधु
} दोषे (द) {
    मुद्रय "गृहीतः →", द.प्रकारः, "—", द.सन्देशः।
}
