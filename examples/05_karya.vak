# ०५ — कार्याणि / Functions

# सामान्यम् कर्म / a plain function
कार्यम् अभिवादनम्(नाम) {
    प्रत्यागच्छ "नमस्ते " + नाम + "!"।
}
मुद्रय(अभिवादनम्("मैत्रेयि"))।

# बहुप्राचलानि / several parameters
कार्यम् क्षेत्रफलम्(दैर्घ्यम्, विस्तारः) {
    प्रत्यागच्छ दैर्घ्यम् * विस्तारः।
}
मुद्रय("क्षेत्रफलम् =", क्षेत्रफलम्(७, ६))।

# आवर्तनम् / recursion — क्रमगुणितम् (factorial)
कार्यम् क्रमगुणितम्(न्यूनम्) {
    यदि (न्यूनम् <= १) {
        प्रत्यागच्छ १।
    }
    प्रत्यागच्छ न्यूनम् * क्रमगुणितम्(न्यूनम् - १)।
}
मुद्रय("क्रमगुणितम्(१०) =", क्रमगुणितम्(१०))।

# परस्परावर्तनम् / mutual recursion
कार्यम् समः(क) { यदि (क == ०) { प्रत्यागच्छ सत्य। } प्रत्यागच्छ विषमः(क - १)। }
कार्यम् विषमः(क) { यदि (क == ०) { प्रत्यागच्छ असत्य। } प्रत्यागच्छ समः(क - १)। }
मुद्रय("समः(१०) =", समः(१०), " विषमः(१०) =", विषमः(१०))।

# कर्म अपि मूल्यम् एव — उच्चतरक्रमकार्याणि / functions are values
मान द्विगुणम् = कार्यम्(क) { प्रत्यागच्छ क * २। }।
मुद्रय("द्विगुणम्(२१) =", द्विगुणम्(२१))।

कार्यम् प्रयोगः(कर्म, सूची_) {
    मान फलम् = []।
    प्रत्येकम् (सदस्यः अन्तः सूची_) {
        योजय(फलम्, कर्म(सदस्यः))।
    }
    प्रत्यागच्छ फलम्।
}
मुद्रय("प्रयोगः(द्विगुणम्, [१,२,३,४]) =", प्रयोगः(द्विगुणम्, [१, २, ३, ४]))।

# आवरणम् / closures — कर्म स्वस्य परिवेशम् स्मरति
कार्यम् गणकनिर्माता(आरम्भः) {
    मान संख्या_ = आरम्भः।
    प्रत्यागच्छ कार्यम्() {
        संख्या_ = संख्या_ + १।
        प्रत्यागच्छ संख्या_।
    }।
}
मान गणय = गणकनिर्माता(१००)।
मुद्रय(गणय(), गणय(), गणय())।
