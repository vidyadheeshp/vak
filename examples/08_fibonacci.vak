# ०८ — पिङ्गलच्छन्दः / The Fibonacci (Piṅgala–Hemacandra) numbers
#
# एषा श्रेणी पिङ्गलेन "छन्दःशास्त्रे" (मात्रामेरुः) प्रथमम् वर्णिता।
# The sequence was described by Piṅgala long before Fibonacci — it counts
# the ways of arranging short (लघु) and long (गुरु) syllables in a metre.

# १. आवर्तनेन / by recursion
कार्यम् मात्रामेरुः(स्थानम्) {
    यदि (स्थानम् < २) {
        प्रत्यागच्छ स्थानम्।
    }
    प्रत्यागच्छ मात्रामेरुः(स्थानम् - १) + मात्रामेरुः(स्थानम् - २)।
}

मुद्रय("आवर्तनेन / recursive:")।
मान पङ्क्तिः = []।
प्रत्येकम् (क अन्तः परास(०, १२)) {
    योजय(पङ्क्तिः, मात्रामेरुः(क))।
}
मुद्रय("  ", पङ्क्तिः)।

# २. पुनरावृत्त्या / by iteration — much faster
कार्यम् मेरुश्रेणी(संख्या_) {
    मान श्रेणी = [०, १]।
    यावत् (दीर्घता(श्रेणी) < संख्या_) {
        मान अ = श्रेणी[-१]।
        मान ब = श्रेणी[-२]।
        योजय(श्रेणी, अ + ब)।
    }
    प्रत्यागच्छ श्रेणी।
}

मुद्रय("पुनरावृत्त्या / iterative:")।
मुद्रय("  ", मेरुश्रेणी(१५))।

# ३. स्मृतिसहितम् / memoised with a कोश
मान स्मृतिः = {}।
कार्यम् द्रुतमेरुः(स्थानम्) {
    यदि (स्थानम् < २) {
        प्रत्यागच्छ स्थानम्।
    }
    यदि (अस्ति(स्मृतिः, स्थानम्)) {
        प्रत्यागच्छ स्मृतिः[स्थानम्]।
    }
    मान फलम् = द्रुतमेरुः(स्थानम् - १) + द्रुतमेरुः(स्थानम् - २)।
    स्मृतिः[स्थानम्] = फलम्।
    प्रत्यागच्छ फलम्।
}

मुद्रय("स्मृतिसहितम् / memoised:")।
मुद्रय("  ५० तमम् पदम् =", द्रुतमेरुः(५०))।
मुद्रय("  ९० तमम् पदम् =", देवनागरी(द्रुतमेरुः(९०)))।
