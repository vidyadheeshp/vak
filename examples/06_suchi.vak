# ०६ — सूची / Lists

मान ग्रहाः = ["बुधः", "शुक्रः", "पृथ्वी", "मङ्गलः", "गुरुः"]।

मुद्रय("सर्वे ग्रहाः:", ग्रहाः)।
मुद्रय("दीर्घता:", दीर्घता(ग्रहाः))।
मुद्रय("प्रथमः:", ग्रहाः[०], " तृतीयः:", ग्रहाः[२])।
मुद्रय("अन्तिमः:", ग्रहाः[-१])।              # ऋणसूचकः अन्ततः गणयति

# परिवर्तनम् / mutation
ग्रहाः[२] = "पृथिवी"।
योजय(ग्रहाः, "शनिः", "अरुणः")।
मुद्रय("योजनानन्तरम्:", ग्रहाः)।

मान अपनीतः = निष्कास(ग्रहाः)।             # अन्तिमम् अपनयति
मुद्रय("अपनीतः:", अपनीतः, " शिष्टाः:", दीर्घता(ग्रहाः))।

# भ्रमणम् / iteration
प्रत्येकम् (ग्रहः अन्तः ग्रहाः) {
    मुद्रय("  ॐ", ग्रहः)।
}

# अन्वेषणम् / search
यदि (अस्ति(ग्रहाः, "मङ्गलः")) {
    मुद्रय("मङ्गलः सूच्याम् अस्ति")।
}

# क्रमः, विपर्ययः, योगः / sort, reverse, sum
मान अङ्काः = [७, १, ९, ३, ५]।
मुद्रय("क्रमबद्धाः:", क्रम(अङ्काः))।
मुद्रय("विपरीतक्रमः:", क्रम(अङ्काः, सत्य))।
मुद्रय("विपर्ययः:", विपर्यय(अङ्काः))।
मुद्रय("योगः:", योग(अङ्काः), " न्यूनतमम्:", न्यूनतम(अङ्काः), " अधिकतमम्:", अधिकतम(अङ्काः))।

# छाननम् / filtering by hand
कार्यम् समाः(सूची_) {
    मान फलम् = []।
    प्रत्येकम् (क अन्तः सूची_) {
        यदि (क % २ == ०) {
            योजय(फलम्, क)।
        }
    }
    प्रत्यागच्छ फलम्।
}
मुद्रय("१ तः २० पर्यन्तम् समाः:", समाः(परास(१, २१)))।

# शब्दानाम् विभजनम् संयोजनम् च / split and join
मान वाक्यम् = "धर्मो रक्षति रक्षितः"।
मान पदानि = विभज(वाक्यम्, " ")।
मुद्रय("पदानि:", पदानि, " संख्या:", दीर्घता(पदानि))।
मुद्रय("पुनः संयोजितम्:", संयोज(विपर्यय(पदानि), " "))।
