# ०३ — यदि / अन्यथा — निर्णयाः / Decisions

मान अङ्कः = ७७।

यदि (अङ्कः >= ९०) {
    मुद्रय("उत्तमम्")।
} अन्यथा यदि (अङ्कः >= ७५) {
    मुद्रय("साधु")।
} अन्यथा यदि (अङ्कः >= ५०) {
    मुद्रय("सामान्यम्")।
} अन्यथा {
    मुद्रय("पुनः प्रयत्नः करणीयः")।
}

# समः वा विषमः / even or odd
कार्यम् समः_वा(मूल्यम्) {
    यदि (मूल्यम् % २ == ०) {
        प्रत्यागच्छ "समः"।
    }
    प्रत्यागच्छ "विषमः"।
}

प्रत्येकम् (क अन्तः परास(१, ६)) {
    मुद्रय(देवनागरी(क), "→", समः_वा(क))।
}

# सत्यता — किम् सत्यम् किम् असत्यम् / truthiness
# शून्य, असत्य, ०, "" तथा रिक्ताः संग्रहाः — असत्यवत्
यदि (० वा "" वा शून्य वा []) {
    मुद्रय("एतत् न दृश्यते")।
} अन्यथा {
    मुद्रय("०, \"\", शून्य, [] — सर्वाणि असत्यवत् भवन्ति")।
}

# घटितानि यदि / nested conditions
मान आयुः = १९।
मान अनुमतिः = आयुः >= १८ च आयुः < ६०।
यदि (अनुमतिः) {
    मुद्रय("अनुमतिः अस्ति")।
}
