# ०७ — कोशः / Dictionaries

मान छात्रः = {
    "नाम": "आर्यभटः",
    "नगरम्": "कुसुमपुरम्",
    "वर्षम्": ४७६,
    "विषयाः": ["गणितम्", "ज्योतिषम्"],
}।

# द्वौ मार्गौ — कुञ्जिकया अथवा बिन्दुना / two ways to read a key
मुद्रय("नाम:", छात्रः["नाम"])।
मुद्रय("नगरम्:", छात्रः.नगरम्)।
मुद्रय("विषयाः:", छात्रः.विषयाः)।

# नूतना कुञ्जिका / add a key
छात्रः["ग्रन्थः"] = "आर्यभटीयम्"।
छात्रः.वर्षम् = ४९९।

मुद्रय("सर्वाः कुञ्जिकाः:", कुञ्जिकाः(छात्रः))।
मुद्रय("सर्वाणि मूल्यानि:", मूल्यानि(छात्रः))।

# भ्रमणम् — प्रत्येकम् कुञ्जिकाम् गच्छति / iterating gives the keys
प्रत्येकम् (कुञ्जिका अन्तः छात्रः) {
    मुद्रय("  " + कुञ्जिका + " = " + शब्द(छात्रः[कुञ्जिका]))।
}

# अस्ति — कुञ्जिका विद्यते वा / does a key exist
यदि (अस्ति(छात्रः, "ग्रन्थः")) {
    मुद्रय("ग्रन्थः ज्ञातः:", छात्रः.ग्रन्थः)।
}
यदि (न अस्ति(छात्रः, "दूरभाषः")) {
    मुद्रय("दूरभाषः न विद्यते (स्वाभाविकम्, ४७६ तमे वर्षे!)")।
}

# कोशानाम् सूची / a list of dictionaries
मान गणकाः = [
    { "नाम": "आर्यभटः",   "वर्षम्": ४७६ },
    { "नाम": "ब्रह्मगुप्तः", "वर्षम्": ५९८ },
    { "नाम": "भास्करः",    "वर्षम्": १११४ },
]।

मुद्रय("")।
मुद्रय("प्राचीनाः गणकाः:")।
प्रत्येकम् (ग अन्तः गणकाः) {
    मुद्रय("  " + ग.नाम + " — " + देवनागरी(ग.वर्षम्) + " तमे वर्षे")।
}

# गणना / counting with a कोश
मान वाक्यम् = "क ख क ग क ख"।
मान गणना = {}।
प्रत्येकम् (अक्षरम् अन्तः विभज(वाक्यम्, " ")) {
    यदि (अस्ति(गणना, अक्षरम्)) {
        गणना[अक्षरम्] = गणना[अक्षरम्] + १।
    } अन्यथा {
        गणना[अक्षरम्] = १।
    }
}
मुद्रय("गणना:", गणना)।
