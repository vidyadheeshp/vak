# विकल्पः — एकः बहुभ्यः पक्षेभ्यः।
# vikalpaḥ — a choice among alternatives.
#
# 'विकल्पः' इति पाणिनेः शब्दः: सूत्रे यत् ऐच्छिकम् रूपम्, सः विकल्पः।
# 'पक्षे' इति सप्तमी — 'अस्मिन् पक्षे', यथा 'दोषे' इति 'दोषस्य सति'।
#
# पक्षाः परस्परम् न प्रविशन्ति — यः मिलति सः एव चलति, अतः विरमणम् न आवश्यकम्।
# There is no fall-through: choosing one alternative is the whole of it.

कार्यम् वासरनाम(कर्म पूर्णाङ्कः वारः) : शब्दः {
    विकल्पः (वारः) {
        पक्षे १: प्रत्यागच्छ "सोमवासरः"।
        पक्षे २: प्रत्यागच्छ "मङ्गलवासरः"।
        पक्षे ३: प्रत्यागच्छ "बुधवासरः"।
        पक्षे ४: प्रत्यागच्छ "गुरुवासरः"।
        पक्षे ५: प्रत्यागच्छ "शुक्रवासरः"।
        पक्षे ६, ७: प्रत्यागच्छ "सप्ताहान्तः"।
        अन्यथा: प्रत्यागच्छ "अज्ञातः वासरः"।
    }
}

मुद्रय "॥ सप्ताहस्य वासराः ॥"।
प्रत्येकम् (वारः अन्तः परास(१, ९)) {
    मुद्रय " ", देवनागरी(वारः), "—", वासरनाम(वारः)।
}

# एकः पक्षः बहूनि मूल्यानि धारयितुम् अर्हति
कार्यम् स्वरः_वा(कर्म शब्दः अक्षरम्) : सत्यता {
    विकल्पः (अक्षरम्) {
        पक्षे "अ", "आ", "इ", "ई", "उ", "ऊ", "ए", "ओ": प्रत्यागच्छ सत्य।
        अन्यथा: प्रत्यागच्छ असत्य।
    }
}

मुद्रय ""।
मुद्रय "॥ स्वराः व्यञ्जनानि च ॥"।
सूची अक्षराणि_ = ["अ", "क", "इ", "म", "ओ", "त"]।
पूर्णाङ्कः स्वरगणना = ०।
प्रत्येकम् (अक्षरम् अन्तः अक्षराणि_) {
    यदि (स्वरः_वा(अक्षरम्)) { स्वरगणना += १। }
}
मुद्रय "  अक्षराणि :", संयोज(अक्षराणि_, " ")।
मुद्रय "  स्वराः   :", देवनागरी(स्वरगणना)।

# विकल्पः पाशस्य अन्तः — विरम अनुवर्त च पाशम् एव लक्ष्यीकुरुतः,
# यतः पक्षाः स्वयमेव समाप्यन्ते।
मुद्रय ""।
मुद्रय "॥ पाशे विकल्पः ॥"।
प्रत्येकम् (अङ्कः अन्तः परास(१, ११)) {
    विकल्पः (अङ्कः % ३) {
        पक्षे ०: मुद्रय "  ", देवनागरी(अङ्कः), "— त्रिभिः भाज्यः"।
        पक्षे १: अनुवर्त।
        अन्यथा: {
            यदि (अङ्कः > ८) { विरम। }
            मुद्रय "  ", देवनागरी(अङ्कः), "— शेषः द्वौ"।
        }
    }
}
