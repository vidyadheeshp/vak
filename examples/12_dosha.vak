# १२ — दोषनिग्रहः / Exception handling
#
#   प्रयत्नः { ... }        — यत् कर्तुम् इच्छामः     (try)
#   दोषे (द) { ... }        — यदि दोषः भवेत् तर्हि     (catch — locative case!)
#   अन्ततः { ... }          — सर्वथा अन्ते            (finally)
#   उत्सृज मूल्यम्।          — दोषम् उत्सृजति          (throw)
#
# दोषः कोशः भवति — तस्य कुञ्जिकाः: प्रकारः, सन्देशः, पङ्क्तिः।

# ------------------------------------------------- सामान्यः प्रयत्नः
प्रयत्नः {
    मान फलम् = १० / ०।
    मुद्रय "एतत् न दृश्यते", फलम्।
} दोषे (द) {
    मुद्रय "प्रकारः :", द.प्रकारः।
    मुद्रय "सन्देशः :", द.सन्देशः।
    मुद्रय "पङ्क्तिः:", द.पङ्क्तिः।
}

# ------------------------------------------------- अन्ततः सर्वदा चलति
कार्यम् सञ्चिकाकार्यम्(सत्यता दोषः_भवेत्) {
    प्रयत्नः {
        मुद्रय "  सञ्चिका उद्घाटिता"।
        यदि (दोषः_भवेत्) {
            उत्सृज "पठने दोषः"।
        }
        मुद्रय "  पठनम् सम्पन्नम्"।
    } दोषे (द) {
        मुद्रय "  दोषः गृहीतः:", द.सन्देशः।
    } अन्ततः {
        मुद्रय "  सञ्चिका पिहिता (अन्ततः)"।
    }
}
मुद्रय ""।
मुद्रय "निर्दोषः प्रवाहः:"।
सञ्चिकाकार्यम्(असत्य)।
मुद्रय "सदोषः प्रवाहः:"।
सञ्चिकाकार्यम्(सत्य)।

# ------------------------------------------------- स्वकीयाः दोषाः
# उत्सृज कोशम् — प्रकारः स्वयम् नाम्ना दीयते
कार्यम् वयःपरीक्षा(पूर्णाङ्कः वयः) {
    यदि (वयः < ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "वयः ऋणात्मकम् न भवेत्" }।
    }
    यदि (वयः > १५०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "वयः अतिमहत्" }।
    }
    प्रत्यागच्छ "वयः स्वीकृतम्: " + शब्द(वयः)।
}

मुद्रय ""।
प्रत्येकम् (व अन्तः [३०, -५, २००]) {
    प्रयत्नः {
        मुद्रय " ", वयःपरीक्षा(व)।
    } दोषे (द) {
        मुद्रय "  " + द.प्रकारः + ": " + द.सन्देशः।
    }
}

# ------------------------------------------------- दोषाणाम् प्रकाराः
# प्रत्येकः अन्तर्दोषः स्वकीयेन नाम्ना आगच्छति।
# नामदोषः तथा प्राचलदोषः अत्र न दर्श्येते — तौ अर्थविश्लेषकः चालनात् पूर्वमेव गृह्णाति
# (python -m vak --check).  अत्र ते एव दोषाः ये कार्यकाले एव ज्ञातुम् शक्यन्ते।
कार्यम् अनिश्चितम्(म) { प्रत्यागच्छ म। }   # 'किमपि' प्रत्यागच्छति — विश्लेषकः न जानाति
कार्यम् दोषप्रकारः(कर्म) {
    प्रयत्नः {
        कर्म()।
        प्रत्यागच्छ "दोषः नास्ति"।
    } दोषे (द) {
        प्रत्यागच्छ द.प्रकारः।
    }
}

मुद्रय ""।
मुद्रय "अन्तर्दोषाणाम् नामानि:"।
मुद्रय "  शून्येन भागः  →", दोषप्रकारः(कार्यम्() { प्रत्यागच्छ १ / ०। })।
मुद्रय "  सूचकः बहिः    →", दोषप्रकारः(कार्यम्() { मान स = [१]। प्रत्यागच्छ स[९]। })।
मुद्रय "  कुञ्जिका नास्ति →", दोषप्रकारः(कार्यम्() { मान क = {}। प्रत्यागच्छ क.अज्ञाता। })।
मुद्रय "  प्रकारदोषः     →", दोषप्रकारः(कार्यम्() { प्रत्यागच्छ अनिश्चितम्("अ") - १। })।
मुद्रय "  प्राचलदोषः     →", दोषप्रकारः(कार्यम्() {
    मान परोक्षम् = अनिश्चितम्(मूल)।     # कार्यम् चरे स्थापितम् — विश्लेषकः न पश्यति
    प्रत्यागच्छ परोक्षम्(१, २, ३)।
})।

# ------------------------------------------------- पुनःप्रयत्नः — आवृत्तिः सह
# आवृत्तिः (न्) — 'न्' वारम् आवर्तते
मान प्रयत्नसंख्या = ०।
मान सिद्धम् = असत्य।

मुद्रय ""।
आवृत्तिः (३) {
    यदि (सिद्धम्) { विरम। }
    प्रयत्नसंख्या = प्रयत्नसंख्या + १।
    प्रयत्नः {
        मुद्रय "  प्रयत्नः", देवनागरी(प्रयत्नसंख्या)।
        यदि (प्रयत्नसंख्या < ३) {
            उत्सृज "जालसम्पर्कः न लब्धः"।
        }
        मुद्रय "  सफलम्!"।
        सिद्धम् = सत्य।
    } दोषे (द) {
        मुद्रय "    विफलम्:", द.सन्देशः।
    }
}

# ------------------------------------------------- दोषः पुनः उत्सृज्यते
कार्यम् आन्तरम्() {
    उत्सृज { "प्रकारः": "आन्तरदोषः", "सन्देशः": "गभीरे दोषः" }।
}
कार्यम् मध्यमम्() {
    प्रयत्नः {
        आन्तरम्()।
    } दोषे (द) {
        मुद्रय "  मध्यमे ज्ञातः, पुनः उत्सृज्यते"।
        उत्सृज द।                      # तम् एव दोषम् पुनः उत्सृजति
    }
}

मुद्रय ""।
प्रयत्नः {
    मध्यमम्()।
} दोषे (द) {
    मुद्रय "  बाह्ये गृहीतः:", द.प्रकारः, "—", द.सन्देशः।
}

# दोष() इति अन्तर्निहितम् कार्यम् अपि तथैव दोषम् उत्सृजति
प्रयत्नः {
    दोष("हस्तेन उत्सृष्टः दोषः", "मम_दोषः")।
} दोषे (द) {
    मुद्रय "  दोष() →", द.प्रकारः, "—", द.सन्देशः।
}
