# १० — ग्रन्थालयः / A little library — everything working together
#
# कोशाः, सूचयः, कार्याणि, पाशाः, आवरणानि च — सर्वम् एकत्र।

# ---------------------------------------------------------------- दत्तांशः
मान ग्रन्थाः = [
    { "नाम": "अष्टाध्यायी",   "कर्ता": "पाणिनिः",   "शतकम्": -४, "पृष्ठानि": ६४० },
    { "नाम": "अर्थशास्त्रम्",  "कर्ता": "कौटिल्यः",  "शतकम्": -३, "पृष्ठानि": ८५० },
    { "नाम": "आर्यभटीयम्",   "कर्ता": "आर्यभटः",   "शतकम्":  ५, "पृष्ठानि": १०८ },
    { "नाम": "लीलावती",      "कर्ता": "भास्करः",   "शतकम्": १२, "पृष्ठानि": २७० },
    { "नाम": "मेघदूतम्",      "कर्ता": "कालिदासः",  "शतकम्":  ५, "पृष्ठानि":  १२० },
]।

# ------------------------------------------------------------- साधनकार्याणि
कार्यम् दर्शय(ग्रन्थः) {
    मान कालः = ग्रन्थः.शतकम्।
    मान युगम् = "ख्रीष्टाब्दे"।
    यदि (कालः < ०) {
        कालः = ० - कालः।
        युगम् = "ख्रीष्टपूर्वे"।
    }
    मुद्रय("  " + ग्रन्थः.नाम + " — " + ग्रन्थः.कर्ता
        + " (" + देवनागरी(कालः) + " शतके " + युगम् + ", "
        + देवनागरी(ग्रन्थः.पृष्ठानि) + " पृष्ठानि)")।
}

कार्यम् छानय(संग्रहः, परीक्षा) {
    मान फलम् = []।
    प्रत्येकम् (सदस्यः अन्तः संग्रहः) {
        यदि (परीक्षा(सदस्यः)) {
            योजय(फलम्, सदस्यः)।
        }
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् कुञ्जिकया_क्रमः(संग्रहः, कुञ्जिका) {
    मान प्रतिलिपिः = सूची(संग्रहः)।          # मूलसूची अक्षता तिष्ठति
    मान न् = दीर्घता(प्रतिलिपिः)।
    मान इ = ०।
    यावत् (इ < न्) {                         # बुद्बुदक्रमः / bubble sort
        मान ज = ०।
        यावत् (ज < न् - इ - १) {
            यदि (प्रतिलिपिः[ज][कुञ्जिका] > प्रतिलिपिः[ज + १][कुञ्जिका]) {
                मान अस्थायी = प्रतिलिपिः[ज]।
                प्रतिलिपिः[ज] = प्रतिलिपिः[ज + १]।
                प्रतिलिपिः[ज + १] = अस्थायी।
            }
            ज = ज + १।
        }
        इ = इ + १।
    }
    प्रत्यागच्छ प्रतिलिपिः।
}

# ------------------------------------------------------------------ प्रयोगः
मुद्रय("॥ ग्रन्थालयः ॥")।
मुद्रय("")।
मुद्रय("सर्वे ग्रन्थाः — कालक्रमेण:")।
प्रत्येकम् (ग अन्तः कुञ्जिकया_क्रमः(ग्रन्थाः, "शतकम्")) {
    दर्शय(ग)।
}

मुद्रय("")।
मुद्रय("बृहत्तमाः ग्रन्थाः (२०० तः अधिकपृष्ठाः):")।
प्रत्येकम् (ग अन्तः छानय(ग्रन्थाः, कार्यम्(ग) { प्रत्यागच्छ ग.पृष्ठानि > २००। })) {
    दर्शय(ग)।
}

# ------------------------------------------------------------------ गणनानि
मान पृष्ठसंख्याः = []।
प्रत्येकम् (ग अन्तः ग्रन्थाः) {
    योजय(पृष्ठसंख्याः, ग.पृष्ठानि)।
}

मुद्रय("")।
मुद्रय("ग्रन्थसंख्या      :", देवनागरी(दीर्घता(ग्रन्थाः)))।
मुद्रय("सर्वपृष्ठाणि     :", देवनागरी(योग(पृष्ठसंख्याः)))।
मुद्रय("माध्यम्          :", देवनागरी(पूर्ण(योग(पृष्ठसंख्याः) / दीर्घता(पृष्ठसंख्याः))))।
मुद्रय("लघुतमः          :", देवनागरी(न्यूनतम(पृष्ठसंख्याः)))।
मुद्रय("बृहत्तमः         :", देवनागरी(अधिकतम(पृष्ठसंख्याः)))।

# कर्तृभिः अनुक्रमणिका / an index by author
मान अनुक्रमणिका = {}।
प्रत्येकम् (ग अन्तः ग्रन्थाः) {
    यदि (न अस्ति(अनुक्रमणिका, ग.कर्ता)) {
        अनुक्रमणिका[ग.कर्ता] = []।
    }
    योजय(अनुक्रमणिका[ग.कर्ता], ग.नाम)।
}

मुद्रय("")।
मुद्रय("कर्तृ-अनुक्रमणिका:")।
प्रत्येकम् (कर्ता अन्तः क्रम(कुञ्जिकाः(अनुक्रमणिका))) {
    मुद्रय("  " + कर्ता + ": " + संयोज(अनुक्रमणिका[कर्ता], ", "))।
}
