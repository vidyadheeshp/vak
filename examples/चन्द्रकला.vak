# चन्द्रकला — a small local module, imported by 14_anaya.vak
# यत्किमपि अत्र घोषितम् तत् सर्वम् निर्यातम् भवति / everything declared here is exported.

ध्रुव शब्दः नाम = "चन्द्रकला"।

ध्रुव सूची तिथयः = [
    "प्रतिपदा", "द्वितीया", "तृतीया", "चतुर्थी", "पञ्चमी",
    "षष्ठी", "सप्तमी", "अष्टमी", "नवमी", "दशमी",
    "एकादशी", "द्वादशी", "त्रयोदशी", "चतुर्दशी", "पूर्णिमा",
]।

कार्यम् तिथिनाम(पूर्णाङ्कः दिनम्) : शब्दः {
    यदि (दिनम् < १ वा दिनम् > दीर्घता(तिथयः)) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "तिथिः १ तः १५ पर्यन्तम् एव" }।
    }
    प्रत्यागच्छ तिथयः[दिनम् - १]।
}

# मासस्य दिनात् पक्षम् तिथिम् च गणयति / from a day of the lunar month
कार्यम् पक्षः(पूर्णाङ्कः दिनम्) : शब्दः {
    यदि (दिनम् <= १५) {
        प्रत्यागच्छ "शुक्लपक्षः"।
    }
    प्रत्यागच्छ "कृष्णपक्षः"।
}

कार्यम् वर्णनम्(पूर्णाङ्कः दिनम्) : शब्दः {
    पूर्णाङ्कः तिथिः = दिनम्।
    यदि (दिनम् > १५) {
        तिथिः = दिनम् - १५।
    }
    प्रत्यागच्छ पक्षः(दिनम्) + " " + तिथिनाम(तिथिः)।
}
