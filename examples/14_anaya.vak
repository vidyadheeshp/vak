# १४ — आनय / Modules, and सञ्चिकाः / files
#
#   आनय "गणितम्"।                  — सम्पूर्णम् आनयति, नाम्ना एव उपयुज्यते
#   आनय "शब्दाः" इति श।            — अन्येन नाम्ना
#   आनय "गणितम्" तः पाई, वर्गः।     — केवलम् किमपि नामानि
#
# सञ्चिका एकवारम् एव चाल्यते; ततः स्मृतौ तिष्ठति (आयातस्मृतिः)।
# अन्वेषणक्रमः: (१) चालितायाः सञ्चिकायाः निर्देशिका, (२) वर्तमाना निर्देशिका,
#                (३) वाक्-पुस्तकालयः — vak/पुस्तकालयः/

आनय "गणितम्"।
आनय "शब्दाः" इति श।
आनय "चन्द्रकला" तः तिथिनाम, वर्णनम्।

# ------------------------------------------------------------- गणितम्
मुद्रय "॥ गणितम् ॥"।
मुद्रय "  पाई              =", गणितम्.पाई।
मुद्रय "  वर्गः(१२)        =", गणितम्.वर्गः(१२)।
मुद्रय "  क्रमगुणितम्(१०)   =", गणितम्.क्रमगुणितम्(१०)।
मुद्रय "  मसाभा(४८, १८)    =", गणितम्.मसाभा(४८, १८)।
मुद्रय "  लसागु(४, ६)      =", गणितम्.लसागु(४, ६)।
मुद्रय "  अभाज्याः ३० यावत् =", गणितम्.अभाज्याः_यावत्(३०)।
मुद्रय "  माध्यम्          =", गणितम्.माध्यम्([२, ४, ६, ८])।
मुद्रय "  मध्यमा           =", गणितम्.मध्यमा([७, १, ९, ३, ५])।

# कारकनामभिः अपि — पुस्तकालयस्य कार्याणि कारकयुक्तानि
मुद्रय "  माध्यम् (कारकेण) =", गणितम्.माध्यम्(अपादानम्: [१०, २०, ३०])।

# ------------------------------------------------------------- शब्दाः
मुद्रय ""।
मुद्रय "॥ शब्दाः ॥"।
मुद्रय "  आदौ_अस्ति        =", श.आदौ_अस्ति("संस्कृतम्", "सं")।
मुद्रय "  अन्ते_अस्ति       =", श.अन्ते_अस्ति("संस्कृतम्", "तम्")।
मुद्रय "  पुनरावृत्तिः      =", श.पुनरावृत्तिः("ॐ ", ३)।
मुद्रय "  पूरय             =", श.पूरय("७", ५, "०")।
मुद्रय "  अक्षरसूची        =", श.अक्षरसूची("संस्कृतम्")।
मुद्रय "  विलोमः_वा(कनक)  =", श.विलोमः_वा("कनक")।
मुद्रय "  विलोमः_वा(वाक्)  =", श.विलोमः_वा("वाक्")।
मुद्रय "  शब्दगणना         =", श.शब्दगणना("क ख क ग क")।

# ------------------------------------------------------------- स्थानिकः आयातः
मुद्रय ""।
मुद्रय "॥ चन्द्रकला ॥"।
प्रत्येकम् (दिनम् अन्तः [१, ५, १५, १६, ३०]) {
    मुद्रय "  " + देवनागरी(दिनम्) + " → " + वर्णनम्(दिनम्)।
}

# ------------------------------------------------------------- सञ्चिकाः
मुद्रय ""।
मुद्रय "॥ सञ्चिकाः ॥"।

ध्रुव शब्दः पथः = "अभिलेखः.txt"।

सञ्चिकालिख(पथः, "प्रथमा पङ्क्तिः\n")।
सञ्चिकायोजय(पथः, "द्वितीया पङ्क्तिः\n")।
सञ्चिकायोजय(पथः, "तृतीया पङ्क्तिः\n")।

मुद्रय "  विद्यते वा       :", सञ्चिकास्ति(पथः)।
मुद्रय "  पङ्क्तिसंख्या     :", दीर्घता(सञ्चिकापङ्क्तयः(पथः))।
प्रत्येकम् (पङ्क्तिः अन्तः सञ्चिकापङ्क्तयः(पथः)) {
    मुद्रय "    " + पङ्क्तिः।
}

# सञ्चिकाम् पठित्वा गणनाम् करोति — यत् स्वहोस्टिङ्गाय आवश्यकम्
शब्दः सामग्री = सञ्चिकापठ(पथः)।
मुद्रय "  अक्षरसंख्या      :", दीर्घता(सामग्री)।
मुद्रय "  'पङ्क्ति' गणना   :", श.गणय_अक्षरम्("प", सामग्री)।

# दोषनिग्रहः — अविद्यमाना सञ्चिका
प्रयत्नः {
    सञ्चिकापठ("अविद्यमाना.txt")।
} दोषे (द) {
    मुद्रय "  गृहीतः दोषः      :", द.प्रकारः।
}

सञ्चिकानाशय(पथः)।
मुद्रय "  नाशनानन्तरम्      :", सञ्चिकास्ति(पथः)।
