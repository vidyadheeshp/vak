# १३ — कारकाणि / Kāraka roles on parameters
#
# संस्कृते कारकम् इति क्रियायाम् नाम्नः भूमिका — कः करोति, किम् करोति,
# केन करोति, कस्मै ददाति, कुतः आदत्ते, कुत्र करोति इति।
# विभक्तिः तम् सम्बन्धम् सूचयति। वाक्-भाषायाम् प्राचलः तम् एव कारकम् वहति:
#
#   कर्ता        प्रथमा   — यः करोति           the agent
#   कर्म         द्वितीया  — यत् क्रियया इष्यते  the patient
#   करणम्       तृतीया   — येन क्रियते         the instrument
#   सम्प्रदानम्  चतुर्थी   — यस्मै दीयते         the recipient
#   अपादानम्    पञ्चमी   — यस्मात् आदीयते      the source
#   अधिकरणम्    सप्तमी   — यत्र क्रिया भवति     the locus
#
# अर्थविश्लेषकः एतान् नियमान् पालयति (python -m vaak --check):
#   १. एकम् एव कर्म, एकः एव कर्ता — पाणिनीयः नियमः
#   २. प्रत्येकम् कारकम् उचितम् प्रकारम् धारयेत्
#   ३. यत्र कर्म तत्र फलम् — सकर्मकम् कार्यम् किमपि प्रत्यागच्छति
#
# क्रमः तु न नियम्यते — विभक्तिः एव क्रमम् मोचयति। अतः आह्वानकाले अपि
# कारकनाम्ना प्राचलम् दातुम् शक्यते, येन क्रमः निरर्थकः भवति:
#     छानय(अपादानम्: अङ्काः, करणम्: परीक्षा)
#     छानय(करणम्: परीक्षा, अपादानम्: अङ्काः)     — समानम् एव

# ---------------------------------------------------------------- अपादानम् + करणम्
# संग्रहात् (अपादानम्) परीक्षया (करणम्) छानयति
कार्यम् छानय(अपादानम् सूची संग्रहः, करणम् कार्यम् परीक्षा) : सूची {
    सूची फलम् = []।
    प्रत्येकम् (सदस्यः अन्तः संग्रहः) {
        यदि (परीक्षा(सदस्यः)) {
            योजय(फलम्, सदस्यः)।
        }
    }
    प्रत्यागच्छ फलम्।
}

मान अङ्काः = परास(१, २१)।
मान समः_वा = कार्यम्(क) { प्रत्यागच्छ क % २ == ०। }।

# त्रयः समानाः आह्वानाः — स्थानेन, कारकनाम्ना, विपरीतक्रमेण च
मुद्रय "स्थानेन      :", छानय(अङ्काः, समः_वा)।
मुद्रय "कारकनाम्ना   :", छानय(अपादानम्: अङ्काः, करणम्: समः_वा)।
मुद्रय "विपरीतक्रमेण :", छानय(करणम्: समः_वा, अपादानम्: अङ्काः)।
मुद्रय "मिश्रम्      :", छानय(अङ्काः, करणम्: कार्यम्(क) { प्रत्यागच्छ क % ३ == ०। })।

# ---------------------------------------------------------------- कर्म + अधिकरणम्
# अक्षरम् (कर्म) वाक्ये (अधिकरणम्) कति वारम् — क्रिया वाक्ये भवति
कार्यम् गणय(कर्म शब्दः अक्षरम्, अधिकरणम् शब्दः वाक्यम्) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = ०।
    प्रत्येकम् (अ अन्तः वाक्यम्) {
        यदि (अ == अक्षरम्) {
            गणना = गणना + १।
        }
    }
    प्रत्यागच्छ गणना।
}

मान वाक्यम् = "सत्यमेव जयते नानृतम्"।
मुद्रय "'त' इत्यस्य गणना:", देवनागरी(गणय("त", वाक्यम्))।

# ---------------------------------------------------------------- कर्म + सम्प्रदानम्
# सन्देशम् (कर्म) पेटिकायै (सम्प्रदानम्) ददाति
कार्यम् प्रेषय(कर्म शब्दः सन्देशः, सम्प्रदानम् सूची पेटिका) : सूची {
    योजय(पेटिका, सन्देशः)।
    प्रत्यागच्छ पेटिका।
}

सूची पत्रपेटिका = []।
प्रेषय("प्रथमः सन्देशः", पत्रपेटिका)।
प्रेषय("द्वितीयः सन्देशः", पत्रपेटिका)।
मुद्रय "पेटिकायाम्:", पत्रपेटिका।

# ---------------------------------------------------------------- कर्ता + कर्म + करणम्
# लेखकः (कर्ता) ग्रन्थम् (कर्म) लेखन्या (करणम्) लिखति
कार्यम् लिखतु(कर्ता कोशः लेखकः, कर्म शब्दः ग्रन्थः, करणम् शब्दः साधनम्) : शब्दः {
    प्रत्यागच्छ लेखकः.नाम + " " + ग्रन्थम्_सह(ग्रन्थः) + " " + साधनम् + " लिखति"।
}

कार्यम् ग्रन्थम्_सह(शब्दः नाम) : शब्दः {
    प्रत्यागच्छ "'" + नाम + "'"।
}

कोशः कालिदासः = { "नाम": "कालिदासः", "युगम्": "गुप्तयुगम्" }।
मुद्रय लिखतु(कालिदासः, "मेघदूतम्", "लेखन्या")।

# ---------------------------------------------------------------- अपादानम् + सम्प्रदानम्
# एकस्मात् संग्रहात् आदाय अन्यस्मै ददाति — स्थानान्तरणम्
कार्यम् स्थानान्तरय(अपादानम् सूची कुतः, सम्प्रदानम् सूची कस्मै) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = ०।
    यावत् (दीर्घता(कुतः) > ०) {
        योजय(कस्मै, निष्कास(कुतः, ०))।
        गणना = गणना + १।
    }
    प्रत्यागच्छ गणना।
}

सूची स्रोतः = ["अ", "आ", "इ"]।
सूची लक्ष्यम् = []।
मुद्रय "स्थानान्तरितानि:", देवनागरी(स्थानान्तरय(स्रोतः, लक्ष्यम्))।
मुद्रय "स्रोतः:", स्रोतः, " लक्ष्यम्:", लक्ष्यम्।

# ---------------------------------------------------------------- नियमभङ्गाः
# एतानि उदाहरणानि टिप्पणीरूपेण एव — विश्लेषकः तानि निवारयेत्:
#
#   कार्यम् दुष्टम्(कर्म शब्दः अ, कर्म शब्दः ब) { }
#       → कारकदोषः: कर्म इति २ वारम् — एकम् एव भवितुम् अर्हति
#
#   छानय(कर्ता: अङ्काः, करणम्: प)
#       → कारकदोषः: छानय — कर्ता इति कारकम् नास्ति
#
#   कार्यम् असंगतम्(अपादानम् पूर्णाङ्कः क) { }
#       → कारकसूचना: अपादानम् — यतः आदीयते, संग्रहः अपेक्ष्यते
#
#   कार्यम् निष्फलम्(कर्म शब्दः स) : शून्यम् { }
#       → कारकसूचना: कर्म अस्ति किन्तु प्रतिफलम् शून्यम्
