# ०४ — यावत् — पुनरावृत्तिः / While loops

# गणनम् / countdown
मान गणकः = ५।
यावत् (गणकः > ०) {
    मुद्रय("गणना:", देवनागरी(गणकः))।
    गणकः = गणकः - १।
}
मुद्रय("प्रक्षेपः! / lift-off!")।

# योगः १ तः १० पर्यन्तम् / sum of 1..10
मान इ = १।
मान एकत्रम् = ०।
यावत् (इ <= १०) {
    एकत्रम् = एकत्रम् + इ।
    इ = इ + १।
}
मुद्रय("१ तः १० पर्यन्तम् योगः =", एकत्रम्)।

# विरम (break) तथा अनुवर्त (continue)
मान क = ०।
यावत् (सत्य) {
    क = क + १।
    यदि (क % २ == ०) {
        अनुवर्त।                 # समान् त्यजति / skip the even ones
    }
    यदि (क > ११) {
        विरम।                    # पाशम् त्यजति / leave the loop
    }
    मुद्रय("विषमः:", देवनागरी(क))।
}

# संख्यायाः अङ्कानाम् योगः / digit sum
कार्यम् अङ्कयोगः(संख्या_) {
    मान शेषः = संख्या_।
    मान फलम् = ०।
    यावत् (शेषः > ०) {
        फलम् = फलम् + शेषः % १०।
        शेषः = पूर्ण(शेषः / १०)।
    }
    प्रत्यागच्छ फलम्।
}
मुद्रय("अङ्कयोगः(९८७६) =", अङ्कयोगः(९८७६))।

# ------------------------------------------------------------------ कुरु
# कुरु — शरीरम् प्रथमम्, प्रश्नः पश्चात्।  अतः एकवारम् अवश्यम् चलति, यद्यपि
# शर्तः आदौ एव असत्यः।  यावत् एतत् कर्तुम् न शक्नोति।
#
# The body runs before anything is asked, so it runs at least once even when
# the condition was false from the start.
मान अवशिष्टम् = ०।
कुरु {
    अवशिष्टम् = अवशिष्टम् + १।
} यावत् (असत्य)।
मुद्रय("कुरु एकवारम् अपि असत्ये:", देवनागरी(अवशिष्टम्))।

# अङ्कगणना — कति अङ्काः।  अत्र भेदः स्पष्टः: शून्यस्य एकः अङ्कः अस्ति,
# किन्तु यावत् शर्तम् आदौ एव परीक्षते, अतः शून्यम् गणयति।  कुरु एकवारम्
# चलित्वा एव पृच्छति, अतः सम्यक् वदति।
#
# Counting digits, where the difference is visible: zero has one digit, but
# यावत् tests first and so reports none. कुरु runs once before it asks.
कार्यम् अङ्कगणना_यावता(संख्या_) {
    मान शेषः = संख्या_।
    मान गणना = ०।
    यावत् (शेषः > ०) {
        गणना = गणना + १।
        शेषः = पूर्ण(शेषः / १०)।
    }
    प्रत्यागच्छ गणना।
}

कार्यम् अङ्कगणना_कुरुणा(संख्या_) {
    मान शेषः = संख्या_।
    मान गणना = ०।
    कुरु {
        गणना = गणना + १।
        शेषः = पूर्ण(शेषः / १०)।
    } यावत् (शेषः > ०)।
    प्रत्यागच्छ गणना।
}

मुद्रय("९८७६ इत्यस्य अङ्काः — यावता:", देवनागरी(अङ्कगणना_यावता(९८७६)),
       " कुरुणा:", देवनागरी(अङ्कगणना_कुरुणा(९८७६)))।
मुद्रय("० इत्यस्य अङ्काः  — यावता:", देवनागरी(अङ्कगणना_यावता(०)),
       " कुरुणा:", देवनागरी(अङ्कगणना_कुरुणा(०)))।
