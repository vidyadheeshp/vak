# शब्दविभाजकः — वाक्-भाषायाः शब्दविभाजकः, वाक्-भाषायाम् एव लिखितः।
# The lexer of Vāk, written in Vāk.
#
# एषा स्वयंसिद्धेः प्रथमा सोपानम् — भाषा स्वस्य एव मूलपाठम् पठितुम् शक्नोति।
# This is the first step of the bootstrap: the language reading its own source.
# Its output is compared, token for token, against the Python lexer in the
# test suite (परीक्षा: test_vak.py :: TestBootstrap).
#
#     आनय "शब्दविभाजकः" तः विभज_मूलम्।
#     सूची चिह्नानि = विभज_मूलम्(सञ्चिकापठ("प्रोग्राम.vak"))।
#
# प्रत्येकम् चिह्नम् कोशः: { प्रकारः, पदम्, मूल्यम्, पङ्क्तिः }
#   प्रकारः ∈ { अङ्कः, शब्दः, नाम, कीलकम्, चिह्नम्, समाप्तिः }

# ------------------------------------------------------------------ कीलकानि
ध्रुव सूची कीलकानि = [
    "मान", "ध्रुव", "कार्यम्", "कार्य", "प्रत्यागच्छ", "प्रतिदा",
    "यदि", "अन्यथा", "यावत्", "यावत", "प्रत्येकम्", "अन्तः", "आवृत्तिः", "आवृत्ति",
    "विरम", "अनुवर्त", "मुद्रय", "आनय", "इति", "तः",
    "विकल्पः", "विकल्प", "पक्षे",
    "प्रयत्नः", "प्रयत्न", "दोषे", "गृहाण", "अन्ततः", "अन्ते", "उत्सृज", "क्षिप",
    "सत्य", "असत्य", "शून्य", "च", "वा", "न",
    "mana", "dhruva", "karyam", "karya", "pratyagaccha", "pratida",
    "yadi", "anyatha", "yavat", "pratyekam", "antah", "avrttih",
    "virama", "anuvarta", "mudraya", "anaya", "iti", "tah",
    "vikalpah", "pakshe",
    "prayatnah", "doshe", "grihana", "antatah", "utsrja", "kshipa",
    "satya", "asatya", "shunya", "ca", "va", "na",
]।

ध्रुव शब्दः अङ्काः_रोमन् = "0123456789"।
ध्रुव शब्दः अङ्काः_देव = "०१२३४५६७८९"।
ध्रुव शब्दः दण्डाः = "।॥"।
ध्रुव शब्दः एकाक्षरचिह्नानि = "(){}[],.:;+-*%^"।

# ------------------------------------------------------------ अक्षरपरीक्षाः
कार्यम् अङ्कः_वा(कर्म शब्दः अ) : सत्यता {
    प्रत्यागच्छ अस्ति(अङ्काः_रोमन्, अ) वा अस्ति(अङ्काः_देव, अ)।
}

कार्यम् देवनागरी_वा(कर्म शब्दः अ) : सत्यता {
    पूर्णाङ्कः स = संकेतः(अ)।
    यदि (अस्ति(दण्डाः, अ)) {
        प्रत्यागच्छ असत्य।
    }
    प्रत्यागच्छ स >= २३०४ च स <= २४३१।         # ०x०९०० — ०x०९७F
}

कार्यम् रोमन्_वर्णः_वा(कर्म शब्दः अ) : सत्यता {
    पूर्णाङ्कः स = संकेतः(अ)।
    यदि (स >= ६५ च स <= ९०) { प्रत्यागच्छ सत्य। }     # A—Z
    यदि (स >= ९७ च स <= १२२) { प्रत्यागच्छ सत्य। }    # a—z
    प्रत्यागच्छ अ == "_"।
}

कार्यम् नामादिः_वा(कर्म शब्दः अ) : सत्यता {
    यदि (अङ्कः_वा(अ)) { प्रत्यागच्छ असत्य। }
    प्रत्यागच्छ रोमन्_वर्णः_वा(अ) वा देवनागरी_वा(अ)।
}

कार्यम् नामाङ्गम्_वा(कर्म शब्दः अ) : सत्यता {
    यदि (नामादिः_वा(अ)) { प्रत्यागच्छ सत्य। }
    यदि (अङ्कः_वा(अ)) { प्रत्यागच्छ सत्य। }
    पूर्णाङ्कः स = संकेतः(अ)।
    प्रत्यागच्छ स == ८२०४ वा स == ८२०५।              # ZWNJ, ZWJ
}

कार्यम् रिक्तम्_वा(कर्म शब्दः अ) : सत्यता {
    प्रत्यागच्छ अ == " " वा अ == "\t" वा अ == "\r" वा अ == "\n"।
}

कार्यम् कीलकम्_वा(कर्म शब्दः पदम्) : सत्यता {
    प्रत्यागच्छ अस्ति(कीलकानि, पदम्)।
}

# ------------------------------------------------------------------- स्थितिः
# स्थितिः कोशः: { मूलम्, स्थानम्, पङ्क्तिः, दीर्घता }
कार्यम् स्थितिम्_रचय(कर्म शब्दः मूलम्) : कोशः {
    प्रत्यागच्छ { "मूलम्": मूलम्, "स्थानम्": ०, "पङ्क्तिः": १, "दीर्घता": दीर्घता(मूलम्) }।
}

कार्यम् समाप्तम्_वा(अधिकरणम् कोशः स) : सत्यता {
    प्रत्यागच्छ स.स्थानम् >= स.दीर्घता।
}

कार्यम् पश्य(कोशः स, पूर्णाङ्कः दूरम्) : शब्दः {
    पूर्णाङ्कः स्थानम् = स.स्थानम् + दूरम्।
    यदि (स्थानम् >= स.दीर्घता) {
        प्रत्यागच्छ ""।
    }
    प्रत्यागच्छ स.मूलम्[स्थानम्]।
}

कार्यम् अग्रे_गच्छ(अधिकरणम् कोशः स) : शब्दः {
    शब्दः अ = स.मूलम्[स.स्थानम्]।
    स.स्थानम् = स.स्थानम् + १।
    यदि (अ == "\n") {
        स.पङ्क्तिः = स.पङ्क्तिः + १।
    }
    प्रत्यागच्छ अ।
}

कार्यम् चिह्नम्_रचय(शब्दः प्रकारः, शब्दः पदम्, किमपि मूल्यम्, पूर्णाङ्कः पङ्क्तिः) : कोशः {
    प्रत्यागच्छ { "प्रकारः": प्रकारः, "पदम्": पदम्, "मूल्यम्": मूल्यम्, "पङ्क्तिः": पङ्क्तिः }।
}

# ------------------------------------------------------------------ ग्राहकाः
कार्यम् गृह्ण_शब्दम्(कोशः स, शब्दः उद्धरणम्) : कोशः {
    पूर्णाङ्कः आरम्भपङ्क्तिः = स.पङ्क्तिः।
    शब्दः फलम् = ""।
    यावत् (न समाप्तम्_वा(स) च पश्य(स, ०) != उद्धरणम्) {
        शब्दः अ = अग्रे_गच्छ(स)।
        यदि (अ == "\\") {
            यदि (समाप्तम्_वा(स)) { विरम। }
            शब्दः निर्गमः = अग्रे_गच्छ(स)।
            यदि (निर्गमः == "n") { फलम् = फलम् + "\n"। }
            अन्यथा यदि (निर्गमः == "t") { फलम् = फलम् + "\t"। }
            अन्यथा यदि (निर्गमः == "r") { फलम् = फलम् + "\r"। }
            अन्यथा यदि (निर्गमः == "\\") { फलम् = फलम् + "\\"। }
            अन्यथा यदि (निर्गमः == "\"") { फलम् = फलम् + "\""। }
            अन्यथा यदि (निर्गमः == "'") { फलम् = फलम् + "'"। }
            अन्यथा { फलम् = फलम् + "\\" + निर्गमः। }
        } अन्यथा {
            फलम् = फलम् + अ।
        }
    }
    यदि (समाप्तम्_वा(स)) {
        उत्सृज { "प्रकारः": "अक्षरदोषः", "सन्देशः": "अपूर्णः शब्दः / unterminated string",
                 "पङ्क्तिः": आरम्भपङ्क्तिः }।
    }
    अग्रे_गच्छ(स)।                                    # समापकम् उद्धरणम्
    प्रत्यागच्छ चिह्नम्_रचय("शब्दः", उद्धरणम् + फलम् + उद्धरणम्, फलम्, आरम्भपङ्क्तिः)।
}

कार्यम् गृह्ण_अङ्कम्(कोशः स, शब्दः प्रथमम्) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = स.पङ्क्तिः।
    शब्दः पदम् = प्रथमम्।
    यावत् (न समाप्तम्_वा(स) च अङ्कः_वा(पश्य(स, ०))) {
        पदम् = पदम् + अग्रे_गच्छ(स)।
    }
    यदि (पश्य(स, ०) == "." च अङ्कः_वा(पश्य(स, १))) {
        पदम् = पदम् + अग्रे_गच्छ(स)।
        यावत् (न समाप्तम्_वा(स) च अङ्कः_वा(पश्य(स, ०))) {
            पदम् = पदम् + अग्रे_गच्छ(स)।
        }
    }
    प्रत्यागच्छ चिह्नम्_रचय("अङ्कः", पदम्, संख्या(पदम्), पङ्क्तिः)।
}

कार्यम् गृह्ण_नाम(कोशः स, शब्दः प्रथमम्) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = स.पङ्क्तिः।
    शब्दः पदम् = प्रथमम्।
    यावत् (न समाप्तम्_वा(स) च नामाङ्गम्_वा(पश्य(स, ०))) {
        पदम् = पदम् + अग्रे_गच्छ(स)।
    }
    यदि (कीलकम्_वा(पदम्)) {
        प्रत्यागच्छ चिह्नम्_रचय("कीलकम्", पदम्, शून्य, पङ्क्तिः)।
    }
    प्रत्यागच्छ चिह्नम्_रचय("नाम", पदम्, शून्य, पङ्क्तिः)।
}

# --------------------------------------------------------------- मुख्यम् कार्यम्
कार्यम् विभज_मूलम्(कर्म शब्दः मूलम्) : सूची {
    # BOM-चिह्नम् त्यज्यते — Notepad तथा PowerShell तत् लिखतः।
    # A leading BOM is dropped, as the Python lexer does, so both agree.
    यदि (दीर्घता(मूलम्) > ० च मूलम्[०] == "﻿") {
        मूलम् = अंशः(मूलम्, १, दीर्घता(मूलम्))।
    }
    कोशः स = स्थितिम्_रचय(मूलम्)।
    सूची चिह्नानि = []।

    यावत् (न समाप्तम्_वा(स)) {
        पूर्णाङ्कः पङ्क्तिः = स.पङ्क्तिः।
        शब्दः अ = अग्रे_गच्छ(स)।

        यदि (रिक्तम्_वा(अ)) {
            अनुवर्त।
        }

        # टिप्पण्यः — # ... तथा // ... तथा /* ... */
        यदि (अ == "#") {
            यावत् (न समाप्तम्_वा(स) च पश्य(स, ०) != "\n") { अग्रे_गच्छ(स)। }
            अनुवर्त।
        }
        यदि (अ == "/" च पश्य(स, ०) == "/") {
            यावत् (न समाप्तम्_वा(स) च पश्य(स, ०) != "\n") { अग्रे_गच्छ(स)। }
            अनुवर्त।
        }
        यदि (अ == "/" च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "/=", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == "/" च पश्य(स, ०) == "*") {
            अग्रे_गच्छ(स)।
            यावत् (न समाप्तम्_वा(स)) {
                यदि (पश्य(स, ०) == "*" च पश्य(स, १) == "/") { विरम। }
                अग्रे_गच्छ(स)।
            }
            यदि (समाप्तम्_वा(स)) {
                उत्सृज { "प्रकारः": "अक्षरदोषः", "सन्देशः": "अपूर्णा टिप्पणी",
                         "पङ्क्तिः": पङ्क्तिः }।
            }
            अग्रे_गच्छ(स)।
            अग्रे_गच्छ(स)।
            अनुवर्त।
        }

        # शब्दाः
        यदि (अ == "\"" वा अ == "'") {
            योजय(चिह्नानि, गृह्ण_शब्दम्(स, अ))।
            अनुवर्त।
        }

        # अङ्काः
        यदि (अङ्कः_वा(अ)) {
            योजय(चिह्नानि, गृह्ण_अङ्कम्(स, अ))।
            अनुवर्त।
        }

        # नामानि कीलकानि च
        यदि (नामादिः_वा(अ)) {
            योजय(चिह्नानि, गृह्ण_नाम(स, अ))।
            अनुवर्त।
        }

        # संयुक्तनियोजनम् — +=  -=  *=  %=  ^=   ( /= उपरि गृहीतम् )
        यदि (अस्ति("+-*%^", अ) च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", अ + "=", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }

        # द्व्यक्षरचिह्नानि
        यदि (अ == "=" च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "==", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == "!" च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "!=", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == "<" च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "<=", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == ">" च पश्य(स, ०) == "=") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", ">=", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == "&" च पश्य(स, ०) == "&") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "&&", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }
        यदि (अ == "|" च पश्य(स, ०) == "|") {
            अग्रे_गच्छ(स)।
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", "||", शून्य, पङ्क्तिः))।
            अनुवर्त।
        }

        # एकाक्षरचिह्नानि, दण्डाः, विभाजकः च
        यदि (अस्ति(एकाक्षरचिह्नानि, अ) वा अस्ति(दण्डाः, अ) वा अ == "/"
             वा अ == "=" वा अ == "<" वा अ == ">" वा अ == "!") {
            योजय(चिह्नानि, चिह्नम्_रचय("चिह्नम्", अ, शून्य, पङ्क्तिः))।
            अनुवर्त।
        }

        उत्सृज { "प्रकारः": "अक्षरदोषः", "सन्देशः": "अज्ञातम् अक्षरम् " + अ,
                 "पङ्क्तिः": पङ्क्तिः }।
    }

    योजय(चिह्नानि, चिह्नम्_रचय("समाप्तिः", "", शून्य, स.पङ्क्तिः))।
    प्रत्यागच्छ चिह्नानि।
}

# सञ्चिकातः साक्षात् / straight from a file
कार्यम् विभज_सञ्चिकाम्(अपादानम् शब्दः पथः) : सूची {
    प्रत्यागच्छ विभज_मूलम्(सञ्चिकापठ(पथः))।
}
