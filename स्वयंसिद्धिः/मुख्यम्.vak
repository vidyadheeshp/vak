# मुख्यम् — स्वयंसिद्धेः प्रदर्शनम् / the bootstrap demonstration.
#
#     python -m vaak स्वयंसिद्धिः/मुख्यम्.vak
#
# अत्र वाक्-भाषायाम् लिखिताः शब्दविभाजकः, व्याकरणम्, संकलकः च
# स्वस्य एव मूलपाठम् पठन्ति, विश्लेषयन्ति, संकलयन्ति च।
# Here the lexer, parser and compiler — all written in Vāk — read, parse and
# compile their own source.

आनय "शब्दविभाजकः" इति विभाजकः।
आनय "व्याकरणम्" इति व्याकरणम्।
आनय "संकलकः" इति संकलकः।
आनय "यन्त्रम्" इति यन्त्रम्।

ध्रुव सूची लक्ष्याणि = [
    "स्वयंसिद्धिः/शब्दविभाजकः.vak",
    "स्वयंसिद्धिः/व्याकरणम्.vak",
    "स्वयंसिद्धिः/संकलकः.vak",
]।

मुद्रय "॥ स्वयंसिद्धिः — वाक् वाचम् पठति, विश्लेषयति, संकलयति, चालयति च ॥"।

# ------------------------------------------------------- साधनकार्याणि
कार्यम् वाक्यानि_गणय(कर्म कोशः पर्वः) : पूर्णाङ्कः {
    यदि (प्रकार(पर्वः) != "कोशः") {
        प्रत्यागच्छ ०।
    }
    पूर्णाङ्कः गणना = १।
    प्रत्येकम् (कुञ्जिका अन्तः पर्वः) {
        किमपि मूल्यम् = पर्वः[कुञ्जिका]।
        यदि (प्रकार(मूल्यम्) == "कोशः") {
            गणना = गणना + वाक्यानि_गणय(मूल्यम्)।
        } अन्यथा यदि (प्रकार(मूल्यम्) == "सूची") {
            प्रत्येकम् (अङ्गम् अन्तः मूल्यम्) {
                यदि (प्रकार(अङ्गम्) == "कोशः") {
                    गणना = गणना + वाक्यानि_गणय(अङ्गम्)।
                }
            }
        }
    }
    प्रत्यागच्छ गणना।
}

कार्यम् आदेशान्_गणय(कर्म कोशः खण्डः) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = दीर्घता(खण्डः.सङ्केताः)।
    प्रत्येकम् (ध्रुवः अन्तः खण्डः.ध्रुवाः) {
        यदि (प्रकार(ध्रुवः) == "कोशः") {
            यदि (अस्ति(ध्रुवः, "खण्डः")) {
                गणना = गणना + आदेशान्_गणय(ध्रुवः.खण्डः)।
            }
        }
    }
    प्रत्यागच्छ गणना।
}

# ----------------------------------------------------------- प्रदर्शनम्
प्रत्येकम् (लक्ष्यम् अन्तः लक्ष्याणि) {
    मुद्रय ""।
    मुद्रय "॥ " + लक्ष्यम् + " ॥"।

    शब्दः मूलम् = सञ्चिकापठ(लक्ष्यम्)।
    सूची चिह्नानि = विभाजकः.विभज_मूलम्(मूलम्)।
    कोशः वृक्षः = व्याकरणम्.रचय_वाक्यरचनाम्(चिह्नानि)।
    कोशः खण्डः = संकलकः.संकलय(वृक्षः)।

    मुद्रय "  अक्षराणि    :", देवनागरी(दीर्घता(मूलम्))।
    मुद्रय "  पङ्क्तयः     :", देवनागरी(दीर्घता(सञ्चिकापङ्क्तयः(लक्ष्यम्)))।
    मुद्रय "  चिह्नानि    :", देवनागरी(दीर्घता(चिह्नानि))।
    मुद्रय "  पर्वाणि     :", देवनागरी(वाक्यानि_गणय(वृक्षः))।
    मुद्रय "  आदेशाः     :", देवनागरी(आदेशान्_गणय(खण्डः))।
    मुद्रय "  ध्रुवाः     :", देवनागरी(दीर्घता(खण्डः.ध्रुवाः))।
}

# ------------------------------------------------- प्रथमानि आदेशवाक्यानि
मुद्रय ""।
मुद्रय "॥ संकलितस्य आदेशाः — प्रथमानि पञ्चदश ॥"।
कोशः लघुखण्डः = संकलकः.संकलय(
    व्याकरणम्.रचय_वाक्यरचनाम्(
        विभाजकः.विभज_मूलम्('मान क = ५। यदि (क > ३) { मुद्रय "महत्"। }')))।

सूची सङ्केताः = लघुखण्डः.सङ्केताः।
पूर्णाङ्कः क = ०।
यावत् (क < दीर्घता(सङ्केताः) च क < १५) {
    मुद्रय "  " + देवनागरी(क) + " : " + देवनागरी(सङ्केताः[क])।
    क = क + १।
}

# ------------------------------------------------- वाक्-यन्त्रेण चालनम्
मुद्रय ""।
मुद्रय "॥ वाक्-यन्त्रेण चालितानि — सर्वम् वाक्-भाषया ॥"।

कार्यम् सर्वम्_चालय(कर्म शब्दः मूलम्) : किमपि {
    प्रत्यागच्छ यन्त्रम्.चालय(
        संकलकः.संकलय(व्याकरणम्.रचय_वाक्यरचनाम्(विभाजकः.विभज_मूलम्(मूलम्))))।
}

सर्वम्_चालय('मुद्रय "  नमस्ते जगत् — वाक्-यन्त्रात्"।')।
सर्वम्_चालय('कार्यम् क्र(न्) { यदि (न् <= १) { प्रत्यागच्छ १। } '
            + 'प्रत्यागच्छ न् * क्र(न् - १)। } मुद्रय "  क्रमगुणितम्(१०) =", क्र(१०)।')।
सर्वम्_चालय('आनय "गणितम्"। मुद्रय "  अभाज्याः २० यावत् =", '
            + 'गणितम्.अभाज्याः_यावत्(२०)।')।
सर्वम्_चालय('प्रयत्नः { उत्सृज { "प्रकारः": "मम्दोषः", "सन्देशः": "परीक्षा" }। } '
            + 'दोषे (द) { मुद्रय "  गृहीतः:", द.प्रकारः, "—", द.सन्देशः। }')।

मुद्रय ""।
मुद्रय "॥ इति स्वयंसिद्धिः सम्पन्ना — वाक् वाचम् संकलयति चालयति च ॥"।
