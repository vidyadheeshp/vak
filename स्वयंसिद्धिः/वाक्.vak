# वाक् — वाक्-भाषायाः चालकः, वाक्-भाषायाम् एव लिखितः।
# The Vāk driver, written in Vāk: it reads a .vak file, lexes it, parses it,
# compiles it, and hands the bytecode straight to the machine underneath.
#
# देशीयरूपेण संकलितः सन् एषः एव 'वाक्.exe' भवति, यत्र पैथन् नास्ति एव।
# Compiled natively this file *is* वाक्.exe: no Python anywhere in the loop.
#
#     python -m vaak --native स्वयंसिद्धिः/वाक्.vak
#     ./वाक्.exe प्रोग्राम.vak
#
# एकम् एव यन्त्रम् — पूर्वम् वाक्-लिखितम् यन्त्रम् आदेशान् व्याख्यातवत्, तत् अधुना
# न आवश्यकम्: 'खण्डम्_चालय' इत्यनेन संकलितम् खण्डम् साक्षात् आतिथेययन्त्रे चलति।
# One machine, not two. The Vāk-written VM used to interpret the bytecode this
# compiler produced; `खण्डम्_चालय` hands it to the host machine instead — the C
# VM when this is वाक्.exe, the Python VM when it runs under the interpreter.
#
# विकल्पाः / options:
#     वाक् <सञ्चिका.vak>            — चालय / run it
#     वाक् --चिह्नानि <सञ्चिका>      — चिह्नानि दर्शय / show the tokens
#     वाक् --आदेशाः <सञ्चिका>        — आदेशान् गणय / count the instructions
#     वाक् --परीक्षा <सञ्चिका>        — अर्थम् परीक्षय / analyse without running

आनय "शब्दविभाजकः" इति विभाजकः।
आनय "व्याकरणम्" इति व्याकरणम्।
आनय "अर्थविश्लेषकः" इति विश्लेषकः।
आनय "संकलकः" इति संकलकः।

ध्रुव शब्दः रूपम् = "वाक् ०.११.० — संस्कृतभाषायाः संगणकभाषा"।

# आयातस्य अन्वेषणपथाः; चालकः प्रोग्रामस्य स्वनिर्देशिकाम् अपि योजयति
ध्रुव सूची अन्वेषणनिर्देशिकाः = ["", "vaak/पुस्तकालयः/", "examples/", "स्वयंसिद्धिः/"]।

कार्यम् सहायता() {
    मुद्रय रूपम्।
    मुद्रय ""।
    मुद्रय "प्रयोगः / usage:"।
    मुद्रय "  वाक् <सञ्चिका.vak>          सञ्चिकाम् चालय / run a program"।
    मुद्रय "  वाक् --चिह्नानि <सञ्चिका>    चिह्नानि दर्शय / show the tokens"।
    मुद्रय "  वाक् --आदेशाः <सञ्चिका>      आदेशान् गणय / count the instructions"।
    मुद्रय "  वाक् --परीक्षा <सञ्चिका>      अर्थम् परीक्षय / analyse, do not run"।
}

# ------------------------------------------------------------------ पथाः
# "अ/ब/स.vak" → "अ/ब/"
कार्यम् निर्देशिका_अस्याः(कर्म शब्दः पथः) : शब्दः {
    पूर्णाङ्कः अन्तिमम् = ० - १।
    पूर्णाङ्कः क = ०।
    यावत् (क < दीर्घता(पथः)) {
        यदि (पथः[क] == "/" वा पथः[क] == "\\") { अन्तिमम् = क। }
        क += १।
    }
    यदि (अन्तिमम् < ०) { प्रत्यागच्छ ""। }
    प्रत्यागच्छ अंशः(पथः, ०, अन्तिमम् + १)।
}

कार्यम् निर्देशिकाम्_योजय(कर्म शब्दः निर्देशिका) {
    यदि (निर्देशिका != "" च न अस्ति(अन्वेषणनिर्देशिकाः, निर्देशिका)) {
        योजय(अन्वेषणनिर्देशिकाः, निर्देशिका)।
    }
}

कार्यम् पथम्_अन्विष्य(कर्म शब्दः पथः) : किमपि {
    शब्दः सह = पथः + ".vak"।
    प्रत्येकम् (निर्देशिका अन्तः अन्वेषणनिर्देशिकाः) {
        यदि (सञ्चिकास्ति(निर्देशिका + पथः)) { प्रत्यागच्छ निर्देशिका + पथः। }
        यदि (सञ्चिकास्ति(निर्देशिका + सह)) { प्रत्यागच्छ निर्देशिका + सह। }
    }
    उत्सृज { "प्रकारः": "आयातदोषः",
             "सन्देशः": "सञ्चिका न प्राप्ता '" + पथः + "'" }।
}

कार्यम् मूलम्_पठ(कर्म शब्दः पथः) : शब्दः {
    यदि (न सञ्चिकास्ति(पथः)) {
        उत्सृज { "प्रकारः": "सञ्चिकादोषः",
                 "सन्देशः": "सञ्चिका न प्राप्ता '" + पथः + "'" }।
    }
    प्रत्यागच्छ सञ्चिकापठ(पथः)।
}

कार्यम् संकलय_मूलम्(कर्म शब्दः मूलम्) : कोशः {
    प्रत्यागच्छ संकलकः.संकलय(
        व्याकरणम्.रचय_वाक्यरचनाम्(विभाजकः.विभज_मूलम्(मूलम्)))।
}

# ------------------------------------------------------------- आयाताः
# संकलितस्य खण्डस्य ध्रुवेषु आयातभाराः [पथः, उपनाम, नामानि] इति रूपेण सन्ति।
# The compiled chunk carries each आनय as a three-part constant; walk them — and
# every nested कार्यम् — so the modules can be compiled before the program runs.
कार्यम् आयातपथान्_सङ्ग्रह(कर्म कोशः खण्डः, सम्प्रदानम् सूची फलम्) {
    प्रत्येकम् (ध्रुवः अन्तः खण्डः.ध्रुवाः) {
        शब्दः प्र = प्रकार(ध्रुवः)।
        यदि (प्र == "सूची") {
            यदि (दीर्घता(ध्रुवः) == ३) {
                यदि (प्रकार(ध्रुवः[०]) == "शब्दः" च प्रकार(ध्रुवः[२]) == "सूची") {
                    यदि (न अस्ति(फलम्, ध्रुवः[०])) {
                        योजय(फलम्, ध्रुवः[०])।
                    }
                }
            }
        } अन्यथा यदि (प्र == "कोशः") {
            यदि (अस्ति(ध्रुवः, "खण्डः")) {
                आयातपथान्_सङ्ग्रह(ध्रुवः.खण्डः, फलम्)।
            }
        }
    }
}

कार्यम् विभागान्_संकलय(कर्म कोशः खण्डः) : सूची {
    सूची विभागाः = []।
    सूची ज्ञाताः = []।
    सूची कार्यसूची = []।
    आयातपथान्_सङ्ग्रह(खण्डः, कार्यसूची)।

    यावत् (दीर्घता(कार्यसूची) > ०) {
        शब्दः पथः = निष्कास(कार्यसूची, ०)।
        यदि (न अस्ति(ज्ञाताः, पथः)) {
            योजय(ज्ञाताः, पथः)।
            कोशः विभागखण्डः = संकलय_मूलम्(सञ्चिकापठ(पथम्_अन्विष्य(पथः)))।
            योजय(विभागाः, [पथः, विभागखण्डः])।
            आयातपथान्_सङ्ग्रह(विभागखण्डः, कार्यसूची)।
        }
    }
    प्रत्यागच्छ विभागाः।
}

# ----------------------------------------------------------------- आज्ञाः
कार्यम् चिह्नानि_दर्शय(कर्म शब्दः पथः) {
    सूची चिह्नानि = विभाजकः.विभज_मूलम्(मूलम्_पठ(पथः))।
    प्रत्येकम् (चि अन्तः चिह्नानि) {
        मुद्रय "  " + देवनागरी(चि.पङ्क्तिः) + " | " + चि.प्रकारः + " | " + चि.पदम्।
    }
    मुद्रय "चिह्नसंख्या:", देवनागरी(दीर्घता(चिह्नानि))।
}

कार्यम् आदेशान्_गणय(कर्म कोशः खण्डः) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = दीर्घता(खण्डः.सङ्केताः)।
    प्रत्येकम् (ध्रुवः अन्तः खण्डः.ध्रुवाः) {
        यदि (प्रकार(ध्रुवः) == "कोशः") {
            यदि (अस्ति(ध्रुवः, "खण्डः")) {
                गणना += आदेशान्_गणय(ध्रुवः.खण्डः)।
            }
        }
    }
    प्रत्यागच्छ गणना।
}

कार्यम् आदेशाः_दर्शय(कर्म शब्दः पथः) {
    कोशः खण्डः = संकलय_मूलम्(मूलम्_पठ(पथः))।
    मुद्रय "आदेशाः :", देवनागरी(आदेशान्_गणय(खण्डः))।
    मुद्रय "ध्रुवाः :", देवनागरी(दीर्घता(खण्डः.ध्रुवाः))।
}

# ------------------------------------------------------------ अर्थपरीक्षा
# सूचनाः पङ्क्त्यनुसारेण क्रमयति; समपङ्क्तौ दोषः सूचनायाः पूर्वम्।
कार्यम् सूचनाः_क्रमय(कर्म सूची सूचनाः) : सूची {
    सूची फलम् = []।
    प्रत्येकम् (सू अन्तः सूचनाः) {
        पूर्णाङ्कः स्थानम् = दीर्घता(फलम्)।
        पूर्णाङ्कः क = ०।
        यावत् (क < दीर्घता(फलम्)) {
            कोशः अन्यत् = फलम्[क]।
            सत्यता परतः = अन्यत्.पङ्क्तिः > सू.पङ्क्तिः।
            यदि (अन्यत्.पङ्क्तिः == सू.पङ्क्तिः च सू.घातकः च न अन्यत्.घातकः) {
                परतः = सत्य।
            }
            यदि (परतः च स्थानम् == दीर्घता(फलम्)) { स्थानम् = क। }
            क += १।
        }
        योजय(फलम्, सू)।
        क = दीर्घता(फलम्) - १।
        यावत् (क > स्थानम्) {
            किमपि धारकम् = फलम्[क]।
            फलम्[क] = फलम्[क - १]।
            फलम्[क - १] = धारकम्।
            क -= १।
        }
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् परीक्षय(कर्म शब्दः पथः) : पूर्णाङ्कः {
    निर्देशिकाम्_योजय(निर्देशिका_अस्याः(पथः))।
    शब्दः मूलम् = मूलम्_पठ(पथः)।
    सूची पङ्क्तयः = विभज(मूलम्, "\n")।
    सूची सूचनाः = विश्लेषकः.विश्लेषय(
        व्याकरणम्.रचय_वाक्यरचनाम्(विभाजकः.विभज_मूलम्(मूलम्)))।

    यदि (दीर्घता(सूचनाः) == ०) {
        मुद्रय "अर्थविश्लेषणम् निर्दोषम् / semantic analysis found nothing"।
        प्रत्यागच्छ ०।
    }

    पूर्णाङ्कः दोषगणना = ०।
    प्रत्येकम् (सू अन्तः सूचनाः) {
        यदि (सू.घातकः) { दोषगणना += १। }
    }
    मुद्रय "अर्थदोषः (Semantic Analysis) — " + शब्द(दोषगणना) + " दोषाः, "
          + शब्द(दीर्घता(सूचनाः) - दोषगणना) + " सूचनाः"।

    प्रत्येकम् (सू अन्तः सूचनाः_क्रमय(सूचनाः)) {
        शब्दः चिह्नम् = "सूचना"।
        यदि (सू.घातकः) { चिह्नम् = "दोषः"। }
        मुद्रय "  " + चिह्नम् + " [" + सू.सङ्केतः + "] " + पथः + ":"
              + शब्द(सू.पङ्क्तिः) + " — " + सू.सन्देशः।
        यदि (सू.पङ्क्तिः > ० च सू.पङ्क्तिः <= दीर्घता(पङ्क्तयः)) {
            मुद्रय "      " + अन्तरालः(४ - दीर्घता(शब्द(सू.पङ्क्तिः)))
                  + शब्द(सू.पङ्क्तिः) + " | " + परिष्कृतम्(पङ्क्तयः[सू.पङ्क्तिः - १])।
        }
    }
    यदि (दोषगणना > ०) { प्रत्यागच्छ ६५। }
    प्रत्यागच्छ ०।
}

कार्यम् अन्तरालः(कर्म पूर्णाङ्कः गणना) : शब्दः {
    शब्दः फलम् = ""।
    पूर्णाङ्कः क = ०।
    यावत् (क < गणना) { फलम् = फलम् + " "। क += १। }
    प्रत्यागच्छ फलम्।
}

कार्यम् परिष्कृतम्(कर्म शब्दः पङ्क्तिः) : शब्दः {
    पूर्णाङ्कः आदिः = ०।
    पूर्णाङ्कः अन्तम् = दीर्घता(पङ्क्तिः)।
    यावत् (आदिः < अन्तम् च (पङ्क्तिः[आदिः] == " " वा पङ्क्तिः[आदिः] == "\t")) {
        आदिः += १।
    }
    यावत् (अन्तम् > आदिः) {
        शब्दः अन्त्यः = पङ्क्तिः[अन्तम् - १]।
        यदि (अन्त्यः != " " च अन्त्यः != "\t" च अन्त्यः != "\r") { विरम। }
        अन्तम् -= १।
    }
    प्रत्यागच्छ अंशः(पङ्क्तिः, आदिः, अन्तम्)।
}

कार्यम् चालय_सञ्चिकाम्(कर्म शब्दः पथः) : किमपि {
    निर्देशिकाम्_योजय(निर्देशिका_अस्याः(पथः))।
    कोशः खण्डः = संकलय_मूलम्(मूलम्_पठ(पथः))।
    प्रत्यागच्छ खण्डम्_चालय(खण्डः, विभागान्_संकलय(खण्डः))।
}

# ------------------------------------------------------------------ मुख्यम्
सूची प्रा = प्राचलाः()।

प्रयत्नः {
    यदि (दीर्घता(प्रा) == ०) {
        सहायता()।
    } अन्यथा यदि (प्रा[०] == "--चिह्नानि" वा प्रा[०] == "--tokens") {
        यदि (दीर्घता(प्रा) < २) { सहायता()। } अन्यथा { चिह्नानि_दर्शय(प्रा[१])। }
    } अन्यथा यदि (प्रा[०] == "--आदेशाः" वा प्रा[०] == "--bytecode") {
        यदि (दीर्घता(प्रा) < २) { सहायता()। } अन्यथा { आदेशाः_दर्शय(प्रा[१])। }
    } अन्यथा यदि (प्रा[०] == "--परीक्षा" वा प्रा[०] == "--check") {
        यदि (दीर्घता(प्रा) < २) { सहायता()। } अन्यथा { परीक्षय(प्रा[१])। }
    } अन्यथा यदि (प्रा[०] == "--रूपम्" वा प्रा[०] == "--version") {
        मुद्रय रूपम्।
    } अन्यथा {
        चालय_सञ्चिकाम्(प्रा[०])।
    }
} दोषे (द) {
    मुद्रय द.प्रकारः + ": " + द.सन्देशः।
}
