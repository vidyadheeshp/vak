# अर्थविश्लेषकः — वाक्-भाषायाः अर्थविश्लेषकः, वाक्-भाषायाम् एव लिखितः।
# The semantic analyser of Vāk, written in Vāk.
#
# स्वयंसिद्धेः पञ्चमम् सोपानम् — अन्तिमः पैथन्-आश्रितः पादः अत्र समाप्यते।
# The fifth and last stage to be self-hosted: after this every part of the
# front end exists in Vāk.
#
#     आनय "अर्थविश्लेषकः" तः विश्लेषय।
#     सूची सूचनाः = विश्लेषय(व्याकरणम्.रचय_वाक्यरचनाम्(चिह्नानि))।
#
# प्रत्येका सूचना कोशः: { सङ्केतः, सन्देशः, पङ्क्तिः, घातकः }
# सङ्केताः vak/analyzer.py इत्यत्र ये सन्ति ते एव — उभे तुलयितुम् शक्येते।

ध्रुव सूची अङ्कप्रकाराः = ["पूर्णाङ्कः", "दशांशः", "अङ्कः"]।
ध्रुव सूची संग्रहप्रकाराः = ["सूची", "कोशः", "शब्दः"]।
ध्रुव सूची पात्रप्रकाराः = ["सूची", "कोशः"]।
ध्रुव सूची कारकक्रमः = ["कर्ता", "कर्म", "करणम्", "सम्प्रदानम्", "अपादानम्", "अधिकरणम्"]।

ध्रुव कोशः कारकविभक्तयः = {
    "कर्ता": "प्रथमा (nominative) — the agent, who acts",
    "कर्म": "द्वितीया (accusative) — the patient, what the action most wants",
    "करणम्": "तृतीया (instrumental) — the means by which it is done",
    "सम्प्रदानम्": "चतुर्थी (dative) — the recipient it is given to",
    "अपादानम्": "पञ्चमी (ablative) — the source it departs from",
    "अधिकरणम्": "सप्तमी (locative) — the locus it happens in",
}।

# अन्तर्निहितानाम् प्राचलसंख्या तथा प्रतिफलप्रकारः — vak/builtins.py इत्यनुसारम्
ध्रुव कोशः अन्तर्निहितलक्षणानि = {
    "लिख": [-१, "शून्यम्"], "पठ": [-१, "शब्दः"], "प्रकार": [१, "शब्दः"],
    "संख्या": [१, "अङ्कः"], "शब्द": [१, "शब्दः"], "देवनागरी": [१, "शब्दः"],
    "दीर्घता": [१, "पूर्णाङ्कः"], "सूची": [-१, "सूची"], "परास": [-१, "सूची"],
    "योजय": [-१, "सूची"], "निष्कास": [-१, "किमपि"], "अस्ति": [२, "सत्यता"],
    "कुञ्जिकाः": [१, "सूची"], "मूल्यानि": [१, "सूची"], "क्रम": [-१, "सूची"],
    "विपर्यय": [१, "किमपि"], "विभज": [-१, "सूची"], "संयोज": [-१, "शब्दः"],
    "योग": [१, "अङ्कः"], "न्यूनतम": [१, "अङ्कः"], "अधिकतम": [१, "अङ्कः"],
    "मूल": [१, "दशांशः"], "पूर्ण": [१, "पूर्णाङ्कः"], "यादृच्छिक": [-१, "अङ्कः"],
    "काल": [०, "दशांशः"], "दोष": [-१, "शून्यम्"], "अक्षराणि": [१, "सूची"],
    "संकेतः": [१, "पूर्णाङ्कः"], "वर्णः": [१, "शब्दः"], "अंशः": [-१, "किमपि"],
    "सञ्चिकापठ": [१, "शब्दः"], "सञ्चिकापङ्क्तयः": [१, "सूची"],
    "सञ्चिकालिख": [-१, "पूर्णाङ्कः"], "सञ्चिकायोजय": [-१, "पूर्णाङ्कः"],
    "सञ्चिकास्ति": [१, "सत्यता"], "सञ्चिकानाशय": [१, "सत्यता"],
    "निर्देशिका": [-१, "सूची"], "प्राचलाः": [०, "सूची"],
    "खण्डम्_चालय": [-१, "किमपि"],
}।

# =========================================================== परिधिः, प्रतीकः
कार्यम् परिधिम्_रचय(किमपि जनकः) : कोशः {
    प्रत्यागच्छ { "प्रतीकाः": {}, "जनकः": जनकः }।
}

कार्यम् प्रतीकम्_रचय(शब्दः नाम, शब्दः प्रकारः, सत्यता ध्रुवः, पूर्णाङ्कः पङ्क्तिः) : कोशः {
    प्रत्यागच्छ { "नाम": नाम, "प्रकारः": प्रकारः, "ध्रुवः": ध्रुवः,
                  "पङ्क्तिः": पङ्क्तिः, "प्राचलाः": शून्य,
                  "प्रतिफलप्रकारः": "किमपि", "देशीयसंख्या": शून्य }।
}

कार्यम् परिधौ_घोषय(कोशः परिधिः, कोशः प्रतीकः) {
    परिधिः.प्रतीकाः[प्रतीकः.नाम] = प्रतीकः।
}

कार्यम् प्रतीकम्_अन्विष्य(कोशः परिधिः, शब्दः नाम) : किमपि {
    किमपि वर्तमानः = परिधिः।
    यावत् (वर्तमानः != शून्य) {
        यदि (अस्ति(वर्तमानः.प्रतीकाः, नाम)) {
            प्रत्यागच्छ वर्तमानः.प्रतीकाः[नाम]।
        }
        वर्तमानः = वर्तमानः.जनकः।
    }
    प्रत्यागच्छ शून्य।
}

कार्यम् अत्रैव_घोषितम्(कोशः परिधिः, शब्दः नाम) : सत्यता {
    प्रत्यागच्छ अस्ति(परिधिः.प्रतीकाः, नाम)।
}

# ================================================================ विश्लेषकः
कार्यम् विश्लेषकम्_रचय() : कोशः {
    कोशः अन्तर्निहितपरिधिः = परिधिम्_रचय(शून्य)।
    प्रत्येकम् (नाम अन्तः कुञ्जिकाः(अन्तर्निहितलक्षणानि)) {
        सूची लक्षणम् = अन्तर्निहितलक्षणानि[नाम]।
        कोशः प्रतीकः = प्रतीकम्_रचय(नाम, "कार्यम्", सत्य, ०)।
        प्रतीकः.देशीयसंख्या = लक्षणम्[०]।
        प्रतीकः.प्रतिफलप्रकारः = लक्षणम्[१]।
        परिधौ_घोषय(अन्तर्निहितपरिधिः, प्रतीकः)।
    }
    प्रत्यागच्छ { "सूचनाः": [], "परिधिः": परिधिम्_रचय(अन्तर्निहितपरिधिः),
                  "कार्यस्तूपः": [], "पाशगभीरता": ० }।
}

कार्यम् दोषम्(कोशः वि, शब्दः सङ्केतः, शब्दः सन्देशः, पूर्णाङ्कः पङ्क्तिः) {
    योजय(वि.सूचनाः, { "सङ्केतः": सङ्केतः, "सन्देशः": सन्देशः,
                       "पङ्क्तिः": पङ्क्तिः, "घातकः": सत्य })।
}

कार्यम् सूचनाम्(कोशः वि, शब्दः सङ्केतः, शब्दः सन्देशः, पूर्णाङ्कः पङ्क्तिः) {
    योजय(वि.सूचनाः, { "सङ्केतः": सङ्केतः, "सन्देशः": सन्देशः,
                       "पङ्क्तिः": पङ्क्तिः, "घातकः": असत्य })।
}

कार्यम् उद्धृतम्(कर्म शब्दः नाम) : शब्दः {
    प्रत्यागच्छ "'" + नाम + "'"।
}

# ------------------------------------------------------------- प्रकारजालम्
# क्रमशः: किमपि सर्वत्र योग्यम्; पूर्णाङ्कः दशांशत्वेन स्वीक्रियते, न विपरीतम्
कार्यम् योग्यम्_वा(शब्दः मूल्यप्रकारः, शब्दः घोषितः) : सत्यता {
    यदि (घोषितः == "किमपि" वा घोषितः == "") { प्रत्यागच्छ सत्य। }
    यदि (मूल्यप्रकारः == "किमपि" वा मूल्यप्रकारः == "") { प्रत्यागच्छ सत्य। }
    यदि (मूल्यप्रकारः == घोषितः) { प्रत्यागच्छ सत्य। }
    यदि (अस्ति(अङ्कप्रकाराः, मूल्यप्रकारः) च अस्ति(अङ्कप्रकाराः, घोषितः)) {
        प्रत्यागच्छ न (घोषितः == "पूर्णाङ्कः" च मूल्यप्रकारः == "दशांशः")।
    }
    प्रत्यागच्छ असत्य।
}

कार्यम् अङ्कफलम्(शब्दः वामम्, शब्दः दक्षिणम्) : शब्दः {
    यदि (वामम् == "पूर्णाङ्कः" च दक्षिणम् == "पूर्णाङ्कः") { प्रत्यागच्छ "पूर्णाङ्कः"। }
    यदि (वामम् == "दशांशः" वा दक्षिणम् == "दशांशः") { प्रत्यागच्छ "दशांशः"। }
    प्रत्यागच्छ "अङ्कः"।
}

# ============================================================== मुख्यम्
कार्यम् विश्लेषय(कर्म कोशः वृक्षः) : सूची {
    कोशः वि = विश्लेषकम्_रचय()।
    खण्डम्_विश्लेषय(वि, वृक्षः.वाक्यानि, वि.परिधिः)।
    प्रत्यागच्छ वि.सूचनाः।
}

कार्यम् घातकाः(कर्म सूची सूचनाः) : सूची {
    सूची फलम् = []।
    प्रत्येकम् (सू अन्तः सूचनाः) {
        यदि (सू.घातकः) { योजय(फलम्, सू)। }
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् खण्डम्_विश्लेषय(कोशः वि, सूची वाक्यानि, कोशः परिधिः) {
    कोशः पूर्वपरिधिः = वि.परिधिः।
    वि.परिधिः = परिधिः।

    प्रत्येकम् (वाक्य अन्तः वाक्यानि) {
        पूर्वम्_घोषय(वि, वाक्य)।
    }
    किमपि निर्गतम् = शून्य।
    प्रत्येकम् (वाक्य अन्तः वाक्यानि) {
        यदि (निर्गतम् != शून्य) {
            सूचनाम्(वि, "अगम्यदोषः",
                     "इदम् वाक्यम् कदापि न चलति / unreachable code after "
                     + रूपनाम(निर्गतम्.रूपम्) + " on line " + शब्द(निर्गतम्.पङ्क्तिः),
                     वाक्य.पङ्क्तिः)।
            निर्गतम् = शून्य।
        }
        वाक्यम्_विश्लेषय(वि, वाक्य)।
        यदि (सर्वथा_निर्गच्छति(वाक्य)) { निर्गतम् = वाक्य। }
    }
    वि.परिधिः = पूर्वपरिधिः।
}

# पैथन्-पक्षे रूपाणि वर्गनाम्ना दर्श्यन्ते; तानि एव नामानि अत्र
कार्यम् रूपनाम(कर्म शब्दः रूपम्) : शब्दः {
    यदि (रूपम् == "प्रत्यागमनम्") { प्रत्यागच्छ "Return"। }
    यदि (रूपम् == "उत्सर्गः") { प्रत्यागच्छ "Throw"। }
    यदि (रूपम् == "विरामः") { प्रत्यागच्छ "Break"। }
    यदि (रूपम् == "अनुवर्तनम्") { प्रत्यागच्छ "Continue"। }
    यदि (रूपम् == "खण्डः") { प्रत्यागच्छ "Block"। }
    यदि (रूपम् == "यदिवाक्यम्") { प्रत्यागच्छ "If"। }
    यदि (रूपम् == "प्रयत्नवाक्यम्") { प्रत्यागच्छ "Try"। }
    यदि (रूपम् == "विकल्पवाक्यम्") { प्रत्यागच्छ "Switch"। }
    प्रत्यागच्छ रूपम्।
}

कार्यम् पूर्वम्_घोषय(कोशः वि, कोशः वाक्य) {
    यदि (वाक्य.रूपम् == "कार्यघोषणा") {
        कोशः प्रतीकः = प्रतीकम्_रचय(वाक्य.नाम, "कार्यम्", असत्य, वाक्य.पङ्क्तिः)।
        प्रतीकः.प्राचलाः = वाक्य.प्राचलाः।
        प्रतीकः.प्रतिफलप्रकारः = वाक्य.प्रतिफलप्रकारः।
        परिधौ_घोषय(वि.परिधिः, प्रतीकः)।
    }
}

# ------------------------------------------------------ प्रवाहपरीक्षा
कार्यम् सर्वथा_निर्गच्छति(कर्म कोशः वाक्य) : सत्यता {
    शब्दः रूपम् = वाक्य.रूपम्।
    यदि (रूपम् == "प्रत्यागमनम्" वा रूपम् == "उत्सर्गः"
         वा रूपम् == "विरामः" वा रूपम् == "अनुवर्तनम्") {
        प्रत्यागच्छ सत्य।
    }
    यदि (रूपम् == "खण्डः") {
        प्रत्येकम् (अन्तर्वाक्यम् अन्तः वाक्य.वाक्यानि) {
            यदि (सर्वथा_निर्गच्छति(अन्तर्वाक्यम्)) { प्रत्यागच्छ सत्य। }
        }
        प्रत्यागच्छ असत्य।
    }
    यदि (रूपम् == "यदिवाक्यम्") {
        यदि (वाक्य.अन्यथापक्षः == शून्य) { प्रत्यागच्छ असत्य। }
        प्रत्यागच्छ सर्वथा_निर्गच्छति(वाक्य.तदा)
                    च सर्वथा_निर्गच्छति(वाक्य.अन्यथापक्षः)।
    }
    यदि (रूपम् == "विकल्पवाक्यम्") {
        प्रत्यागच्छ विकल्पः_सर्वथा(वाक्य, असत्य)।
    }
    यदि (रूपम् == "प्रयत्नवाक्यम्") {
        सत्यता शरीरम् = सर्वथा_निर्गच्छति(वाक्य.शरीरम्)।
        सत्यता दोषपक्षः = वाक्य.दोषशरीरम् != शून्य च सर्वथा_निर्गच्छति(वाक्य.दोषशरीरम्)।
        सत्यता अन्तपक्षः = वाक्य.अन्तशरीरम् != शून्य च सर्वथा_निर्गच्छति(वाक्य.अन्तशरीरम्)।
        प्रत्यागच्छ अन्तपक्षः वा (शरीरम् च दोषपक्षः)।
    }
    प्रत्यागच्छ असत्य।
}

# 'अन्यथा' विना विकल्पः सर्वान् विषयान् न गृह्णाति — अमिलितः तस्मात् निर्गच्छति एव।
# Only with an अन्यथा is every subject accounted for.
कार्यम् विकल्पः_सर्वथा(कोशः वाक्य, सत्यता प्रत्यागमनम्_एव) : सत्यता {
    सत्यता अन्यथास्ति = असत्य।
    प्रत्येकम् (पक्षः अन्तः वाक्य.पक्षाः) {
        यदि (दीर्घता(पक्षः.मूल्यानि) == ०) { अन्यथास्ति = सत्य। }
    }
    यदि (न अन्यथास्ति) { प्रत्यागच्छ असत्य। }

    प्रत्येकम् (पक्षः अन्तः वाक्य.पक्षाः) {
        सत्यता निर्गच्छति = असत्य।
        प्रत्येकम् (अन्तर्वाक्यम् अन्तः पक्षः.वाक्यानि) {
            यदि (प्रत्यागमनम्_एव) {
                यदि (सर्वमार्गे_प्रत्यागच्छति(अन्तर्वाक्यम्)) { निर्गच्छति = सत्य। }
            } अन्यथा {
                यदि (सर्वथा_निर्गच्छति(अन्तर्वाक्यम्)) { निर्गच्छति = सत्य। }
            }
        }
        यदि (न निर्गच्छति) { प्रत्यागच्छ असत्य। }
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् सर्वमार्गे_प्रत्यागच्छति(कर्म कोशः वाक्य) : सत्यता {
    शब्दः रूपम् = वाक्य.रूपम्।
    यदि (रूपम् == "प्रत्यागमनम्" वा रूपम् == "उत्सर्गः") { प्रत्यागच्छ सत्य। }
    यदि (रूपम् == "खण्डः") {
        प्रत्येकम् (अन्तर्वाक्यम् अन्तः वाक्य.वाक्यानि) {
            यदि (सर्वमार्गे_प्रत्यागच्छति(अन्तर्वाक्यम्)) { प्रत्यागच्छ सत्य। }
        }
        प्रत्यागच्छ असत्य।
    }
    यदि (रूपम् == "यदिवाक्यम्") {
        यदि (वाक्य.अन्यथापक्षः == शून्य) { प्रत्यागच्छ असत्य। }
        प्रत्यागच्छ सर्वमार्गे_प्रत्यागच्छति(वाक्य.तदा)
                    च सर्वमार्गे_प्रत्यागच्छति(वाक्य.अन्यथापक्षः)।
    }
    यदि (रूपम् == "विकल्पवाक्यम्") {
        प्रत्यागच्छ विकल्पः_सर्वथा(वाक्य, सत्य)।
    }
    यदि (रूपम् == "प्रयत्नवाक्यम्") {
        सत्यता शरीरम् = सर्वमार्गे_प्रत्यागच्छति(वाक्य.शरीरम्)।
        सत्यता दोषपक्षः = वाक्य.दोषशरीरम् != शून्य
                       च सर्वमार्गे_प्रत्यागच्छति(वाक्य.दोषशरीरम्)।
        सत्यता अन्तपक्षः = वाक्य.अन्तशरीरम् != शून्य
                         च सर्वमार्गे_प्रत्यागच्छति(वाक्य.अन्तशरीरम्)।
        प्रत्यागच्छ अन्तपक्षः वा (शरीरम् च दोषपक्षः)।
    }
    प्रत्यागच्छ असत्य।
}

# ================================================================ वाक्यानि
कार्यम् वाक्यम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    शब्दः रूपम् = वाक्य.रूपम्।

    यदि (रूपम् == "पदवाक्यम्") { पदप्रकारः(वि, वाक्य.पदम्)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "मुद्रणम्") {
        प्रत्येकम् (प्रा अन्तः वाक्य.प्राचलाः) { पदप्रकारः(वि, प्रा)। }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "चरघोषणा") { चरघोषणाम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "खण्डः") {
        खण्डम्_विश्लेषय(वि, वाक्य.वाक्यानि, परिधिम्_रचय(वि.परिधिः))।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "यदिवाक्यम्") {
        पदप्रकारः(वि, वाक्य.परीक्षा)।
        वाक्यम्_विश्लेषय(वि, वाक्य.तदा)।
        यदि (वाक्य.अन्यथापक्षः != शून्य) { वाक्यम्_विश्लेषय(वि, वाक्य.अन्यथापक्षः)। }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "यावद्वाक्यम्") {
        पदप्रकारः(वि, वाक्य.परीक्षा)।
        वि.पाशगभीरता += १।
        वाक्यम्_विश्लेषय(वि, वाक्य.शरीरम्)।
        वि.पाशगभीरता -= १।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "आवृत्तिवाक्यम्") {
        शब्दः गणना = पदप्रकारः(वि, वाक्य.गणना)।
        यदि (न अस्ति(अङ्कप्रकाराः, गणना) च गणना != "किमपि") {
            दोषम्(वि, "प्रकारदोषः",
                   "आवृत्तिः अङ्कम् इच्छति, " + गणना + " दत्तः / आवृत्तिः needs a number, got "
                   + गणना, वाक्य.पङ्क्तिः)।
        }
        वि.पाशगभीरता += १।
        वाक्यम्_विश्लेषय(वि, वाक्य.शरीरम्)।
        वि.पाशगभीरता -= १।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "प्रत्येकवाक्यम्") { प्रत्येकवाक्यम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "विरामः") {
        यदि (वि.पाशगभीरता == ०) {
            दोषम्(वि, "प्रवाहदोषः", "'विरम' पाशस्य बहिः / 'विरम' outside a loop",
                   वाक्य.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "अनुवर्तनम्") {
        यदि (वि.पाशगभीरता == ०) {
            दोषम्(वि, "प्रवाहदोषः", "'अनुवर्त' पाशस्य बहिः / 'अनुवर्त' outside a loop",
                   वाक्य.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "प्रत्यागमनम्") { प्रत्यागमनम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "उत्सर्गः") { पदप्रकारः(वि, वाक्य.मूल्यम्)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "विकल्पवाक्यम्") { विकल्पम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "प्रयत्नवाक्यम्") { प्रयत्नम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "आयातः") { आयातम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
    यदि (रूपम् == "कार्यघोषणा") { कार्यघोषणाम्_विश्लेषय(वि, वाक्य)। प्रत्यागच्छ शून्य। }
}

कार्यम् चरघोषणाम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    शब्दः मूल्यप्रकारः = "किमपि"।
    यदि (वाक्य.मूल्यम् != शून्य) {
        मूल्यप्रकारः = पदप्रकारः(वि, वाक्य.मूल्यम्)।
        यदि (न योग्यम्_वा(मूल्यप्रकारः, वाक्य.प्रकारः)) {
            दोषम्(वि, "प्रकारदोषः",
                   "चरः " + उद्धृतम्(वाक्य.नाम) + ": " + वाक्य.प्रकारः + " अपेक्षितः, "
                   + मूल्यप्रकारः + " दीयते / expected " + वाक्य.प्रकारः + ", got "
                   + मूल्यप्रकारः, वाक्य.पङ्क्तिः)।
        }
    }
    यदि (अत्रैव_घोषितम्(वि.परिधिः, वाक्य.नाम)) {
        सूचनाम्(वि, "पुनर्घोषणा",
                 उद्धृतम्(वाक्य.नाम) + " अस्मिन् एव परिवेशे पुनः घोष्यते / "
                 + उद्धृतम्(वाक्य.नाम) + " is redeclared in the same scope",
                 वाक्य.पङ्क्तिः)।
    }
    परिधौ_घोषय(वि.परिधिः,
                प्रतीकम्_रचय(वाक्य.नाम, वाक्य.प्रकारः, वाक्य.ध्रुवः, वाक्य.पङ्क्तिः))।
}

कार्यम् प्रत्येकवाक्यम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    शब्दः संग्रहः = पदप्रकारः(वि, वाक्य.संग्रहः)।
    यदि (संग्रहः != "किमपि") {
        यदि (न अस्ति(संग्रहप्रकाराः, संग्रहः) च न अस्ति(अङ्कप्रकाराः, संग्रहः)) {
            दोषम्(वि, "प्रकारदोषः",
                   संग्रहः + " इत्यस्य उपरि न भ्रमितुं शक्यते / cannot iterate over "
                   + संग्रहः, वाक्य.पङ्क्तिः)।
        }
    }
    शब्दः अङ्गप्रकारः = "किमपि"।
    यदि (संग्रहः == "शब्दः") { अङ्गप्रकारः = "शब्दः"। }
    यदि (अस्ति(अङ्कप्रकाराः, संग्रहः)) { अङ्गप्रकारः = "पूर्णाङ्कः"। }

    कोशः पाशपरिधिः = परिधिम्_रचय(वि.परिधिः)।
    परिधौ_घोषय(पाशपरिधिः,
                प्रतीकम्_रचय(वाक्य.चरः, अङ्गप्रकारः, असत्य, वाक्य.पङ्क्तिः))।
    वि.पाशगभीरता += १।
    यदि (वाक्य.शरीरम्.रूपम् == "खण्डः") {
        खण्डम्_विश्लेषय(वि, वाक्य.शरीरम्.वाक्यानि, पाशपरिधिः)।
    } अन्यथा {
        कोशः पूर्वः = वि.परिधिः।
        वि.परिधिः = पाशपरिधिः।
        वाक्यम्_विश्लेषय(वि, वाक्य.शरीरम्)।
        वि.परिधिः = पूर्वः।
    }
    वि.पाशगभीरता -= १।
}

कार्यम् प्रत्यागमनम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    यदि (दीर्घता(वि.कार्यस्तूपः) == ०) {
        दोषम्(वि, "प्रवाहदोषः",
               "'प्रत्यागच्छ' कार्यस्य बहिः / 'प्रत्यागच्छ' outside a कार्यम्",
               वाक्य.पङ्क्तिः)।
        यदि (वाक्य.मूल्यम् != शून्य) { पदप्रकारः(वि, वाक्य.मूल्यम्)। }
        प्रत्यागच्छ शून्य।
    }
    कोशः कार्यम्_ = वि.कार्यस्तूपः[-१]।
    शब्दः मूल्यप्रकारः = "शून्यम्"।
    यदि (वाक्य.मूल्यम् != शून्य) { मूल्यप्रकारः = पदप्रकारः(वि, वाक्य.मूल्यम्)। }
    यदि (न योग्यम्_वा(मूल्यप्रकारः, कार्यम्_.प्रतिफलप्रकारः)) {
        दोषम्(वि, "प्रकारदोषः",
               कार्यम्_.नाम + " इत्यस्य प्रतिफलम्: " + कार्यम्_.प्रतिफलप्रकारः
               + " अपेक्षितम्, " + मूल्यप्रकारः + " दीयते / expected "
               + कार्यम्_.प्रतिफलप्रकारः + ", got " + मूल्यप्रकारः, वाक्य.पङ्क्तिः)।
    }
}

# विकल्पः — यः पक्षः कदापि न मिलेत्, यः वा पूर्वम् एव दत्तः, सः वक्तव्यः:
# उभयोः अपि चलनम् असम्भवम्।
कार्यम् विकल्पम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    शब्दः विषयः = पदप्रकारः(वि, वाक्य.विषयः)।
    सूची दृष्टानि = []।
    सूची दृष्टपङ्क्तयः = []।
    पूर्णाङ्कः अन्यथागणना = ०।

    प्रत्येकम् (पक्षः अन्तः वाक्य.पक्षाः) {
        यदि (दीर्घता(पक्षः.मूल्यानि) == ०) {
            अन्यथागणना += १।
            यदि (अन्यथागणना > १) {
                दोषम्(वि, "प्रवाहदोषः",
                       "एकम् एव 'अन्यथा' विकल्पे / a विकल्पः may have only one अन्यथा",
                       पक्षः.पङ्क्तिः)।
            }
        }
        प्रत्येकम् (मूल्यम् अन्तः पक्षः.मूल्यानि) {
            शब्दः दत्तः = पदप्रकारः(वि, मूल्यम्)।
            यदि (न तुल्यौ_वा(विषयः, दत्तः)) {
                दोषम्(वि, "प्रकारदोषः",
                       "पक्षः " + दत्तः + ", विषयः तु " + विषयः
                       + " — कदापि न मिलतः / a " + दत्तः + " पक्षः can never match a "
                       + विषयः + " subject", पक्षः.पङ्क्तिः)।
            }
            यदि (मूल्यम्.रूपम् == "मूल्यम्") {
                शब्दः कुञ्जिका = प्रकार(मूल्यम्.मूल्यम्) + "|" + शब्द(मूल्यम्.मूल्यम्)।
                पूर्णाङ्कः पूर्वस्थानम् = स्थानम्_अन्विष्य(दृष्टानि, कुञ्जिका)।
                यदि (पूर्वस्थानम् >= ०) {
                    दोषम्(वि, "प्रवाहदोषः",
                           "पक्षः पुनरुक्तः — पङ्क्तौ " + शब्द(दृष्टपङ्क्तयः[पूर्वस्थानम्])
                           + " एव दत्तः / this पक्षः is already given on line "
                           + शब्द(दृष्टपङ्क्तयः[पूर्वस्थानम्])
                           + ", so this one can never run", पक्षः.पङ्क्तिः)।
                } अन्यथा {
                    योजय(दृष्टानि, कुञ्जिका)।
                    योजय(दृष्टपङ्क्तयः, पक्षः.पङ्क्तिः)।
                }
            }
        }
        खण्डम्_विश्लेषय(वि, पक्षः.वाक्यानि, परिधिम्_रचय(वि.परिधिः))।
    }
    यदि (अन्यथागणना == ०) {
        सूचनाम्(वि, "प्रवाहसूचना",
                 "विकल्पे 'अन्यथा' नास्ति — अमिलितः विषयः किमपि न करोति / "
                 + "no अन्यथा, so a subject that matches nothing does nothing",
                 वाक्य.पङ्क्तिः)।
    }
}

# एतौ कदाचित् समौ भवितुम् अर्हतः वा — केवलम् निश्चितम् 'कदापि न' वक्तव्यम्।
कार्यम् तुल्यौ_वा(शब्दः विषयः, शब्दः दत्तः) : सत्यता {
    यदि (विषयः == "किमपि" वा दत्तः == "किमपि") { प्रत्यागच्छ सत्य। }
    यदि (विषयः == दत्तः) { प्रत्यागच्छ सत्य। }
    प्रत्यागच्छ अस्ति(अङ्कप्रकाराः, विषयः) च अस्ति(अङ्कप्रकाराः, दत्तः)।
}

कार्यम् स्थानम्_अन्विष्य(अपादानम् सूची सूची_, कर्म शब्दः लक्ष्यम्) : पूर्णाङ्कः {
    पूर्णाङ्कः क = ०।
    यावत् (क < दीर्घता(सूची_)) {
        यदि (सूची_[क] == लक्ष्यम्) { प्रत्यागच्छ क। }
        क += १।
    }
    प्रत्यागच्छ ० - १।
}

कार्यम् प्रयत्नम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    वाक्यम्_विश्लेषय(वि, वाक्य.शरीरम्)।
    यदि (वाक्य.दोषशरीरम् != शून्य) {
        कोशः दोषपरिधिः = परिधिम्_रचय(वि.परिधिः)।
        यदि (वाक्य.दोषचरः != शून्य) {
            परिधौ_घोषय(दोषपरिधिः,
                        प्रतीकम्_रचय(वाक्य.दोषचरः, "कोशः", असत्य, वाक्य.पङ्क्तिः))।
        }
        खण्डम्_विश्लेषय(वि, वाक्य.दोषशरीरम्.वाक्यानि, दोषपरिधिः)।
    }
    यदि (वाक्य.अन्तशरीरम् != शून्य) { वाक्यम्_विश्लेषय(वि, वाक्य.अन्तशरीरम्)। }
}

कार्यम् आयातम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    यदि (दीर्घता(वाक्य.नामानि) > ०) {
        प्रत्येकम् (नाम अन्तः वाक्य.नामानि) {
            परिधौ_घोषय(वि.परिधिः, प्रतीकम्_रचय(नाम, "किमपि", असत्य, वाक्य.पङ्क्तिः))।
        }
        प्रत्यागच्छ शून्य।
    }
    शब्दः बन्धनम् = मूलनाम(वाक्य.पथः)।
    यदि (वाक्य.उपनाम != शून्य) { बन्धनम् = वाक्य.उपनाम। }
    परिधौ_घोषय(वि.परिधिः, प्रतीकम्_रचय(बन्धनम्, "कोशः", असत्य, वाक्य.पङ्क्तिः))।
}

कार्यम् मूलनाम(कर्म शब्दः पथः) : शब्दः {
    सूची खण्डाः = विभज(पथः, "/")।
    शब्दः अन्तिमम् = खण्डाः[-१]।
    यदि (दीर्घता(अन्तिमम्) > ४) {
        यदि (अंशः(अन्तिमम्, दीर्घता(अन्तिमम्) - ४) == ".vak") {
            प्रत्यागच्छ अंशः(अन्तिमम्, ०, दीर्घता(अन्तिमम्) - ४)।
        }
    }
    प्रत्यागच्छ अन्तिमम्।
}

कार्यम् कार्यघोषणाम्_विश्लेषय(कोशः वि, कोशः वाक्य) {
    किमपि प्रतीकः = प्रतीकम्_अन्विष्य(वि.परिधिः, वाक्य.नाम)।
    यदि (प्रतीकः == शून्य) {
        प्रतीकः = प्रतीकम्_रचय(वाक्य.नाम, "कार्यम्", असत्य, वाक्य.पङ्क्तिः)।
        प्रतीकः.प्राचलाः = वाक्य.प्राचलाः।
        प्रतीकः.प्रतिफलप्रकारः = वाक्य.प्रतिफलप्रकारः।
        परिधौ_घोषय(वि.परिधिः, प्रतीकः)।
    }
    कारकान्_परीक्षय(वि, वाक्य.नाम, वाक्य.प्राचलाः, वाक्य.प्रतिफलप्रकारः, वाक्य.पङ्क्तिः)।
    कार्यशरीरम्_विश्लेषय(वि, प्रतीकः, वाक्य.प्राचलाः, वाक्य.शरीरम्,
                          वाक्य.प्रतिफलप्रकारः, वाक्य.पङ्क्तिः)।
}

कार्यम् कार्यशरीरम्_विश्लेषय(कोशः वि, कोशः प्रतीकः, सूची प्राचलाः, कोशः शरीरम्,
                              शब्दः प्रतिफलप्रकारः, पूर्णाङ्कः पङ्क्तिः) {
    कोशः परिधिः = परिधिम्_रचय(वि.परिधिः)।
    प्रत्येकम् (प्रा अन्तः प्राचलाः) {
        परिधौ_घोषय(परिधिः, प्रतीकम्_रचय(प्रा.नाम, प्रा.प्रकारः, असत्य, पङ्क्तिः))।
    }
    योजय(वि.कार्यस्तूपः, प्रतीकः)।
    पूर्णाङ्कः बाह्यपाशाः = वि.पाशगभीरता।
    वि.पाशगभीरता = ०।
    खण्डम्_विश्लेषय(वि, शरीरम्.वाक्यानि, परिधिः)।
    वि.पाशगभीरता = बाह्यपाशाः।
    निष्कास(वि.कार्यस्तूपः)।

    यदि (प्रतिफलप्रकारः != "किमपि" च प्रतिफलप्रकारः != "शून्यम्") {
        यदि (न सर्वमार्गे_प्रत्यागच्छति(शरीरम्)) {
            सूचनाम्(वि, "प्रतिफलसूचना",
                     प्रतीकः.नाम + ": " + प्रतिफलप्रकारः
                     + " इति प्रतिज्ञातम्, किन्तु मार्गः अस्ति यत्र किमपि न प्रत्यागच्छति / "
                     + "declared " + प्रतिफलप्रकारः + " but some path returns nothing",
                     पङ्क्तिः)।
        }
    }
}

# ========================================================== कारकपरीक्षा
कार्यम् कारकान्_परीक्षय(कोशः वि, शब्दः नाम, सूची प्राचलाः,
                          शब्दः प्रतिफलप्रकारः, पूर्णाङ्कः पङ्क्तिः) {
    सूची अङ्किताः = []।
    प्रत्येकम् (प्रा अन्तः प्राचलाः) {
        यदि (प्रा.कारकम् != शून्य) { योजय(अङ्किताः, प्रा)। }
    }
    यदि (दीर्घता(अङ्किताः) == ०) { प्रत्यागच्छ शून्य। }

    यदि (दीर्घता(अङ्किताः) != दीर्घता(प्राचलाः)) {
        सूचनाम्(वि, "कारकसूचना",
                 नाम + ": केचन प्राचलाः कारकयुक्ताः, केचन न / only "
                 + शब्द(दीर्घता(अङ्किताः)) + " of " + शब्द(दीर्घता(प्राचलाः))
                 + " parameters carry a कारकम्", पङ्क्तिः)।
    }

    # १. एकम् एव कर्म, एकः एव कर्ता
    प्रत्येकम् (भूमिका अन्तः ["कर्ता", "कर्म"]) {
        पूर्णाङ्कः गणना = ०।
        प्रत्येकम् (प्रा अन्तः अङ्किताः) {
            यदि (प्रा.कारकम् == भूमिका) { गणना += १। }
        }
        यदि (गणना > १) {
            दोषम्(वि, "कारकदोषः",
                   नाम + ": " + भूमिका + " इति " + शब्द(गणना)
                   + " वारम् — एकम् एव भवितुम् अर्हति / a कार्यम् may declare only one "
                   + भूमिका, पङ्क्तिः)।
        }
    }

    # २. क्रमः न नियम्यते — विभक्तिः एव क्रमम् मोचयति

    # ३. प्रत्येकम् कारकम् यत् धारयितुम् अर्हति
    प्रत्येकम् (प्रा अन्तः अङ्किताः) {
        सूची योग्याः = []।
        शब्दः व्याख्या = ""।
        यदि (प्रा.कारकम् == "करणम्") {
            योग्याः = ["कार्यम्", "शब्दः"]।
            व्याख्या = "साधनम् — कार्यम् शब्दः वा"।
        } अन्यथा यदि (प्रा.कारकम् == "अपादानम्") {
            योग्याः = संग्रहप्रकाराः।
            व्याख्या = "यतः आदीयते — संग्रहः"।
        } अन्यथा यदि (प्रा.कारकम् == "सम्प्रदानम्") {
            योग्याः = पात्रप्रकाराः।
            व्याख्या = "यस्मै दीयते — पात्रम्"।
        } अन्यथा यदि (प्रा.कारकम् == "अधिकरणम्") {
            योग्याः = संग्रहप्रकाराः।
            व्याख्या = "यत्र क्रिया — आधारः"।
        }
        यदि (दीर्घता(योग्याः) > ० च प्रा.प्रकारः != "किमपि") {
            यदि (न अस्ति(योग्याः, प्रा.प्रकारः)) {
                सूचनाम्(वि, "कारकसूचना",
                         नाम + ": " + प्रा.कारकम् + " " + उद्धृतम्(प्रा.नाम)
                         + " इत्यस्य प्रकारः " + प्रा.प्रकारः + " — " + व्याख्या
                         + " अपेक्ष्यते (" + कारकविभक्तयः[प्रा.कारकम्] + ")", पङ्क्तिः)।
            }
        }
    }

    # ४. सकर्मकम् कार्यम् फलम् ददाति
    सत्यता कर्मास्ति = असत्य।
    प्रत्येकम् (प्रा अन्तः अङ्किताः) {
        यदि (प्रा.कारकम् == "कर्म") { कर्मास्ति = सत्य। }
    }
    यदि (कर्मास्ति च प्रतिफलप्रकारः == "शून्यम्") {
        सूचनाम्(वि, "कारकसूचना",
                 नाम + ": कर्म अस्ति किन्तु प्रतिफलम् शून्यम् — सकर्मकम् कार्यम् फलम् "
                 + "ददाति / a कार्यम् with a कर्म normally produces a result", पङ्क्तिः)।
    }
}

# ================================================================== पदानि
कार्यम् पदप्रकारः(कोशः वि, किमपि पदम्) : शब्दः {
    यदि (पदम् == शून्य) { प्रत्यागच्छ "शून्यम्"। }
    शब्दः रूपम् = पदम्.रूपम्।

    यदि (रूपम् == "मूल्यम्") { प्रत्यागच्छ मूल्यप्रकारः(पदम्.मूल्यम्)। }
    यदि (रूपम् == "सूचीरचना") {
        प्रत्येकम् (अङ्गम् अन्तः पदम्.अङ्गानि) { पदप्रकारः(वि, अङ्गम्)। }
        प्रत्यागच्छ "सूची"।
    }
    यदि (रूपम् == "कोशरचना") {
        प्रत्येकम् (युग्मम् अन्तः पदम्.युग्मानि) {
            पदप्रकारः(वि, युग्मम्[०])।
            पदप्रकारः(वि, युग्मम्[१])।
        }
        प्रत्यागच्छ "कोशः"।
    }
    यदि (रूपम् == "नाम") {
        किमपि प्रतीकः = प्रतीकम्_अन्विष्य(वि.परिधिः, पदम्.नाम)।
        यदि (प्रतीकः == शून्य) {
            दोषम्(वि, "नामदोषः",
                   "अपरिभाषितम् नाम " + उद्धृतम्(पदम्.नाम) + " / undefined name "
                   + उद्धृतम्(पदम्.नाम), पदम्.पङ्क्तिः)।
            प्रत्यागच्छ "किमपि"।
        }
        प्रत्यागच्छ प्रतीकः.प्रकारः।
    }
    यदि (रूपम् == "नियोजनम्") { प्रत्यागच्छ नियोजनप्रकारः(वि, पदम्)। }
    यदि (रूपम् == "सूचकग्रहणम्") {
        शब्दः लक्ष्यम् = पदप्रकारः(वि, पदम्.लक्ष्यम्)।
        पदप्रकारः(वि, पदम्.सूचकः)।
        यदि (लक्ष्यम् != "किमपि" च न अस्ति(संग्रहप्रकाराः, लक्ष्यम्)) {
            दोषम्(वि, "प्रकारदोषः",
                   लक्ष्यम् + " इत्यस्मिन् सूचकः न प्रयोज्यः / cannot index a " + लक्ष्यम्,
                   पदम्.पङ्क्तिः)।
        }
        यदि (लक्ष्यम् == "शब्दः") { प्रत्यागच्छ "शब्दः"। }
        प्रत्यागच्छ "किमपि"।
    }
    यदि (रूपम् == "सूचकन्यासः") {
        शब्दः लक्ष्यम् = पदप्रकारः(वि, पदम्.लक्ष्यम्)।
        पदप्रकारः(वि, पदम्.सूचकः)।
        शब्दः मूल्यम् = पदप्रकारः(वि, पदम्.मूल्यम्)।
        यदि (लक्ष्यम् != "किमपि" च न अस्ति(पात्रप्रकाराः, लक्ष्यम्)) {
            दोषम्(वि, "प्रकारदोषः",
                   लक्ष्यम् + " इत्यस्मिन् न स्थापयितुम् शक्यते / cannot assign into a "
                   + लक्ष्यम्, पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ मूल्यम्।
    }
    यदि (रूपम् == "एकपदी") { प्रत्यागच्छ एकपदीप्रकारः(वि, पदम्)। }
    यदि (रूपम् == "द्विपदी") { प्रत्यागच्छ द्विपदीप्रकारः(वि, पदम्)। }
    यदि (रूपम् == "तार्किकम्") {
        पदप्रकारः(वि, पदम्.वामम्)।
        पदप्रकारः(वि, पदम्.दक्षिणम्)।
        प्रत्यागच्छ "किमपि"।
    }
    यदि (रूपम् == "आह्वानम्") { प्रत्यागच्छ आह्वानप्रकारः(वि, पदम्)। }
    यदि (रूपम् == "अनामकार्यम्") {
        कोशः प्रतीकः = प्रतीकम्_रचय(पदम्.नाम, "कार्यम्", असत्य, पदम्.पङ्क्तिः)।
        प्रतीकः.प्राचलाः = पदम्.प्राचलाः।
        प्रतीकः.प्रतिफलप्रकारः = पदम्.प्रतिफलप्रकारः।
        कारकान्_परीक्षय(वि, "अनाम कार्यम्", पदम्.प्राचलाः, पदम्.प्रतिफलप्रकारः,
                          पदम्.पङ्क्तिः)।
        कार्यशरीरम्_विश्लेषय(वि, प्रतीकः, पदम्.प्राचलाः, पदम्.शरीरम्,
                              पदम्.प्रतिफलप्रकारः, पदम्.पङ्क्तिः)।
        प्रत्यागच्छ "कार्यम्"।
    }
    प्रत्यागच्छ "किमपि"।
}

कार्यम् मूल्यप्रकारः(कर्म किमपि मूल्यम्) : शब्दः {
    यदि (मूल्यम् == शून्य) { प्रत्यागच्छ "शून्यम्"। }
    प्रत्यागच्छ प्रकार(मूल्यम्)।
}

कार्यम् नियोजनप्रकारः(कोशः वि, कोशः पदम्) : शब्दः {
    शब्दः मूल्यप्रकारः_ = पदप्रकारः(वि, पदम्.मूल्यम्)।
    किमपि प्रतीकः = प्रतीकम्_अन्विष्य(वि.परिधिः, पदम्.नाम)।
    यदि (प्रतीकः == शून्य) {
        दोषम्(वि, "नामदोषः",
               "अपरिभाषितम् नाम " + उद्धृतम्(पदम्.नाम)
               + " — प्रथमम् 'मान' इति उपयुज्यताम् / undefined name "
               + उद्धृतम्(पदम्.नाम), पदम्.पङ्क्तिः)।
        प्रत्यागच्छ मूल्यप्रकारः_।
    }
    यदि (प्रतीकः.ध्रुवः) {
        दोषम्(वि, "ध्रुवदोषः",
               "ध्रुवः " + उद्धृतम्(पदम्.नाम) + " न परिवर्तनीयः / "
               + "cannot reassign the constant " + उद्धृतम्(पदम्.नाम), पदम्.पङ्क्तिः)।
    } अन्यथा यदि (न योग्यम्_वा(मूल्यप्रकारः_, प्रतीकः.प्रकारः)) {
        दोषम्(वि, "प्रकारदोषः",
               "चरः " + उद्धृतम्(पदम्.नाम) + ": " + प्रतीकः.प्रकारः + " अपेक्षितः, "
               + मूल्यप्रकारः_ + " दीयते / expected " + प्रतीकः.प्रकारः + ", got "
               + मूल्यप्रकारः_, पदम्.पङ्क्तिः)।
    }
    यदि (प्रतीकः.प्रकारः != "किमपि") { प्रत्यागच्छ प्रतीकः.प्रकारः। }
    प्रत्यागच्छ मूल्यप्रकारः_।
}

कार्यम् एकपदीप्रकारः(कोशः वि, कोशः पदम्) : शब्दः {
    शब्दः दक्षिणम् = पदप्रकारः(वि, पदम्.दक्षिणम्)।
    यदि (पदम्.संकारकः == "-") {
        यदि (न अस्ति(अङ्कप्रकाराः, दक्षिणम्) च दक्षिणम् != "किमपि") {
            दोषम्(वि, "प्रकारदोषः",
                   "'-' अङ्कम् इच्छति, " + दक्षिणम् + " दत्तः / unary '-' needs a number, got "
                   + दक्षिणम्, पदम्.पङ्क्तिः)।
        }
        यदि (अस्ति(अङ्कप्रकाराः, दक्षिणम्)) { प्रत्यागच्छ दक्षिणम्। }
        प्रत्यागच्छ "अङ्कः"।
    }
    प्रत्यागच्छ "सत्यता"।
}

कार्यम् द्विपदीप्रकारः(कोशः वि, कोशः पदम्) : शब्दः {
    शब्दः वामम् = पदप्रकारः(वि, पदम्.वामम्)।
    शब्दः दक्षिणम् = पदप्रकारः(वि, पदम्.दक्षिणम्)।
    शब्दः संकारकः = पदम्.संकारकः।

    यदि (संकारकः == "==" वा संकारकः == "!=") { प्रत्यागच्छ "सत्यता"। }
    सत्यता अज्ञातम् = वामम् == "किमपि" वा दक्षिणम् == "किमपि"।

    यदि (संकारकः == "+") {
        यदि (अज्ञातम् वा वामम् == "शब्दः" वा दक्षिणम् == "शब्दः") {
            यदि (वामम् == "शब्दः" वा दक्षिणम् == "शब्दः") { प्रत्यागच्छ "शब्दः"। }
            प्रत्यागच्छ "किमपि"।
        }
        यदि (वामम् == "सूची" च दक्षिणम् == "सूची") { प्रत्यागच्छ "सूची"। }
        यदि (अस्ति(अङ्कप्रकाराः, वामम्) च अस्ति(अङ्कप्रकाराः, दक्षिणम्)) {
            प्रत्यागच्छ अङ्कफलम्(वामम्, दक्षिणम्)।
        }
        दोषम्(वि, "प्रकारदोषः",
               "'+' " + वामम् + " तथा " + दक्षिणम्
               + " इत्येतयोः कृते न प्रयोज्यम् / cannot apply '+' to " + वामम् + " and "
               + दक्षिणम्, पदम्.पङ्क्तिः)।
        प्रत्यागच्छ "किमपि"।
    }

    यदि (संकारकः == "<" वा संकारकः == "<=" वा संकारकः == ">" वा संकारकः == ">=") {
        यदि (न अज्ञातम्) {
            सत्यता अङ्कौ = अस्ति(अङ्कप्रकाराः, वामम्) च अस्ति(अङ्कप्रकाराः, दक्षिणम्)।
            सत्यता शब्दौ = वामम् == "शब्दः" च दक्षिणम् == "शब्दः"।
            यदि (न (अङ्कौ वा शब्दौ)) {
                दोषम्(वि, "प्रकारदोषः",
                       "'" + संकारकः + "' " + वामम् + " तथा " + दक्षिणम्
                       + " इत्येतयोः तुलनाम् न करोति / cannot compare " + वामम् + " with "
                       + दक्षिणम्, पदम्.पङ्क्तिः)।
            }
        }
        प्रत्यागच्छ "सत्यता"।
    }

    # - * / % ^
    यदि (न अस्ति(अङ्कप्रकाराः, वामम्) च वामम् != "किमपि") {
        दोषम्(वि, "प्रकारदोषः",
               "'" + संकारकः + "' अङ्कम् इच्छति, " + वामम् + " दत्तः / operator '"
               + संकारकः + "' needs a number, got " + वामम्, पदम्.पङ्क्तिः)।
    }
    यदि (न अस्ति(अङ्कप्रकाराः, दक्षिणम्) च दक्षिणम् != "किमपि") {
        दोषम्(वि, "प्रकारदोषः",
               "'" + संकारकः + "' अङ्कम् इच्छति, " + दक्षिणम् + " दत्तः / operator '"
               + संकारकः + "' needs a number, got " + दक्षिणम्, पदम्.पङ्क्तिः)।
    }
    यदि (अज्ञातम्) { प्रत्यागच्छ "किमपि"। }
    यदि (संकारकः == "/" वा संकारकः == "^") { प्रत्यागच्छ "अङ्कः"। }
    प्रत्यागच्छ अङ्कफलम्(वामम्, दक्षिणम्)।
}

कार्यम् आह्वानप्रकारः(कोशः वि, कोशः पदम्) : शब्दः {
    सूची प्राचलप्रकाराः = []।
    प्रत्येकम् (प्रा अन्तः पदम्.प्राचलाः) {
        योजय(प्राचलप्रकाराः, पदप्रकारः(वि, प्रा))।
    }
    यदि (पदम्.कार्यपदम्.रूपम् != "नाम") {
        पदप्रकारः(वि, पदम्.कार्यपदम्)।
        प्रत्यागच्छ "किमपि"।
    }

    शब्दः नाम = पदम्.कार्यपदम्.नाम।
    किमपि प्रतीकः = प्रतीकम्_अन्विष्य(वि.परिधिः, नाम)।
    यदि (प्रतीकः == शून्य) {
        दोषम्(वि, "नामदोषः",
               "अपरिभाषितम् कार्यम् " + उद्धृतम्(नाम) + " / undefined function "
               + उद्धृतम्(नाम), पदम्.पङ्क्तिः)।
        प्रत्यागच्छ "किमपि"।
    }
    यदि (प्रतीकः.प्रकारः != "कार्यम्" च प्रतीकः.प्रकारः != "किमपि") {
        दोषम्(वि, "प्रकारदोषः",
               प्रतीकः.प्रकारः + " आह्वातुम् न शक्यते / " + प्रतीकः.प्रकारः
               + " is not callable", पदम्.पङ्क्तिः)।
        प्रत्यागच्छ "किमपि"।
    }

    सूची कारकाः = []।
    प्रत्येकम् (का अन्तः पदम्.कारकाः) {
        यदि (का != शून्य) { योजय(कारकाः, का)। }
    }
    यदि (दीर्घता(कारकाः) > ०) {
        कारकाह्वानम्_परीक्षय(वि, प्रतीकः, पदम्, कारकाः)।
        प्रत्यागच्छ प्रतीकः.प्रतिफलप्रकारः।
    }

    यदि (प्रतीकः.प्राचलाः != शून्य) {
        यदि (दीर्घता(पदम्.प्राचलाः) != दीर्घता(प्रतीकः.प्राचलाः)) {
            दोषम्(वि, "प्राचलदोषः",
                   प्रतीकः.नाम + ": " + शब्द(दीर्घता(प्रतीकः.प्राचलाः))
                   + " प्राचलाः अपेक्षिताः, " + शब्द(दीर्घता(पदम्.प्राचलाः))
                   + " दत्ताः / expected " + शब्द(दीर्घता(प्रतीकः.प्राचलाः))
                   + " argument(s), got " + शब्द(दीर्घता(पदम्.प्राचलाः)), पदम्.पङ्क्तिः)।
        } अन्यथा {
            पूर्णाङ्कः क = ०।
            यावत् (क < दीर्घता(प्रतीकः.प्राचलाः)) {
                कोशः प्रा = प्रतीकः.प्राचलाः[क]।
                यदि (न योग्यम्_वा(प्राचलप्रकाराः[क], प्रा.प्रकारः)) {
                    दोषम्(वि, "प्रकारदोषः",
                           प्रतीकः.नाम + " इत्यस्य प्राचलः " + उद्धृतम्(प्रा.नाम) + ": "
                           + प्रा.प्रकारः + " अपेक्षितः, " + प्राचलप्रकाराः[क]
                           + " दीयते / expected " + प्रा.प्रकारः + ", got "
                           + प्राचलप्रकाराः[क], पदम्.पङ्क्तिः)।
                }
                क += १।
            }
        }
        प्रत्यागच्छ प्रतीकः.प्रतिफलप्रकारः।
    }

    यदि (प्रतीकः.देशीयसंख्या != शून्य) {
        यदि (प्रतीकः.देशीयसंख्या >= ०
             च दीर्घता(पदम्.प्राचलाः) != प्रतीकः.देशीयसंख्या) {
            दोषम्(वि, "प्राचलदोषः",
                   प्रतीकः.नाम + ": " + शब्द(प्रतीकः.देशीयसंख्या)
                   + " प्राचलाः अपेक्षिताः, " + शब्द(दीर्घता(पदम्.प्राचलाः))
                   + " दत्ताः / expected " + शब्द(प्रतीकः.देशीयसंख्या)
                   + " argument(s), got " + शब्द(दीर्घता(पदम्.प्राचलाः)), पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ प्रतीकः.प्रतिफलप्रकारः।
    }
    प्रत्यागच्छ "किमपि"।
}

कार्यम् कारकाह्वानम्_परीक्षय(कोशः वि, कोशः प्रतीकः, कोशः पदम्, सूची कारकाः) {
    यदि (प्रतीकः.प्राचलाः == शून्य) {
        दोषम्(वि, "कारकदोषः",
               प्रतीकः.नाम + ": कारकनामभिः आह्वानम् केवलम् कारकयुक्तस्य कार्यस्य कृते / "
               + "kāraka labels need a कार्यम् whose parameters declare roles",
               पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    सूची विद्यमानाः = []।
    प्रत्येकम् (प्रा अन्तः प्रतीकः.प्राचलाः) {
        यदि (प्रा.कारकम् != शून्य) { योजय(विद्यमानाः, प्रा.कारकम्)। }
    }
    प्रत्येकम् (का अन्तः कारकाः) {
        यदि (न अस्ति(विद्यमानाः, का)) {
            दोषम्(वि, "कारकदोषः",
                   प्रतीकः.नाम + ": " + का + " इति कारकम् नास्ति / declares no " + का
                   + " parameter", पदम्.पङ्क्तिः)।
        }
    }
    सूची दृष्टाः = []।
    प्रत्येकम् (का अन्तः कारकाः) {
        यदि (अस्ति(दृष्टाः, का)) { अनुवर्त। }
        योजय(दृष्टाः, का)।
        पूर्णाङ्कः गणना = ०।
        प्रत्येकम् (अन्यत् अन्तः कारकाः) {
            यदि (अन्यत् == का) { गणना += १। }
        }
        यदि (गणना > १) {
            दोषम्(वि, "कारकदोषः",
                   प्रतीकः.नाम + ": " + का + " द्विः दत्तम् / the " + का
                   + " argument is given twice", पदम्.पङ्क्तिः)।
        }
    }
    यदि (दीर्घता(पदम्.प्राचलाः) != दीर्घता(प्रतीकः.प्राचलाः)) {
        दोषम्(वि, "प्राचलदोषः",
               प्रतीकः.नाम + ": " + शब्द(दीर्घता(प्रतीकः.प्राचलाः))
               + " प्राचलाः अपेक्षिताः, " + शब्द(दीर्घता(पदम्.प्राचलाः))
               + " दत्ताः / expected " + शब्द(दीर्घता(प्रतीकः.प्राचलाः))
               + " argument(s), got " + शब्द(दीर्घता(पदम्.प्राचलाः)), पदम्.पङ्क्तिः)।
    }
}
