# व्याकरणम् — वाक्-भाषायाः व्याकरणम्, वाक्-भाषायाम् एव लिखितम्।
# The parser of Vāk, written in Vāk.
#
# स्वयंसिद्धेः द्वितीयम् सोपानम्: चिह्नेभ्यः वाक्यरचना।
# The second step of the bootstrap: tokens → syntax tree.
#
#     आनय "शब्दविभाजकः" तः विभज_मूलम्।
#     आनय "व्याकरणम्" तः रचय_वाक्यरचनाम्।
#     कोशः वृक्षः = रचय_वाक्यरचनाम्(विभज_मूलम्(मूलम्))।
#
# प्रत्येकः पर्वः कोशः, यस्मिन् "रूपम्" इति कुञ्जिका तस्य नाम वदति —
# मूल्यम्, नाम, द्विपदी, आह्वानम्, चरघोषणा, यदिवाक्यम् इत्यादि।
# एतत् एव रूपम् vaak/kosha.py इत्यत्र पैथन्-पक्षे अपि रच्यते, अतः उभे
# व्याकरणे तुलयितुम् शक्येते।

# ----------------------------------------------------------------- पर्यायाः
ध्रुव सूची क_मान = ["मान", "mana"]।
ध्रुव सूची क_ध्रुव = ["ध्रुव", "dhruva"]।
ध्रुव सूची क_कार्यम् = ["कार्यम्", "कार्य", "karyam", "karya"]।
ध्रुव सूची क_प्रत्यागच्छ = ["प्रत्यागच्छ", "प्रतिदा", "pratyagaccha", "pratida"]।
ध्रुव सूची क_यदि = ["यदि", "yadi"]।
ध्रुव सूची क_अन्यथा = ["अन्यथा", "anyatha"]।
ध्रुव सूची क_यावत् = ["यावत्", "यावत", "yavat"]।
ध्रुव सूची क_प्रत्येकम् = ["प्रत्येकम्", "pratyekam"]।
ध्रुव सूची क_अन्तः = ["अन्तः", "antah"]।
ध्रुव सूची क_आवृत्तिः = ["आवृत्तिः", "आवृत्ति", "avrttih"]।
ध्रुव सूची क_विरम = ["विरम", "virama"]।
ध्रुव सूची क_अनुवर्त = ["अनुवर्त", "anuvarta"]।
ध्रुव सूची क_मुद्रय = ["मुद्रय", "mudraya"]।
ध्रुव सूची क_आनय = ["आनय", "anaya"]।
ध्रुव सूची क_इति = ["इति", "iti"]।
ध्रुव सूची क_तः = ["तः", "tah"]।
ध्रुव सूची क_विकल्पः = ["विकल्पः", "विकल्प", "vikalpah"]।
ध्रुव सूची क_पक्षे = ["पक्षे", "pakshe"]।
ध्रुव सूची क_प्रयत्नः = ["प्रयत्नः", "प्रयत्न", "prayatnah"]।
ध्रुव सूची क_दोषे = ["दोषे", "गृहाण", "doshe", "grihana"]।
ध्रुव सूची क_अन्ततः = ["अन्ततः", "अन्ते", "antatah"]।
ध्रुव सूची क_उत्सृज = ["उत्सृज", "क्षिप", "utsrja", "kshipa"]।
ध्रुव सूची क_सत्य = ["सत्य", "satya"]।
ध्रुव सूची क_असत्य = ["असत्य", "asatya"]।
ध्रुव सूची क_शून्य = ["शून्य", "shunya"]।
ध्रुव सूची क_च = ["च", "ca"]।
ध्रुव सूची क_वा = ["वा", "va"]।
ध्रुव सूची क_न = ["न", "na"]।

ध्रुव कोशः प्रकारनामानि = {
    "पूर्णाङ्कः": "पूर्णाङ्कः", "पूर्णाङ्क": "पूर्णाङ्कः", "purnankah": "पूर्णाङ्कः",
    "दशांशः": "दशांशः", "दशांश": "दशांशः", "dashamshah": "दशांशः",
    "अङ्कः": "अङ्कः", "अङ्क": "अङ्कः", "ankah": "अङ्कः",
    "शब्दः": "शब्दः", "shabdah": "शब्दः",
    "सत्यता": "सत्यता", "satyata": "सत्यता",
    "सूची": "सूची", "suchi": "सूची",
    "कोशः": "कोशः", "कोश": "कोशः", "koshah": "कोशः",
    "शून्यम्": "शून्यम्", "shunyam": "शून्यम्",
    "किमपि": "किमपि", "kimapi": "किमपि",
}।

ध्रुव कोशः कारकनामानि = {
    "कर्ता": "कर्ता", "karta": "कर्ता",
    "कर्म": "कर्म", "कर्मन्": "कर्म", "karma": "कर्म",
    "करणम्": "करणम्", "करण": "करणम्", "karanam": "करणम्",
    "सम्प्रदानम्": "सम्प्रदानम्", "सम्प्रदान": "सम्प्रदानम्", "sampradanam": "सम्प्रदानम्",
    "अपादानम्": "अपादानम्", "अपादान": "अपादानम्", "apadanam": "अपादानम्",
    "अधिकरणम्": "अधिकरणम्", "अधिकरण": "अधिकरणम्", "adhikaranam": "अधिकरणम्",
}।

# यानि चिह्नानि पदम् अनुवर्तयितुम् शक्नुवन्ति — मुद्रयस्य कृते
ध्रुव सूची पदानुवर्तकाः = [
    "+", "-", "*", "/", "%", "^", "==", "!=", "<", "<=", ">", ">=",
    ".", "[", "(", "=", ",",
    "+=", "-=", "*=", "/=", "%=", "^=",
]।
ध्रुव सूची तार्किकचिह्नानि = ["&&", "||"]।

# संयुक्तनियोजनचिह्नानि — "क += १" इति "क = क + १" इत्यस्य संक्षेपः
ध्रुव सूची संयुक्तचिह्नानि = ["+=", "-=", "*=", "/=", "%=", "^="]।

# ------------------------------------------------------------------- स्थितिः
कार्यम् स्थितिम्_रचय(कर्म सूची चिह्नानि) : कोशः {
    प्रत्यागच्छ { "चिह्नानि": चिह्नानि, "स्थानम्": ०, "दीर्घता": दीर्घता(चिह्नानि) }।
}

कार्यम् वर्तमानम्(कोशः प) : कोशः {
    प्रत्यागच्छ प.चिह्नानि[प.स्थानम्]।
}

कार्यम् आगामि(कोशः प, पूर्णाङ्कः दूरम्) : कोशः {
    पूर्णाङ्कः स्थानम् = प.स्थानम् + दूरम्।
    यदि (स्थानम् >= प.दीर्घता) {
        स्थानम् = प.दीर्घता - १।
    }
    प्रत्यागच्छ प.चिह्नानि[स्थानम्]।
}

कार्यम् पूर्वम्(कोशः प) : कोशः {
    प्रत्यागच्छ प.चिह्नानि[प.स्थानम् - १]।
}

कार्यम् अग्रे(कोशः प) : कोशः {
    कोशः चि = प.चिह्नानि[प.स्थानम्]।
    यदि (चि.प्रकारः != "समाप्तिः") {
        प.स्थानम् = प.स्थानम् + १।
    }
    प्रत्यागच्छ चि।
}

कार्यम् दोषम्_उत्सृज(शब्दः सन्देशः, पूर्णाङ्कः पङ्क्तिः) {
    उत्सृज { "प्रकारः": "व्याकरणदोषः", "सन्देशः": सन्देशः, "पङ्क्तिः": पङ्क्तिः }।
}

# चिह्नपरीक्षाः — प्रकारेण अथवा पदेन
कार्यम् चिह्नम्_अस्ति(कोशः प, शब्दः पदम्) : सत्यता {
    कोशः चि = वर्तमानम्(प)।
    प्रत्यागच्छ चि.प्रकारः == "चिह्नम्" च चि.पदम् == पदम्।
}

कार्यम् कीलकम्_अस्ति(कोशः प, सूची पर्यायाः) : सत्यता {
    कोशः चि = वर्तमानम्(प)।
    प्रत्यागच्छ चि.प्रकारः == "कीलकम्" च अस्ति(पर्यायाः, चि.पदम्)।
}

कार्यम् चिह्नम्_मेलय(कोशः प, शब्दः पदम्) : सत्यता {
    यदि (चिह्नम्_अस्ति(प, पदम्)) {
        अग्रे(प)।
        प्रत्यागच्छ सत्य।
    }
    प्रत्यागच्छ असत्य।
}

कार्यम् कीलकम्_मेलय(कोशः प, सूची पर्यायाः) : सत्यता {
    यदि (कीलकम्_अस्ति(प, पर्यायाः)) {
        अग्रे(प)।
        प्रत्यागच्छ सत्य।
    }
    प्रत्यागच्छ असत्य।
}

कार्यम् चिह्नम्_अपेक्षस्व(कोशः प, शब्दः पदम्, शब्दः सन्देशः) : कोशः {
    यदि (चिह्नम्_अस्ति(प, पदम्)) {
        प्रत्यागच्छ अग्रे(प)।
    }
    कोशः चि = वर्तमानम्(प)।
    दोषम्_उत्सृज(सन्देशः + " — किन्तु प्राप्तम् '" + चि.पदम् + "'", चि.पङ्क्तिः)।
    प्रत्यागच्छ चि।
}

कार्यम् नाम_अपेक्षस्व(कोशः प, शब्दः सन्देशः) : कोशः {
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः == "नाम") {
        प्रत्यागच्छ अग्रे(प)।
    }
    दोषम्_उत्सृज(सन्देशः + " — किन्तु प्राप्तम् '" + चि.पदम् + "'", चि.पङ्क्तिः)।
    प्रत्यागच्छ चि।
}

कार्यम् वाक्यान्तः(कोशः प) {
    यावत् (चिह्नम्_अस्ति(प, "।") वा चिह्नम्_अस्ति(प, "॥") वा चिह्नम्_अस्ति(प, ";")) {
        अग्रे(प)।
    }
}

कार्यम् समाप्तम्_अस्ति(कोशः प) : सत्यता {
    प्रत्यागच्छ वर्तमानम्(प).प्रकारः == "समाप्तिः"।
}

# ------------------------------------------------------------------ प्रकाराः
कार्यम् प्रकारचिह्नम्_अस्ति(कोशः प) : सत्यता {
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः == "कीलकम्") {
        प्रत्यागच्छ अस्ति(क_कार्यम्, चि.पदम्) वा अस्ति(क_शून्य, चि.पदम्)।
    }
    यदि (चि.प्रकारः != "नाम") {
        प्रत्यागच्छ असत्य।
    }
    प्रत्यागच्छ अस्ति(प्रकारनामानि, चि.पदम्)।
}

कार्यम् प्रकारघोषणा_अस्ति(कोशः प) : सत्यता {
    यदि (न प्रकारचिह्नम्_अस्ति(प)) { प्रत्यागच्छ असत्य। }
    यदि (आगामि(प, १).प्रकारः != "नाम") { प्रत्यागच्छ असत्य। }
    यदि (कीलकम्_अस्ति(प, क_कार्यम्)) {
        कोशः तृतीयम् = आगामि(प, २)।
        प्रत्यागच्छ न (तृतीयम्.प्रकारः == "चिह्नम्" च तृतीयम्.पदम् == "(")।
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् प्रकारम्_पठ(कोशः प) : शब्दः {
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः == "कीलकम्") {
        यदि (अस्ति(क_कार्यम्, चि.पदम्)) { अग्रे(प)। प्रत्यागच्छ "कार्यम्"। }
        यदि (अस्ति(क_शून्य, चि.पदम्)) { अग्रे(प)। प्रत्यागच्छ "शून्यम्"। }
    }
    यदि (चि.प्रकारः == "नाम" च अस्ति(प्रकारनामानि, चि.पदम्)) {
        अग्रे(प)।
        प्रत्यागच्छ प्रकारनामानि[चि.पदम्]।
    }
    दोषम्_उत्सृज("प्रकारनाम अपेक्षितम् — किन्तु प्राप्तम् '" + चि.पदम् + "'", चि.पङ्क्तिः)।
    प्रत्यागच्छ "किमपि"।
}

कार्यम् कारकम्_पठ(कोशः प) : किमपि {
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः != "नाम") { प्रत्यागच्छ शून्य। }
    यदि (न अस्ति(कारकनामानि, चि.पदम्)) { प्रत्यागच्छ शून्य। }
    कोशः अग्रिमम् = आगामि(प, १)।
    यदि (अग्रिमम्.प्रकारः == "चिह्नम्") {
        यदि (अग्रिमम्.पदम् == "," वा अग्रिमम्.पदम् == ")" वा अग्रिमम्.पदम् == ":"
             वा अग्रिमम्.पदम् == "=") {
            प्रत्यागच्छ शून्य।
        }
    }
    अग्रे(प)।
    प्रत्यागच्छ कारकनामानि[चि.पदम्]।
}

# =========================================================== वाक्यानि
कार्यम् रचय_वाक्यरचनाम्(कर्म सूची चिह्नानि) : कोशः {
    कोशः प = स्थितिम्_रचय(चिह्नानि)।
    सूची वाक्यानि = []।
    यावत् (न समाप्तम्_अस्ति(प)) {
        योजय(वाक्यानि, वाक्यम्(प))।
    }
    प्रत्यागच्छ { "रूपम्": "कार्यक्रमः", "वाक्यानि": वाक्यानि, "पङ्क्तिः": १ }।
}

कार्यम् वाक्यम्(कोशः प) : कोशः {
    यदि (कीलकम्_अस्ति(प, क_मान) वा कीलकम्_अस्ति(प, क_ध्रुव)) {
        प्रत्यागच्छ चरघोषणा(प)।
    }
    यदि (प्रकारघोषणा_अस्ति(प)) {
        प्रत्यागच्छ चरघोषणा(प)।
    }
    यदि (कीलकम्_अस्ति(प, क_कार्यम्)) {
        कोशः द्वितीयम् = आगामि(प, १)।
        कोशः तृतीयम् = आगामि(प, २)।
        यदि (द्वितीयम्.प्रकारः == "नाम" च तृतीयम्.प्रकारः == "चिह्नम्"
             च तृतीयम्.पदम् == "(") {
            प्रत्यागच्छ कार्यघोषणा(प)।
        }
    }
    यदि (कीलकम्_मेलय(प, क_यदि)) { प्रत्यागच्छ यदिवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_यावत्)) { प्रत्यागच्छ यावद्वाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_प्रत्येकम्)) { प्रत्यागच्छ प्रत्येकवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_आवृत्तिः)) { प्रत्यागच्छ आवृत्तिवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_मुद्रय)) { प्रत्यागच्छ मुद्रणवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_आनय)) { प्रत्यागच्छ आयातवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_विकल्पः)) { प्रत्यागच्छ विकल्पवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_प्रयत्नः)) { प्रत्यागच्छ प्रयत्नवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_उत्सृज)) { प्रत्यागच्छ उत्सर्गवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_प्रत्यागच्छ)) { प्रत्यागच्छ प्रत्यागमनवाक्यम्(प)। }
    यदि (कीलकम्_मेलय(प, क_विरम)) {
        पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
        वाक्यान्तः(प)।
        प्रत्यागच्छ { "रूपम्": "विरामः", "पङ्क्तिः": पङ्क्तिः }।
    }
    यदि (कीलकम्_मेलय(प, क_अनुवर्त)) {
        पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
        वाक्यान्तः(प)।
        प्रत्यागच्छ { "रूपम्": "अनुवर्तनम्", "पङ्क्तिः": पङ्क्तिः }।
    }
    यदि (चिह्नम्_अस्ति(प, "{")) {
        प्रत्यागच्छ खण्डः(प)।
    }
    प्रत्यागच्छ पदवाक्यम्(प)।
}

कार्यम् चरघोषणा(कोशः प) : कोशः {
    सत्यता ध्रुवः = असत्य।
    शब्दः प्रकारः = "किमपि"।
    पूर्णाङ्कः पङ्क्तिः = वर्तमानम्(प).पङ्क्तिः।

    यदि (कीलकम्_अस्ति(प, क_मान) वा कीलकम्_अस्ति(प, क_ध्रुव)) {
        कोशः कीलकम् = अग्रे(प)।
        ध्रुवः = अस्ति(क_ध्रुव, कीलकम्.पदम्)।
        पङ्क्तिः = कीलकम्.पङ्क्तिः।
        यदि (प्रकारघोषणा_अस्ति(प)) {
            प्रकारः = प्रकारम्_पठ(प)।
        }
    } अन्यथा {
        प्रकारः = प्रकारम्_पठ(प)।
    }

    कोशः नामचिह्नम् = नाम_अपेक्षस्व(प, "नाम अपेक्षितम्")।
    यदि (चिह्नम्_मेलय(प, ":")) {
        प्रकारः = प्रकारम्_पठ(प)।
    }

    किमपि मूल्यम् = शून्य।
    यदि (चिह्नम्_मेलय(प, "=")) {
        मूल्यम् = पदम्(प)।
    } अन्यथा {
        यदि (ध्रुवः) {
            दोषम्_उत्सृज("ध्रुवस्य मूल्यम् आवश्यकम्", पङ्क्तिः)।
        }
    }
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "चरघोषणा", "नाम": नामचिह्नम्.पदम्, "मूल्यम्": मूल्यम्,
                  "ध्रुवः": ध्रुवः, "प्रकारः": प्रकारः, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् कार्यघोषणा(कोशः प) : कोशः {
    कोशः कीलकम् = अग्रे(प)।
    कोशः नामचिह्नम् = नाम_अपेक्षस्व(प, "कार्यस्य नाम अपेक्षितम्")।
    सूची प्राचलाः = प्राचलान्_पठ(प)।
    शब्दः प्रतिफलप्रकारः = प्रतिफलप्रकारम्_पठ(प)।
    कोशः शरीरम् = खण्डः(प)।
    प्रत्यागच्छ { "रूपम्": "कार्यघोषणा", "नाम": नामचिह्नम्.पदम्, "प्राचलाः": प्राचलाः,
                  "शरीरम्": शरीरम्, "प्रतिफलप्रकारः": प्रतिफलप्रकारः,
                  "पङ्क्तिः": कीलकम्.पङ्क्तिः }।
}

कार्यम् प्राचलान्_पठ(कोशः प) : सूची {
    चिह्नम्_अपेक्षस्व(प, "(", "'(' अपेक्षितम्")।
    सूची प्राचलाः = []।
    यदि (न चिह्नम्_अस्ति(प, ")")) {
        सत्यता चलतु = सत्य।
        यावत् (चलतु) {
            किमपि कारकम् = कारकम्_पठ(प)।
            शब्दः प्रकारः = "किमपि"।
            यदि (प्रकारचिह्नम्_अस्ति(प) च आगामि(प, १).प्रकारः == "नाम") {
                प्रकारः = प्रकारम्_पठ(प)।
            }
            कोशः नामचिह्नम् = नाम_अपेक्षस्व(प, "प्राचलनाम अपेक्षितम्")।
            यदि (चिह्नम्_मेलय(प, ":")) {
                प्रकारः = प्रकारम्_पठ(प)।
            }
            योजय(प्राचलाः, { "रूपम्": "प्राचलः", "नाम": नामचिह्नम्.पदम्,
                             "प्रकारः": प्रकारः, "कारकम्": कारकम् })।
            चलतु = चिह्नम्_मेलय(प, ",")।
        }
    }
    चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
    प्रत्यागच्छ प्राचलाः।
}

कार्यम् प्रतिफलप्रकारम्_पठ(कोशः प) : शब्दः {
    यदि (चिह्नम्_मेलय(प, ":")) {
        प्रत्यागच्छ प्रकारम्_पठ(प)।
    }
    प्रत्यागच्छ "किमपि"।
}

कार्यम् यदिवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः परीक्षा = पदम्(प)।
    कोशः तदा = खण्डः(प)।
    किमपि अन्यथा_ = शून्य।
    यदि (कीलकम्_मेलय(प, क_अन्यथा)) {
        यदि (कीलकम्_मेलय(प, क_यदि)) {
            अन्यथा_ = यदिवाक्यम्(प)।
        } अन्यथा {
            अन्यथा_ = खण्डः(प)।
        }
    }
    प्रत्यागच्छ { "रूपम्": "यदिवाक्यम्", "परीक्षा": परीक्षा, "तदा": तदा,
                  "अन्यथापक्षः": अन्यथा_, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् यावद्वाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः परीक्षा = पदम्(प)।
    कोशः शरीरम् = खण्डः(प)।
    प्रत्यागच्छ { "रूपम्": "यावद्वाक्यम्", "परीक्षा": परीक्षा, "शरीरम्": शरीरम्,
                  "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् आवृत्तिवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः गणना = पदम्(प)।
    कोशः शरीरम् = खण्डः(प)।
    प्रत्यागच्छ { "रूपम्": "आवृत्तिवाक्यम्", "गणना": गणना, "शरीरम्": शरीरम्,
                  "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् प्रत्येकवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    सत्यता कोष्ठकम् = चिह्नम्_मेलय(प, "(")।
    कोशः चरः = नाम_अपेक्षस्व(प, "चरनाम अपेक्षितम्")।
    यदि (न कीलकम्_मेलय(प, क_अन्तः)) {
        दोषम्_उत्सृज("'अन्तः' अपेक्षितम्", वर्तमानम्(प).पङ्क्तिः)।
    }
    कोशः संग्रहः = पदम्(प)।
    यदि (कोष्ठकम्) {
        चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
    }
    कोशः शरीरम् = खण्डः(प)।
    प्रत्यागच्छ { "रूपम्": "प्रत्येकवाक्यम्", "चरः": चरः.पदम्, "संग्रहः": संग्रहः,
                  "शरीरम्": शरीरम्, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् मुद्रणवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    सूची प्राचलाः = []।

    यदि (वाक्यान्ते_अस्ति(प)) {
        वाक्यान्तः(प)।
        प्रत्यागच्छ { "रूपम्": "मुद्रणम्", "प्राचलाः": प्राचलाः, "पङ्क्तिः": पङ्क्तिः }।
    }

    # मुद्रय(अ, ब) इति आह्वानरूपम् प्रथमम् प्रयत्येते; तत् न सिध्यति चेत्
    # मुद्रय अ, ब इति आज्ञारूपम् — पुनः स्थानम् आदाय।
    यदि (चिह्नम्_अस्ति(प, "(")) {
        पूर्णाङ्कः रक्षितम् = प.स्थानम्।
        प्रयत्नः {
            अग्रे(प)।
            यदि (न चिह्नम्_अस्ति(प, ")")) {
                सत्यता चलतु = सत्य।
                यावत् (चलतु) {
                    योजय(प्राचलाः, पदम्(प))।
                    चलतु = चिह्नम्_मेलय(प, ",")।
                }
            }
            चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
            यदि (अनुवर्तकम्_अस्ति(प)) {
                दोषम्_उत्सृज("पुनः प्रयत्नः", पङ्क्तिः)।
            }
            वाक्यान्तः(प)।
            प्रत्यागच्छ { "रूपम्": "मुद्रणम्", "प्राचलाः": प्राचलाः,
                          "पङ्क्तिः": पङ्क्तिः }।
        } दोषे (द) {
            प.स्थानम् = रक्षितम्।
            प्राचलाः = []।
        }
    }

    सत्यता चलतु = सत्य।
    यावत् (चलतु) {
        योजय(प्राचलाः, पदम्(प))।
        चलतु = चिह्नम्_मेलय(प, ",")।
    }
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "मुद्रणम्", "प्राचलाः": प्राचलाः, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् वाक्यान्ते_अस्ति(कोशः प) : सत्यता {
    यदि (समाप्तम्_अस्ति(प)) { प्रत्यागच्छ सत्य। }
    प्रत्यागच्छ चिह्नम्_अस्ति(प, "।") वा चिह्नम्_अस्ति(प, "॥")
               वा चिह्नम्_अस्ति(प, ";") वा चिह्नम्_अस्ति(प, "}")।
}

कार्यम् अनुवर्तकम्_अस्ति(कोशः प) : सत्यता {
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः == "चिह्नम्") {
        प्रत्यागच्छ अस्ति(पदानुवर्तकाः, चि.पदम्) वा अस्ति(तार्किकचिह्नानि, चि.पदम्)।
    }
    यदि (चि.प्रकारः == "कीलकम्") {
        प्रत्यागच्छ अस्ति(क_च, चि.पदम्) वा अस्ति(क_वा, चि.पदम्)।
    }
    प्रत्यागच्छ असत्य।
}

कार्यम् आयातवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः != "शब्दः") {
        दोषम्_उत्सृज("सञ्चिकानाम अपेक्षितम्", चि.पङ्क्तिः)।
    }
    अग्रे(प)।
    किमपि उपनाम = शून्य।
    सूची नामानि = []।
    यदि (कीलकम्_मेलय(प, क_इति)) {
        उपनाम = नाम_अपेक्षस्व(प, "नाम अपेक्षितम्").पदम्।
    } अन्यथा यदि (कीलकम्_मेलय(प, क_तः)) {
        सत्यता चलतु = सत्य।
        यावत् (चलतु) {
            योजय(नामानि, नाम_अपेक्षस्व(प, "नाम अपेक्षितम्").पदम्)।
            चलतु = चिह्नम्_मेलय(प, ",")।
        }
    }
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "आयातः", "पथः": चि.मूल्यम्, "उपनाम": उपनाम,
                  "नामानि": नामानि, "पङ्क्तिः": पङ्क्तिः }।
}

# विकल्पः (क) { पक्षे १, २: ... अन्यथा: ... }
# पक्षः स्वयमेव समाप्यते — अग्रिमः पक्षे, अन्यथा, वा कोष्ठकान्तः तम् सीमयति।
# A पक्षः ends where the next one begins; there is no fall-through to stop, so
# nothing has to be written to stop it.
कार्यम् विकल्पवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    सत्यता कोष्ठकम् = चिह्नम्_मेलय(प, "(")।
    कोशः विषयः = पदम्(प)।
    यदि (कोष्ठकम्) { चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")। }
    चिह्नम्_अपेक्षस्व(प, "{", "'{' अपेक्षितम्")।

    सूची पक्षाः = []।
    सत्यता अन्यथादृष्टः = असत्य।
    यावत् (न चिह्नम्_अस्ति(प, "}") च न समाप्तम्_अस्ति(प)) {
        सूची मूल्यानि = []।
        पूर्णाङ्कः पक्षपङ्क्तिः = वर्तमानम्(प).पङ्क्तिः।
        यदि (कीलकम्_मेलय(प, क_पक्षे)) {
            पक्षपङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
            योजय(मूल्यानि, पदम्(प))।
            यावत् (चिह्नम्_मेलय(प, ",")) {
                योजय(मूल्यानि, पदम्(प))।
            }
        } अन्यथा यदि (कीलकम्_मेलय(प, क_अन्यथा)) {
            पक्षपङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
            यदि (अन्यथादृष्टः) {
                दोषम्_उत्सृज("एकम् एव 'अन्यथा' विकल्पे", पक्षपङ्क्तिः)।
            }
            अन्यथादृष्टः = सत्य।
        } अन्यथा {
            दोषम्_उत्सृज("'पक्षे' अथवा 'अन्यथा' अपेक्षितम्", पक्षपङ्क्तिः)।
        }
        चिह्नम्_अपेक्षस्व(प, ":", "':' अपेक्षितम्")।

        सूची वाक्यानि = []।
        यावत् (न चिह्नम्_अस्ति(प, "}") च न कीलकम्_अस्ति(प, क_पक्षे)
               च न कीलकम्_अस्ति(प, क_अन्यथा) च न समाप्तम्_अस्ति(प)) {
            योजय(वाक्यानि, वाक्यम्(प))।
        }
        योजय(पक्षाः, { "रूपम्": "पक्षः", "मूल्यानि": मूल्यानि,
                        "वाक्यानि": वाक्यानि, "पङ्क्तिः": पक्षपङ्क्तिः })।
    }
    चिह्नम्_अपेक्षस्व(प, "}", "'}' अपेक्षितम्")।
    प्रत्यागच्छ { "रूपम्": "विकल्पवाक्यम्", "विषयः": विषयः,
                  "पक्षाः": पक्षाः, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् प्रयत्नवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः शरीरम् = खण्डः(प)।
    किमपि दोषचरः = शून्य।
    किमपि दोषशरीरम् = शून्य।
    किमपि अन्तशरीरम् = शून्य।

    यदि (कीलकम्_मेलय(प, क_दोषे)) {
        सत्यता कोष्ठकम् = चिह्नम्_मेलय(प, "(")।
        यदि (वर्तमानम्(प).प्रकारः == "नाम") {
            दोषचरः = अग्रे(प).पदम्।
        }
        यदि (कोष्ठकम्) {
            चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
        }
        दोषशरीरम् = खण्डः(प)।
    }
    यदि (कीलकम्_मेलय(प, क_अन्ततः)) {
        अन्तशरीरम् = खण्डः(प)।
    }
    यदि (दोषशरीरम् == शून्य च अन्तशरीरम् == शून्य) {
        दोषम्_उत्सृज("'दोषे' अथवा 'अन्ततः' अपेक्षितम्", पङ्क्तिः)।
    }
    प्रत्यागच्छ { "रूपम्": "प्रयत्नवाक्यम्", "शरीरम्": शरीरम्, "दोषचरः": दोषचरः,
                  "दोषशरीरम्": दोषशरीरम्, "अन्तशरीरम्": अन्तशरीरम्,
                  "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् उत्सर्गवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    कोशः मूल्यम् = पदम्(प)।
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "उत्सर्गः", "मूल्यम्": मूल्यम्, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् प्रत्यागमनवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = पूर्वम्(प).पङ्क्तिः।
    किमपि मूल्यम् = शून्य।
    यदि (न वाक्यान्ते_अस्ति(प)) {
        मूल्यम् = पदम्(प)।
    }
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "प्रत्यागमनम्", "मूल्यम्": मूल्यम्, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् खण्डः(कोशः प) : कोशः {
    कोशः कोष्ठकम् = चिह्नम्_अपेक्षस्व(प, "{", "'{' अपेक्षितम्")।
    सूची वाक्यानि = []।
    यावत् (न चिह्नम्_अस्ति(प, "}") च न समाप्तम्_अस्ति(प)) {
        योजय(वाक्यानि, वाक्यम्(प))।
    }
    चिह्नम्_अपेक्षस्व(प, "}", "'}' अपेक्षितम्")।
    प्रत्यागच्छ { "रूपम्": "खण्डः", "वाक्यानि": वाक्यानि, "पङ्क्तिः": कोष्ठकम्.पङ्क्तिः }।
}

कार्यम् पदवाक्यम्(कोशः प) : कोशः {
    पूर्णाङ्कः पङ्क्तिः = वर्तमानम्(प).पङ्क्तिः।
    कोशः अन्तर्गतम् = पदम्(प)।
    वाक्यान्तः(प)।
    प्रत्यागच्छ { "रूपम्": "पदवाक्यम्", "पदम्": अन्तर्गतम्, "पङ्क्तिः": पङ्क्तिः }।
}

# =========================================================== पदानि
कार्यम् पदम्(कोशः प) : कोशः {
    प्रत्यागच्छ नियोजनम्(प)।
}

कार्यम् नियोजनम्(कोशः प) : कोशः {
    कोशः लक्ष्यम् = तार्किकम्_वा(प)।
    यदि (चिह्नम्_अस्ति(प, "=")) {
        कोशः समः = अग्रे(प)।
        प्रत्यागच्छ न्यासम्_रचय(लक्ष्यम्, नियोजनम्(प), समः.पङ्क्तिः)।
    }
    कोशः चि = वर्तमानम्(प)।
    यदि (चि.प्रकारः == "चिह्नम्" च अस्ति(संयुक्तचिह्नानि, चि.पदम्)) {
        अग्रे(प)।
        # "क += १" इति "क = क + १" — अत्रैव संक्षेपः विस्तार्यते
        शब्दः संकारकः = अंशः(चि.पदम्, ०, दीर्घता(चि.पदम्) - १)।
        कोशः दक्षिणम् = नियोजनम्(प)।
        कोशः पठनम् = पुनःपठनम्(लक्ष्यम्)।
        कोशः संयुक्तम् = द्विपदीम्_रचय(पठनम्, संकारकः, दक्षिणम्, चि.पङ्क्तिः)।
        प्रत्यागच्छ न्यासम्_रचय(लक्ष्यम्, संयुक्तम्, चि.पङ्क्तिः)।
    }
    प्रत्यागच्छ लक्ष्यम्।
}

कार्यम् न्यासम्_रचय(कोशः लक्ष्यम्, कोशः मूल्यम्, पूर्णाङ्कः पङ्क्तिः) : कोशः {
    यदि (लक्ष्यम्.रूपम् == "नाम") {
        प्रत्यागच्छ { "रूपम्": "नियोजनम्", "नाम": लक्ष्यम्.नाम, "मूल्यम्": मूल्यम्,
                      "पङ्क्तिः": पङ्क्तिः }।
    }
    यदि (लक्ष्यम्.रूपम् == "सूचकग्रहणम्") {
        प्रत्यागच्छ { "रूपम्": "सूचकन्यासः", "लक्ष्यम्": लक्ष्यम्.लक्ष्यम्,
                      "सूचकः": लक्ष्यम्.सूचकः, "मूल्यम्": मूल्यम्,
                      "पङ्क्तिः": पङ्क्तिः }।
    }
    दोषम्_उत्सृज("अयोग्यम् नियोजनलक्ष्यम्", पङ्क्तिः)।
    प्रत्यागच्छ लक्ष्यम्।
}

# संयुक्तनियोजने लक्ष्यम् पठ्यते अपि लिख्यते अपि — अतः द्विः मूल्याङ्कितम्
कार्यम् पुनःपठनम्(कोशः लक्ष्यम्) : कोशः {
    यदि (लक्ष्यम्.रूपम् == "नाम") {
        प्रत्यागच्छ { "रूपम्": "नाम", "नाम": लक्ष्यम्.नाम, "पङ्क्तिः": लक्ष्यम्.पङ्क्तिः }।
    }
    यदि (लक्ष्यम्.रूपम् == "सूचकग्रहणम्") {
        प्रत्यागच्छ { "रूपम्": "सूचकग्रहणम्", "लक्ष्यम्": लक्ष्यम्.लक्ष्यम्,
                      "सूचकः": लक्ष्यम्.सूचकः, "पङ्क्तिः": लक्ष्यम्.पङ्क्तिः }।
    }
    प्रत्यागच्छ लक्ष्यम्।
}

कार्यम् तार्किकम्_वा(कोशः प) : कोशः {
    कोशः वामम् = तार्किकम्_च(प)।
    यावत् (कीलकम्_अस्ति(प, क_वा) वा चिह्नम्_अस्ति(प, "||")) {
        कोशः संकारकः = अग्रे(प)।
        कोशः दक्षिणम् = तार्किकम्_च(प)।
        वामम् = { "रूपम्": "तार्किकम्", "वामम्": वामम्, "संकारकः": "वा",
                  "दक्षिणम्": दक्षिणम्, "पङ्क्तिः": संकारकः.पङ्क्तिः }।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् तार्किकम्_च(कोशः प) : कोशः {
    कोशः वामम् = समता(प)।
    यावत् (कीलकम्_अस्ति(प, क_च) वा चिह्नम्_अस्ति(प, "&&")) {
        कोशः संकारकः = अग्रे(प)।
        कोशः दक्षिणम् = समता(प)।
        वामम् = { "रूपम्": "तार्किकम्", "वामम्": वामम्, "संकारकः": "च",
                  "दक्षिणम्": दक्षिणम्, "पङ्क्तिः": संकारकः.पङ्क्तिः }।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् द्विपदीम्_रचय(कोशः वामम्, शब्दः संकारकः, कोशः दक्षिणम्, पूर्णाङ्कः पङ्क्तिः) : कोशः {
    प्रत्यागच्छ { "रूपम्": "द्विपदी", "वामम्": वामम्, "संकारकः": संकारकः,
                  "दक्षिणम्": दक्षिणम्, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् समता(कोशः प) : कोशः {
    कोशः वामम् = तुलना(प)।
    यावत् (चिह्नम्_अस्ति(प, "==") वा चिह्नम्_अस्ति(प, "!=")) {
        कोशः संकारकः = अग्रे(प)।
        वामम् = द्विपदीम्_रचय(वामम्, संकारकः.पदम्, तुलना(प), संकारकः.पङ्क्तिः)।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् तुलना(कोशः प) : कोशः {
    कोशः वामम् = योगपदम्(प)।
    यावत् (चिह्नम्_अस्ति(प, "<") वा चिह्नम्_अस्ति(प, "<=")
           वा चिह्नम्_अस्ति(प, ">") वा चिह्नम्_अस्ति(प, ">=")) {
        कोशः संकारकः = अग्रे(प)।
        वामम् = द्विपदीम्_रचय(वामम्, संकारकः.पदम्, योगपदम्(प), संकारकः.पङ्क्तिः)।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् योगपदम्(कोशः प) : कोशः {
    कोशः वामम् = गुणपदम्(प)।
    यावत् (चिह्नम्_अस्ति(प, "+") वा चिह्नम्_अस्ति(प, "-")) {
        कोशः संकारकः = अग्रे(प)।
        वामम् = द्विपदीम्_रचय(वामम्, संकारकः.पदम्, गुणपदम्(प), संकारकः.पङ्क्तिः)।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् गुणपदम्(कोशः प) : कोशः {
    कोशः वामम् = घातपदम्(प)।
    यावत् (चिह्नम्_अस्ति(प, "*") वा चिह्नम्_अस्ति(प, "/") वा चिह्नम्_अस्ति(प, "%")) {
        कोशः संकारकः = अग्रे(प)।
        वामम् = द्विपदीम्_रचय(वामम्, संकारकः.पदम्, घातपदम्(प), संकारकः.पङ्क्तिः)।
    }
    प्रत्यागच्छ वामम्।
}

कार्यम् घातपदम्(कोशः प) : कोशः {
    कोशः आधारः = एकपदी(प)।
    यदि (चिह्नम्_अस्ति(प, "^")) {
        कोशः संकारकः = अग्रे(प)।
        प्रत्यागच्छ द्विपदीम्_रचय(आधारः, "^", घातपदम्(प), संकारकः.पङ्क्तिः)।
    }
    प्रत्यागच्छ आधारः।
}

कार्यम् एकपदी(कोशः प) : कोशः {
    यदि (चिह्नम्_अस्ति(प, "-") वा चिह्नम्_अस्ति(प, "!") वा कीलकम्_अस्ति(प, क_न)) {
        कोशः संकारकः = अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "एकपदी", "संकारकः": संकारकः.पदम्, "दक्षिणम्": एकपदी(प),
                      "पङ्क्तिः": संकारकः.पङ्क्तिः }।
    }
    प्रत्यागच्छ उत्तरपदम्(प)।
}

कार्यम् उत्तरपदम्(कोशः प) : कोशः {
    कोशः पदम्_ = मूलपदम्(प)।
    सत्यता चलतु = सत्य।
    यावत् (चलतु) {
        यदि (चिह्नम्_अस्ति(प, "(")) {
            कोशः कोष्ठकम् = अग्रे(प)।
            पदम्_ = आह्वानम्_समापय(प, पदम्_, कोष्ठकम्.पङ्क्तिः)।
        } अन्यथा यदि (चिह्नम्_अस्ति(प, "[")) {
            कोशः कोष्ठकम् = अग्रे(प)।
            कोशः सूचकः = पदम्(प)।
            चिह्नम्_अपेक्षस्व(प, "]", "']' अपेक्षितम्")।
            पदम्_ = { "रूपम्": "सूचकग्रहणम्", "लक्ष्यम्": पदम्_, "सूचकः": सूचकः,
                      "पङ्क्तिः": कोष्ठकम्.पङ्क्तिः }।
        } अन्यथा यदि (चिह्नम्_अस्ति(प, ".")) {
            कोशः बिन्दुः = अग्रे(प)।
            कोशः कुञ्जिका = नाम_अपेक्षस्व(प, "कुञ्जिकानाम अपेक्षितम्")।
            पदम्_ = { "रूपम्": "सूचकग्रहणम्", "लक्ष्यम्": पदम्_,
                      "सूचकः": { "रूपम्": "मूल्यम्", "मूल्यम्": कुञ्जिका.पदम्,
                                 "पङ्क्तिः": बिन्दुः.पङ्क्तिः },
                      "पङ्क्तिः": बिन्दुः.पङ्क्तिः }।
        } अन्यथा {
            चलतु = असत्य।
        }
    }
    प्रत्यागच्छ पदम्_।
}

कार्यम् आह्वानम्_समापय(कोशः प, कोशः कार्यम्_, पूर्णाङ्कः पङ्क्तिः) : कोशः {
    सूची प्राचलाः = []।
    सूची कारकाः = []।
    यदि (न चिह्नम्_अस्ति(प, ")")) {
        सत्यता चलतु = सत्य।
        यावत् (चलतु) {
            किमपि कारकम् = शून्य।
            कोशः चि = वर्तमानम्(प)।
            यदि (चि.प्रकारः == "नाम" च अस्ति(कारकनामानि, चि.पदम्)) {
                कोशः अग्रिमम् = आगामि(प, १)।
                यदि (अग्रिमम्.प्रकारः == "चिह्नम्" च अग्रिमम्.पदम् == ":") {
                    अग्रे(प)।
                    अग्रे(प)।
                    कारकम् = कारकनामानि[चि.पदम्]।
                }
            }
            योजय(प्राचलाः, पदम्(प))।
            योजय(कारकाः, कारकम्)।
            चलतु = चिह्नम्_मेलय(प, ",")।
        }
    }
    चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
    प्रत्यागच्छ { "रूपम्": "आह्वानम्", "कार्यपदम्": कार्यम्_, "प्राचलाः": प्राचलाः,
                  "कारकाः": कारकाः, "पङ्क्तिः": पङ्क्तिः }।
}

कार्यम् मूलपदम्(कोशः प) : कोशः {
    कोशः चि = वर्तमानम्(प)।

    यदि (चि.प्रकारः == "अङ्कः" वा चि.प्रकारः == "शब्दः") {
        अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "मूल्यम्", "मूल्यम्": चि.मूल्यम्, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (कीलकम्_अस्ति(प, क_सत्य)) {
        अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "मूल्यम्", "मूल्यम्": सत्य, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (कीलकम्_अस्ति(प, क_असत्य)) {
        अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "मूल्यम्", "मूल्यम्": असत्य, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (कीलकम्_अस्ति(प, क_शून्य)) {
        अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "मूल्यम्", "मूल्यम्": शून्य, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (चि.प्रकारः == "नाम") {
        अग्रे(प)।
        प्रत्यागच्छ { "रूपम्": "नाम", "नाम": चि.पदम्, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (चिह्नम्_अस्ति(प, "(")) {
        अग्रे(प)।
        कोशः अन्तर्गतम् = पदम्(प)।
        चिह्नम्_अपेक्षस्व(प, ")", "')' अपेक्षितम्")।
        प्रत्यागच्छ अन्तर्गतम्।
    }
    यदि (चिह्नम्_अस्ति(प, "[")) {
        अग्रे(प)।
        सूची अङ्गानि = []।
        यदि (न चिह्नम्_अस्ति(प, "]")) {
            सत्यता चलतु = सत्य।
            यावत् (चलतु) {
                योजय(अङ्गानि, पदम्(प))।
                चलतु = चिह्नम्_मेलय(प, ",")।
                यदि (चिह्नम्_अस्ति(प, "]")) { चलतु = असत्य। }
            }
        }
        चिह्नम्_अपेक्षस्व(प, "]", "']' अपेक्षितम्")।
        प्रत्यागच्छ { "रूपम्": "सूचीरचना", "अङ्गानि": अङ्गानि, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (चिह्नम्_अस्ति(प, "{")) {
        अग्रे(प)।
        सूची युग्मानि = []।
        यदि (न चिह्नम्_अस्ति(प, "}")) {
            सत्यता चलतु = सत्य।
            यावत् (चलतु) {
                कोशः कुञ्जिका = पदम्(प)।
                चिह्नम्_अपेक्षस्व(प, ":", "':' अपेक्षितम्")।
                योजय(युग्मानि, [कुञ्जिका, पदम्(प)])।
                चलतु = चिह्नम्_मेलय(प, ",")।
                यदि (चिह्नम्_अस्ति(प, "}")) { चलतु = असत्य। }
            }
        }
        चिह्नम्_अपेक्षस्व(प, "}", "'}' अपेक्षितम्")।
        प्रत्यागच्छ { "रूपम्": "कोशरचना", "युग्मानि": युग्मानि, "पङ्क्तिः": चि.पङ्क्तिः }।
    }
    यदि (कीलकम्_अस्ति(प, क_कार्यम्)) {
        अग्रे(प)।
        सूची प्राचलाः = प्राचलान्_पठ(प)।
        शब्दः प्रतिफलप्रकारः = प्रतिफलप्रकारम्_पठ(प)।
        कोशः शरीरम् = खण्डः(प)।
        प्रत्यागच्छ { "रूपम्": "अनामकार्यम्", "नाम": "अनाम", "प्राचलाः": प्राचलाः,
                      "शरीरम्": शरीरम्, "प्रतिफलप्रकारः": प्रतिफलप्रकारः,
                      "पङ्क्तिः": चि.पङ्क्तिः }।
    }

    दोषम्_उत्सृज("अप्रत्याशितम् चिह्नम् '" + चि.पदम् + "'", चि.पङ्क्तिः)।
    प्रत्यागच्छ चि।
}
