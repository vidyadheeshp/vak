ध्रुव कोशः द्विपदीआदेशाः = {
    "+": आ_योगः, "-": आ_वियोगः, "*": आ_गुणनम्, "/": आ_भागः,
    "%": आ_शेषः, "^": आ_घातः,
    "==": आ_समम्, "!=": आ_असमम्, "<": आ_न्यूनम्, "<=": आ_न्यूनसमम्,
    ">": आ_अधिकम्, ">=": आ_अधिकसमम्,
}।

# ======================================================== खण्डः तथा संकलकः
कार्यम् खण्डम्_रचय(शब्दः नाम) : कोशः {
    प्रत्यागच्छ { "नाम": नाम, "सङ्केताः": [], "ध्रुवाः": [], "पङ्क्तयः": [] }।
}

# स्थाननिर्णयः — संकलकः तान् एव परिवेशान् मनसि धारयति यान् यन्त्रम् रचयिष्यति,
# अतः यत् नाम सः पश्यति तत् अन्वेषणेन न, स्थानेन गृह्यते।
# The compiler holds the same picture of the scopes the machine will build, so
# a name it can see declared is read by place instead of by search.  A परिवेशः
# here is the ordered सूची of the names bound in it; शून्य stands for the global
# scope, whose contents the compiler cannot know — nothing resolves through it.
कार्यम् संकलकम्_रचय(शब्दः नाम) : कोशः {
    प्रत्यागच्छ { "खण्डः": खण्डम्_रचय(नाम), "पाशाः": [], "गभीरता": ०,
                  "परिवेशाः": [शून्य], "आच्छादितानि": [] }।
}

कार्यम् परिवेशम्_आरभ(कोशः सं, किमपि नामानि) {
    यदि (नामानि == शून्य) { योजय(सं.परिवेशाः, [])। }
    अन्यथा { योजय(सं.परिवेशाः, नामानि)। }
}

कार्यम् परिवेशम्_त्यज(कोशः सं) {
    निष्कास(सं.परिवेशाः)।
}

# यन्त्रम् समनामकम् बन्धम् तत्रैव स्थाने पुनः लिखति — अतः पुनर्घोषणा नूतनम् स्थानम् न गृह्णाति।
# The machine overwrites a binding of the same name in place, keeping its
# position — so a redeclaration must not take a second slot here either.
कार्यम् नाम_घोषय(कोशः सं, शब्दः नाम) {
    किमपि परिवेशः = सं.परिवेशाः[-१]।
    यदि (परिवेशः != शून्य) {
        यदि (न अस्ति(परिवेशः, नाम)) { योजय(परिवेशः, नाम)। }
    }
}

# [कति परिवेशाः उपरि, कतमः बन्धः] — अथवा शून्य, यत् अन्वेषणम् इच्छति
कार्यम् स्थानम्_निर्णय(कोशः सं, शब्दः नाम) : किमपि {
    पूर्णाङ्कः उत्तरः = ०।
    पूर्णाङ्कः क = दीर्घता(सं.परिवेशाः) - १।
    यावत् (क >= ०) {
        किमपि परिवेशः = सं.परिवेशाः[क]।
        यदि (परिवेशः == शून्य) { प्रत्यागच्छ शून्य। }
        पूर्णाङ्कः स्थानम् = ०।
        यावत् (स्थानम् < दीर्घता(परिवेशः)) {
            यदि (परिवेशः[स्थानम्] == नाम) { प्रत्यागच्छ [उत्तरः, स्थानम्]। }
            स्थानम् += १।
        }
        उत्तरः += १।
        क -= १।
    }
    प्रत्यागच्छ शून्य।
}

कार्यम् आदेशम्_लिख(कोशः सं, पूर्णाङ्कः आदेशः, सूची प्राचलाः, पूर्णाङ्कः पङ्क्तिः) : पूर्णाङ्कः {
    कोशः खण्डः = सं.खण्डः।
    पूर्णाङ्कः स्थानम् = दीर्घता(खण्डः.सङ्केताः)।
    योजय(खण्डः.सङ्केताः, आदेशः)।
    योजय(खण्डः.पङ्क्तयः, पङ्क्तिः)।
    प्रत्येकम् (प्राचलः अन्तः प्राचलाः) {
        योजय(खण्डः.सङ्केताः, प्राचलः)।
        योजय(खण्डः.पङ्क्तयः, पङ्क्तिः)।
    }
    प्रत्यागच्छ स्थानम्।
}

# ध्रुवाणाम् एकीकरणम् — प्रकारः अपि तुल्यः भवेत् (१ तथा १.० भिन्नौ)
कार्यम् ध्रुवम्_योजय(कोशः सं, किमपि मूल्यम्) : पूर्णाङ्कः {
    सूची ध्रुवाः = सं.खण्डः.ध्रुवाः।
    पूर्णाङ्कः क = ०।
    यावत् (क < दीर्घता(ध्रुवाः)) {
        किमपि विद्यमानम् = ध्रुवाः[क]।
        यदि (प्रकार(विद्यमानम्) == प्रकार(मूल्यम्)) {
            यदि (विद्यमानम् == मूल्यम्) {
                प्रत्यागच्छ क।
            }
        }
        क = क + १।
    }
    योजय(ध्रुवाः, मूल्यम्)।
    प्रत्यागच्छ दीर्घता(ध्रुवाः) - १।
}

कार्यम् लङ्घनम्_लिख(कोशः सं, पूर्णाङ्कः आदेशः, पूर्णाङ्कः पङ्क्तिः) : पूर्णाङ्कः {
    प्रत्यागच्छ आदेशम्_लिख(सं, आदेशः, [०], पङ्क्तिः)।
}

कार्यम् संस्कुरु(कोशः सं, पूर्णाङ्कः स्थानम्) {
    सूची सङ्केताः = सं.खण्डः.सङ्केताः।
    सङ्केताः[स्थानम् + १] = दीर्घता(सङ्केताः) - (स्थानम् + २)।
}

कार्यम् संस्कुरु_प्रति(कोशः सं, पूर्णाङ्कः स्थानम्, पूर्णाङ्कः लक्ष्यम्) {
    सूची सङ्केताः = सं.खण्डः.सङ्केताः।
    सङ्केताः[स्थानम् + १] = लक्ष्यम् - (स्थानम् + २)।
}

कार्यम् पुनरागमनम्_लिख(कोशः सं, पूर्णाङ्कः आरम्भः, पूर्णाङ्कः पङ्क्तिः) {
    पूर्णाङ्कः स्थानम् = आदेशम्_लिख(सं, आ_पुनरागच्छ, [०], पङ्क्तिः)।
    सूची सङ्केताः = सं.खण्डः.सङ्केताः।
    सङ्केताः[स्थानम् + १] = (स्थानम् + २) - आरम्भः।
}

कार्यम् स्थानम्_अधुना(कोशः सं) : पूर्णाङ्कः {
    प्रत्यागच्छ दीर्घता(सं.खण्डः.सङ्केताः)।
}

# ================================================================ मुख्यम्
कार्यम् संकलय(कर्म कोशः वृक्षः) : कोशः {
    कोशः सं = संकलकम्_रचय("<मुख्यम्>")।
    घोषितानि_सङ्ग्रह(वृक्षः, सं.आच्छादितानि)।
    शरीरम्_संकलय(सं, वृक्षः.वाक्यानि)।
    आदेशम्_लिख(सं, आ_विरम, [], ०)।
    प्रत्यागच्छ सं.खण्डः।
}

# यानि नामानि प्रोग्रामः क्वापि घोषयति — तानि सर्वाणि।
# Every name the program binds, anywhere, at any depth.  A built-in whose name
# is among them might be shadowed at run time, so it is left to the search.
कार्यम् घोषितानि_सङ्ग्रह(कर्म किमपि नोड्, सम्प्रदानम् सूची फलम्) {
    शब्दः प्र = प्रकार(नोड्)।
    यदि (प्र == "सूची") {
        प्रत्येकम् (अङ्गम् अन्तः नोड्) { घोषितानि_सङ्ग्रह(अङ्गम्, फलम्)। }
        प्रत्यागच्छ शून्य।
    }
    यदि (प्र != "कोशः") { प्रत्यागच्छ शून्य। }

    यदि (अस्ति(नोड्, "रूपम्")) {
        शब्दः रूपम् = नोड्.रूपम्।
        यदि (रूपम् == "चरघोषणा" वा रूपम् == "कार्यघोषणा" वा रूपम् == "प्राचलः") {
            नाम_योजय(फलम्, नोड्.नाम)।
        } अन्यथा यदि (रूपम् == "प्रत्येकवाक्यम्") {
            नाम_योजय(फलम्, नोड्.चरः)।
        } अन्यथा यदि (रूपम् == "प्रयत्नवाक्यम्") {
            यदि (नोड्.दोषचरः != शून्य) { नाम_योजय(फलम्, नोड्.दोषचरः)। }
        } अन्यथा यदि (रूपम् == "आयातः") {
            यदि (दीर्घता(नोड्.नामानि) > ०) {
                प्रत्येकम् (नाम अन्तः नोड्.नामानि) { नाम_योजय(फलम्, नाम)। }
            } अन्यथा यदि (नोड्.उपनाम != शून्य) {
                नाम_योजय(फलम्, नोड्.उपनाम)।
            } अन्यथा {
                नाम_योजय(फलम्, आयातनाम(नोड्.पथः))।
            }
        }
    }
    प्रत्येकम् (कुञ्जिका अन्तः कुञ्जिकाः(नोड्)) {
        घोषितानि_सङ्ग्रह(नोड्[कुञ्जिका], फलम्)।
    }
}

कार्यम् नाम_योजय(सम्प्रदानम् सूची फलम्, कर्म शब्दः नाम) {
    यदि (न अस्ति(फलम्, नाम)) { योजय(फलम्, नाम)। }
}

कार्यम् शरीरम्_संकलय(कोशः सं, सूची वाक्यानि) {
    प्रत्येकम् (वाक्य अन्तः वाक्यानि) {
        पूर्वम्_घोषय(सं, वाक्य)।
    }
    प्रत्येकम् (वाक्य अन्तः वाक्यानि) {
        वाक्यम्_संकलय(सं, वाक्य)।
    }
}

# कार्याणि पूर्वम् ज्ञातानि / functions are hoisted
कार्यम् पूर्वम्_घोषय(कोशः सं, कोशः वाक्य) {
    यदि (वाक्य.रूपम् == "कार्यघोषणा") {
        कार्यम्_संकलय(सं, वाक्य.नाम, वाक्य.प्राचलाः, वाक्य.शरीरम्, वाक्य.प्रतिफलप्रकारः, वाक्य.पङ्क्तिः)।
        नाम_घोषय(सं, वाक्य.नाम)।
        आदेशम्_लिख(सं, आ_घोषय,
                    [ध्रुवम्_योजय(सं, वाक्य.नाम), ध्रुवम्_योजय(सं, "किमपि")], वाक्य.पङ्क्तिः)।
    }
}

# ============================================================== वाक्यानि
कार्यम् वाक्यम्_संकलय(कोशः सं, कोशः वाक्य) {
    शब्दः रूपम् = वाक्य.रूपम्।

    यदि (रूपम् == "कार्यघोषणा") {
        प्रत्यागच्छ शून्य।                      # पूर्वम् एव घोषितम्
    }
    यदि (रूपम् == "पदवाक्यम्") {
        पदम्_संकलय(सं, वाक्य.पदम्)।
        आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "मुद्रणम्") {
        प्रत्येकम् (प्रा अन्तः वाक्य.प्राचलाः) {
            पदम्_संकलय(सं, प्रा)।
        }
        आदेशम्_लिख(सं, आ_मुद्रय, [दीर्घता(वाक्य.प्राचलाः)], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "चरघोषणा") {
        यदि (वाक्य.मूल्यम् == शून्य) {
            आदेशम्_लिख(सं, आ_शून्यम्, [], वाक्य.पङ्क्तिः)।
        } अन्यथा {
            पदम्_संकलय(सं, वाक्य.मूल्यम्)।
        }
        पूर्णाङ्कः आदेशः = आ_घोषय।
        यदि (वाक्य.ध्रुवः) { आदेशः = आ_ध्रुवं_घोषय। }
        नाम_घोषय(सं, वाक्य.नाम)।
        आदेशम्_लिख(सं, आदेशः,
                    [ध्रुवम्_योजय(सं, वाक्य.नाम), ध्रुवम्_योजय(सं, वाक्य.प्रकारः)], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "खण्डः") {
        आदेशम्_लिख(सं, आ_परिवेशम्_आरभ, [], वाक्य.पङ्क्तिः)।
        सं.गभीरता = सं.गभीरता + १।
        परिवेशम्_आरभ(सं, शून्य)।
        शरीरम्_संकलय(सं, वाक्य.वाक्यानि)।
        परिवेशम्_त्यज(सं)।
        सं.गभीरता = सं.गभीरता - १।
        आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "यदिवाक्यम्") {
        यदिवाक्यम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "यावद्वाक्यम्") {
        यावद्वाक्यम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "आवृत्तिवाक्यम्") {
        पुनरावृत्तिम्_संकलय(सं, वाक्य.गणना, "_आवृत्तिः_", वाक्य.शरीरम्, वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "प्रत्येकवाक्यम्") {
        पुनरावृत्तिम्_संकलय(सं, वाक्य.संग्रहः, वाक्य.चरः, वाक्य.शरीरम्, वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "विरामः") {
        विरामम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "अनुवर्तनम्") {
        अनुवर्तनम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "प्रत्यागमनम्") {
        यदि (वाक्य.मूल्यम् == शून्य) {
            आदेशम्_लिख(सं, आ_शून्यम्, [], वाक्य.पङ्क्तिः)।
        } अन्यथा {
            पदम्_संकलय(सं, वाक्य.मूल्यम्)।
        }
        आदेशम्_लिख(सं, आ_प्रत्यागच्छ, [], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "उत्सर्गः") {
        पदम्_संकलय(सं, वाक्य.मूल्यम्)।
        आदेशम्_लिख(सं, आ_उत्सृज, [], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "आयातः") {
        सूची भारः = [वाक्य.पथः, वाक्य.उपनाम, वाक्य.नामानि]।
        # आनय एतानि एव बध्नाति, एतस्मिन् एव क्रमे — अन्यथा परतः सर्वाणि स्थानानि भ्रश्येयुः।
        यदि (दीर्घता(वाक्य.नामानि) > ०) {
            प्रत्येकम् (नाम अन्तः वाक्य.नामानि) { नाम_घोषय(सं, नाम)। }
        } अन्यथा यदि (वाक्य.उपनाम != शून्य) {
            नाम_घोषय(सं, वाक्य.उपनाम)।
        } अन्यथा {
            नाम_घोषय(सं, आयातनाम(वाक्य.पथः))।
        }
        आदेशम्_लिख(सं, आ_आनय, [ध्रुवम्_योजय(सं, भारः)], वाक्य.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "विकल्पवाक्यम्") {
        विकल्पम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "प्रयत्नवाक्यम्") {
        प्रयत्नम्_संकलय(सं, वाक्य)।
        प्रत्यागच्छ शून्य।
    }

    उत्सृज { "प्रकारः": "संकलनदोषः", "सन्देशः": "अज्ञातम् वाक्यम् " + रूपम्,
             "पङ्क्तिः": वाक्य.पङ्क्तिः }।
}

कार्यम् यदिवाक्यम्_संकलय(कोशः सं, कोशः वाक्य) {
    पदम्_संकलय(सं, वाक्य.परीक्षा)।
    पूर्णाङ्कः अन्यथालङ्घनम् = लङ्घनम्_लिख(सं, आ_असत्ये_लङ्घय, वाक्य.पङ्क्तिः)।
    आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
    वाक्यम्_संकलय(सं, वाक्य.तदा)।
    पूर्णाङ्कः अन्तलङ्घनम् = लङ्घनम्_लिख(सं, आ_लङ्घय, वाक्य.पङ्क्तिः)।
    संस्कुरु(सं, अन्यथालङ्घनम्)।
    आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
    यदि (वाक्य.अन्यथापक्षः != शून्य) {
        वाक्यम्_संकलय(सं, वाक्य.अन्यथापक्षः)।
    }
    संस्कुरु(सं, अन्तलङ्घनम्)।
}

कार्यम् पाशम्_आरभ(कोशः सं, पूर्णाङ्कः आरम्भः, पूर्णाङ्कः अतिरिक्तम्) : कोशः {
    कोशः पाशः = { "आरम्भः": आरम्भः, "गभीरता": सं.गभीरता, "अतिरिक्तम्": अतिरिक्तम्,
                   "विरामाः": [], "अनुवर्तनानि": [] }।
    योजय(सं.पाशाः, पाशः)।
    प्रत्यागच्छ पाशः।
}

कार्यम् पाशम्_समापय(कोशः सं, कोशः पाशः) {
    निष्कास(सं.पाशाः)।
    प्रत्येकम् (स्थानम् अन्तः पाशः.विरामाः) {
        संस्कुरु(सं, स्थानम्)।
    }
}

कार्यम् यावद्वाक्यम्_संकलय(कोशः सं, कोशः वाक्य) {
    पूर्णाङ्कः आरम्भः = स्थानम्_अधुना(सं)।
    कोशः पाशः = पाशम्_आरभ(सं, आरम्भः, ०)।
    पदम्_संकलय(सं, वाक्य.परीक्षा)।
    पूर्णाङ्कः निर्गमः = लङ्घनम्_लिख(सं, आ_असत्ये_लङ्घय, वाक्य.पङ्क्तिः)।
    आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
    वाक्यम्_संकलय(सं, वाक्य.शरीरम्)।
    प्रत्येकम् (स्थानम् अन्तः पाशः.अनुवर्तनानि) {
        संस्कुरु_प्रति(सं, स्थानम्, आरम्भः)।
    }
    पुनरागमनम्_लिख(सं, आरम्भः, वाक्य.पङ्क्तिः)।
    संस्कुरु(सं, निर्गमः)।
    आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
    पाशम्_समापय(सं, पाशः)।
}

कार्यम् पुनरावृत्तिम्_संकलय(कोशः सं, कोशः संग्रहः, शब्दः चरः, कोशः शरीरम्,
                              पूर्णाङ्कः पङ्क्तिः) {
    पदम्_संकलय(सं, संग्रहः)।
    आदेशम्_लिख(सं, आ_पुनरावर्तकम्_रचय, [], पङ्क्तिः)।
    पूर्णाङ्कः आरम्भः = स्थानम्_अधुना(सं)।
    कोशः पाशः = पाशम्_आरभ(सं, आरम्भः, १)।
    पूर्णाङ्कः निर्गमः = लङ्घनम्_लिख(सं, आ_पुनरावर्तय, पङ्क्तिः)।
    आदेशम्_लिख(सं, आ_परिवेशम्_आरभ, [], पङ्क्तिः)।
    सं.गभीरता = सं.गभीरता + १।
    परिवेशम्_आरभ(सं, [चरः])।
    आदेशम्_लिख(सं, आ_घोषय,
                [ध्रुवम्_योजय(सं, चरः), ध्रुवम्_योजय(सं, "किमपि")], पङ्क्तिः)।
    यदि (शरीरम्.रूपम् == "खण्डः") {
        शरीरम्_संकलय(सं, शरीरम्.वाक्यानि)।
    } अन्यथा {
        वाक्यम्_संकलय(सं, शरीरम्)।
    }
    परिवेशम्_त्यज(सं)।
    सं.गभीरता = सं.गभीरता - १।
    आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], पङ्क्तिः)।
    प्रत्येकम् (स्थानम् अन्तः पाशः.अनुवर्तनानि) {
        संस्कुरु_प्रति(सं, स्थानम्, आरम्भः)।
    }
    पुनरागमनम्_लिख(सं, आरम्भः, पङ्क्तिः)।
    संस्कुरु(सं, निर्गमः)।
    पाशम्_समापय(सं, पाशः)।
}

कार्यम् विरामम्_संकलय(कोशः सं, कोशः वाक्य) {
    यदि (दीर्घता(सं.पाशाः) == ०) {
        उत्सृज { "प्रकारः": "संकलनदोषः", "सन्देशः": "'विरम' पाशस्य बहिः",
                 "पङ्क्तिः": वाक्य.पङ्क्तिः }।
    }
    कोशः पाशः = सं.पाशाः[-१]।
    पूर्णाङ्कः क = सं.गभीरता - पाशः.गभीरता।
    यावत् (क > ०) {
        आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], वाक्य.पङ्क्तिः)।
        क = क - १।
    }
    पूर्णाङ्कः ज = पाशः.अतिरिक्तम्।
    यावत् (ज > ०) {
        आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
        ज = ज - १।
    }
    योजय(पाशः.विरामाः, लङ्घनम्_लिख(सं, आ_लङ्घय, वाक्य.पङ्क्तिः))।
}

कार्यम् अनुवर्तनम्_संकलय(कोशः सं, कोशः वाक्य) {
    यदि (दीर्घता(सं.पाशाः) == ०) {
        उत्सृज { "प्रकारः": "संकलनदोषः", "सन्देशः": "'अनुवर्त' पाशस्य बहिः",
                 "पङ्क्तिः": वाक्य.पङ्क्तिः }।
    }
    कोशः पाशः = सं.पाशाः[-१]।
    पूर्णाङ्कः क = सं.गभीरता - पाशः.गभीरता।
    यावत् (क > ०) {
        आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], वाक्य.पङ्क्तिः)।
        क = क - १।
    }
    योजय(पाशः.अनुवर्तनानि, लङ्घनम्_लिख(सं, आ_लङ्घय, वाक्य.पङ्क्तिः))।
}

# विकल्पः स्वकीयम् आदेशम् न इच्छति।
# विषयः स्तूपे तिष्ठति; प्रत्येकम् पक्षमूल्यम् तस्य प्रतिकृत्या सह तुल्यते, यः प्रथमम्
# मिलति सः एव स्वशरीरम् प्रति लङ्घयति। यन्त्रस्य विद्यमानैः एव आदेशैः रचितम् इति
# सर्वाणि यन्त्राणि — पैथन्, वाक्, C — एतत् तस्मिन् एव दिने चालयन्ति।
कार्यम् विकल्पम्_संकलय(कोशः सं, कोशः वाक्य) {
    पदम्_संकलय(सं, वाक्य.विषयः)।                      # [विषयः]

    सूची मेलनानि = []।
    किमपि अन्यथापक्षः = शून्य।
    प्रत्येकम् (पक्षः अन्तः वाक्य.पक्षाः) {
        यदि (दीर्घता(पक्षः.मूल्यानि) == ०) {
            अन्यथापक्षः = पक्षः।
        } अन्यथा {
            सूची लङ्घनानि = []।
            प्रत्येकम् (मूल्यम् अन्तः पक्षः.मूल्यानि) {
                आदेशम्_लिख(सं, आ_द्वित्वम्, [], पक्षः.पङ्क्तिः)।
                पदम्_संकलय(सं, मूल्यम्)।
                आदेशम्_लिख(सं, आ_समम्, [], पक्षः.पङ्क्तिः)।
                योजय(लङ्घनानि, लङ्घनम्_लिख(सं, आ_सत्ये_लङ्घय, पक्षः.पङ्क्तिः))।
                आदेशम्_लिख(सं, आ_त्यज, [], पक्षः.पङ्क्तिः)।
            }
            योजय(मेलनानि, [पक्षः, लङ्घनानि])।
        }
    }

    पूर्णाङ्कः अन्यथाप्रति = लङ्घनम्_लिख(सं, आ_लङ्घय, वाक्य.पङ्क्तिः)।

    सूची अन्तप्रति = []।
    प्रत्येकम् (युग्मम् अन्तः मेलनानि) {
        कोशः पक्षः = युग्मम्[०]।
        प्रत्येकम् (स्थानम् अन्तः युग्मम्[१]) {
            संस्कुरु(सं, स्थानम्)।
        }
        आदेशम्_लिख(सं, आ_त्यज, [], पक्षः.पङ्क्तिः)।     # मिलिता सत्यता
        आदेशम्_लिख(सं, आ_त्यज, [], पक्षः.पङ्क्तिः)।     # विषयः स्वयम्
        पक्षशरीरम्_संकलय(सं, पक्षः)।
        योजय(अन्तप्रति, लङ्घनम्_लिख(सं, आ_लङ्घय, पक्षः.पङ्क्तिः))।
    }

    संस्कुरु(सं, अन्यथाप्रति)।
    आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।         # अमिलितः विषयः
    यदि (अन्यथापक्षः != शून्य) {
        पक्षशरीरम्_संकलय(सं, अन्यथापक्षः)।
    }
    प्रत्येकम् (स्थानम् अन्तः अन्तप्रति) {
        संस्कुरु(सं, स्थानम्)।
    }
}

# पक्षः अपि स्वकीयः परिवेशः, अन्यः खण्डः इव।
कार्यम् पक्षशरीरम्_संकलय(कोशः सं, कोशः पक्षः) {
    आदेशम्_लिख(सं, आ_परिवेशम्_आरभ, [], पक्षः.पङ्क्तिः)।
    सं.गभीरता = सं.गभीरता + १।
    परिवेशम्_आरभ(सं, शून्य)।
    शरीरम्_संकलय(सं, पक्षः.वाक्यानि)।
    परिवेशम्_त्यज(सं)।
    सं.गभीरता = सं.गभीरता - १।
    आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], पक्षः.पङ्क्तिः)।
}

कार्यम् प्रयत्नम्_संकलय(कोशः सं, कोशः वाक्य) {
    पूर्णाङ्कः आरम्भः = आदेशम्_लिख(सं, आ_प्रयत्नम्_आरभ, [०, ०], वाक्य.पङ्क्तिः)।
    वाक्यम्_संकलय(सं, वाक्य.शरीरम्)।
    आदेशम्_लिख(सं, आ_प्रयत्नम्_त्यज, [], वाक्य.पङ्क्तिः)।
    पूर्णाङ्कः अन्तंप्रति = लङ्घनम्_लिख(सं, आ_लङ्घय, वाक्य.पङ्क्तिः)।

    पूर्णाङ्कः दोषस्थानम् = स्थानम्_अधुना(सं)।
    यदि (वाक्य.दोषशरीरम् != शून्य) {
        आदेशम्_लिख(सं, आ_परिवेशम्_आरभ, [], वाक्य.पङ्क्तिः)।
        सं.गभीरता = सं.गभीरता + १।
        यदि (वाक्य.दोषचरः != शून्य) {
            परिवेशम्_आरभ(सं, [वाक्य.दोषचरः])।
            आदेशम्_लिख(सं, आ_घोषय,
                        [ध्रुवम्_योजय(सं, वाक्य.दोषचरः), ध्रुवम्_योजय(सं, "किमपि")],
                        वाक्य.पङ्क्तिः)।
        } अन्यथा {
            परिवेशम्_आरभ(सं, शून्य)।
            आदेशम्_लिख(सं, आ_त्यज, [], वाक्य.पङ्क्तिः)।
        }
        शरीरम्_संकलय(सं, वाक्य.दोषशरीरम्.वाक्यानि)।
        परिवेशम्_त्यज(सं)।
        सं.गभीरता = सं.गभीरता - १।
        आदेशम्_लिख(सं, आ_परिवेशम्_त्यज, [], वाक्य.पङ्क्तिः)।
    }
    संस्कुरु(सं, अन्तंप्रति)।

    पूर्णाङ्कः अन्तस्थानम् = स्थानम्_अधुना(सं)।
    यदि (वाक्य.अन्तशरीरम् != शून्य) {
        वाक्यम्_संकलय(सं, वाक्य.अन्तशरीरम्)।
    }
    आदेशम्_लिख(सं, आ_अन्ततः_समापय, [], वाक्य.पङ्क्तिः)।

    सूची सङ्केताः = सं.खण्डः.सङ्केताः।
    यदि (वाक्य.दोषशरीरम् == शून्य) {
        सङ्केताः[आरम्भः + १] = -१।
    } अन्यथा {
        सङ्केताः[आरम्भः + १] = दोषस्थानम्।
    }
    सङ्केताः[आरम्भः + २] = अन्तस्थानम्।
}

# ================================================================ पदानि
कार्यम् पदम्_संकलय(कोशः सं, कोशः पदम्) {
    शब्दः रूपम् = पदम्.रूपम्।

    यदि (रूपम् == "मूल्यम्") {
        किमपि मूल्यम् = पदम्.मूल्यम्।
        यदि (मूल्यम् == शून्य) {
            आदेशम्_लिख(सं, आ_शून्यम्, [], पदम्.पङ्क्तिः)।
        } अन्यथा यदि (प्रकार(मूल्यम्) == "सत्यता") {
            यदि (मूल्यम्) {
                आदेशम्_लिख(सं, आ_सत्यम्, [], पदम्.पङ्क्तिः)।
            } अन्यथा {
                आदेशम्_लिख(सं, आ_असत्यम्, [], पदम्.पङ्क्तिः)।
            }
        } अन्यथा {
            आदेशम्_लिख(सं, आ_स्थापय, [ध्रुवम्_योजय(सं, मूल्यम्)], पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "नाम") {
        किमपि स्थानम् = स्थानम्_निर्णय(सं, पदम्.नाम)।
        यदि (स्थानम् == शून्य) {
            # अन्तर्निहितम् यत् प्रोग्रामः क्वापि न घोषयति — तत् अन्वेषणेन विना गृह्यते।
            यदि (अस्ति(अन्तर्निहितनामानि, पदम्.नाम)
                 च न अस्ति(सं.आच्छादितानि, पदम्.नाम)) {
                आदेशम्_लिख(सं, आ_अन्तर्निहितम्_गृहाण,
                            [ध्रुवम्_योजय(सं, पदम्.नाम)], पदम्.पङ्क्तिः)।
                प्रत्यागच्छ शून्य।
            }
            आदेशम्_लिख(सं, आ_गृहाण, [ध्रुवम्_योजय(सं, पदम्.नाम)], पदम्.पङ्क्तिः)।
        } अन्यथा {
            आदेशम्_लिख(सं, आ_स्थानात्_गृहाण,
                        [स्थानम्[०], स्थानम्[१], ध्रुवम्_योजय(सं, पदम्.नाम)],
                        पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "नियोजनम्") {
        पदम्_संकलय(सं, पदम्.मूल्यम्)।
        किमपि स्थानम् = स्थानम्_निर्णय(सं, पदम्.नाम)।
        यदि (स्थानम् == शून्य) {
            आदेशम्_लिख(सं, आ_न्यसय, [ध्रुवम्_योजय(सं, पदम्.नाम)], पदम्.पङ्क्तिः)।
        } अन्यथा {
            आदेशम्_लिख(सं, आ_स्थाने_न्यसय,
                        [स्थानम्[०], स्थानम्[१], ध्रुवम्_योजय(सं, पदम्.नाम)],
                        पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "सूचीरचना") {
        प्रत्येकम् (अङ्गम् अन्तः पदम्.अङ्गानि) {
            पदम्_संकलय(सं, अङ्गम्)।
        }
        आदेशम्_लिख(सं, आ_सूचीम्_रचय, [दीर्घता(पदम्.अङ्गानि)], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "कोशरचना") {
        प्रत्येकम् (युग्मम् अन्तः पदम्.युग्मानि) {
            पदम्_संकलय(सं, युग्मम्[०])।
            पदम्_संकलय(सं, युग्मम्[१])।
        }
        आदेशम्_लिख(सं, आ_कोशम्_रचय, [दीर्घता(पदम्.युग्मानि)], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "सूचकग्रहणम्") {
        पदम्_संकलय(सं, पदम्.लक्ष्यम्)।
        पदम्_संकलय(सं, पदम्.सूचकः)।
        आदेशम्_लिख(सं, आ_सूचकात्_गृहाण, [], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "सूचकन्यासः") {
        पदम्_संकलय(सं, पदम्.लक्ष्यम्)।
        पदम्_संकलय(सं, पदम्.सूचकः)।
        पदम्_संकलय(सं, पदम्.मूल्यम्)।
        आदेशम्_लिख(सं, आ_सूचके_न्यसय, [], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "एकपदी") {
        पदम्_संकलय(सं, पदम्.दक्षिणम्)।
        पूर्णाङ्कः आदेशः = आ_निषेधः।
        यदि (पदम्.संकारकः == "-") { आदेशः = आ_ऋणम्। }
        आदेशम्_लिख(सं, आदेशः, [], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "द्विपदी") {
        पदम्_संकलय(सं, पदम्.वामम्)।
        पदम्_संकलय(सं, पदम्.दक्षिणम्)।
        आदेशम्_लिख(सं, द्विपदीआदेशाः[पदम्.संकारकः], [], पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "तार्किकम्") {
        पदम्_संकलय(सं, पदम्.वामम्)।
        पूर्णाङ्कः आदेशः = आ_सत्ये_लङ्घय।
        यदि (पदम्.संकारकः == "च") { आदेशः = आ_असत्ये_लङ्घय। }
        पूर्णाङ्कः लङ्घनम् = लङ्घनम्_लिख(सं, आदेशः, पदम्.पङ्क्तिः)।
        आदेशम्_लिख(सं, आ_त्यज, [], पदम्.पङ्क्तिः)।
        पदम्_संकलय(सं, पदम्.दक्षिणम्)।
        संस्कुरु(सं, लङ्घनम्)।
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "आह्वानम्") {
        पदम्_संकलय(सं, पदम्.कार्यपदम्)।
        प्रत्येकम् (प्रा अन्तः पदम्.प्राचलाः) {
            पदम्_संकलय(सं, प्रा)।
        }
        सत्यता कारकयुक्तम् = असत्य।
        प्रत्येकम् (का अन्तः पदम्.कारकाः) {
            यदि (का != शून्य) { कारकयुक्तम् = सत्य। }
        }
        यदि (कारकयुक्तम्) {
            आदेशम्_लिख(सं, आ_कारकैः_आह्वय,
                        [दीर्घता(पदम्.प्राचलाः), ध्रुवम्_योजय(सं, पदम्.कारकाः)],
                        पदम्.पङ्क्तिः)।
        } अन्यथा {
            आदेशम्_लिख(सं, आ_आह्वय, [दीर्घता(पदम्.प्राचलाः)], पदम्.पङ्क्तिः)।
        }
        प्रत्यागच्छ शून्य।
    }
    यदि (रूपम् == "अनामकार्यम्") {
        कार्यम्_संकलय(सं, पदम्.नाम, पदम्.प्राचलाः, पदम्.शरीरम्, पदम्.प्रतिफलप्रकारः,
                       पदम्.पङ्क्तिः)।
        प्रत्यागच्छ शून्य।
    }

    उत्सृज { "प्रकारः": "संकलनदोषः", "सन्देशः": "अज्ञातम् पदम् " + रूपम्,
             "पङ्क्तिः": पदम्.पङ्क्तिः }।
}

# "अ/ब/स.vak" → "स"
कार्यम् आयातनाम(कर्म शब्दः पथः) : शब्दः {
    सूची खण्डाः = विभज(पथः, "/")।
    शब्दः अन्तिमम् = खण्डाः[-१]।
    खण्डाः = विभज(अन्तिमम्, "\\")।
    अन्तिमम् = खण्डाः[-१]।
    यदि (दीर्घता(अन्तिमम्) > ४) {
        यदि (अंशः(अन्तिमम्, दीर्घता(अन्तिमम्) - ४) == ".vak") {
            प्रत्यागच्छ अंशः(अन्तिमम्, ०, दीर्घता(अन्तिमम्) - ४)।
        }
    }
    प्रत्यागच्छ अन्तिमम्।
}

# ============================================================== कार्याणि
कार्यम् कार्यम्_संकलय(कोशः सं, शब्दः नाम, सूची प्राचलाः, कोशः शरीरम्,
                        शब्दः प्रतिफलप्रकारः, पूर्णाङ्कः पङ्क्तिः) {
    कोशः अन्तः_सं = संकलकम्_रचय(नाम)।
    अन्तः_सं.गभीरता = १।                      # आह्वानपरिवेशः एव प्रथमः
    # आह्वानपरिवेशस्य जनकः सः एव परिवेशः यत्र आवरणम् रचितम् — अतः बाह्याः परिवेशाः
    # अत्रापि गण्यन्ते, अन्तःस्थम् कार्यम् बाह्यस्य चरान् स्थानेन एव पश्यति।
    सूची बाह्याः = []।
    प्रत्येकम् (परिवेशः अन्तः सं.परिवेशाः) { योजय(बाह्याः, परिवेशः)। }
    सूची प्राचलनामानि = []।
    प्रत्येकम् (प्रा अन्तः प्राचलाः) { योजय(प्राचलनामानि, प्रा.नाम)। }
    योजय(बाह्याः, प्राचलनामानि)।
    अन्तः_सं.परिवेशाः = बाह्याः।
    अन्तः_सं.आच्छादितानि = सं.आच्छादितानि।
    शरीरम्_संकलय(अन्तः_सं, शरीरम्.वाक्यानि)।
    आदेशम्_लिख(अन्तः_सं, आ_शून्यम्, [], पङ्क्तिः)।
    आदेशम्_लिख(अन्तः_सं, आ_प्रत्यागच्छ, [], पङ्क्तिः)।

    कोशः संकलितम् = { "रूपम्": "संकलितकार्यम्", "नाम": नाम, "प्राचलाः": प्राचलाः,
                       "प्रतिफलप्रकारः": प्रतिफलप्रकारः, "खण्डः": अन्तः_सं.खण्डः }।
    आदेशम्_लिख(सं, आ_आवरणम्, [ध्रुवम्_योजय(सं, संकलितम्)], पङ्क्तिः)।
}
