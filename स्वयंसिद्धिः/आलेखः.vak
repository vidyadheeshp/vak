# आलेखः — कारकालेखः, the kāraka graph of a program.
#
# पाणिनिः वाक्यम् क्रियया परितः स्थितैः कारकैः वर्णयति — कः करोति, किम्, केन,
# कस्मात्।  वाक्-प्रोग्रामः अपि तादृशः एव: प्रत्येकम् कार्यम् क्रिया, तस्य प्राचलाः
# स्वकारकाणि वदन्ति, प्रत्येकम् आह्वानम् च तानि पूरयति वाक्यम्।  एषः विभागः तत्
# सर्वम् दत्तांशरूपेण निष्कासयति — शिक्षणाय।
#
# Pāṇini describes a sentence as an action surrounded by the roles of its
# participants. A Vāk program declares the same structure: every कार्यम् is an
# action whose parameters name their roles, and every call is a sentence that
# fills them. This module draws that out as data, and the playground draws the
# data as a picture, redrawn as you type.
#
#   रचय(वृक्षः)  →  { "कार्याणि": [...], "आह्वानानि": [...] }
#   जेसन्(मूल्यम्) →  the same, as JSON text the page can read
#
# A slot is filled नाम्ना (by naming its role), स्थानेन (by position), left
# अनुक्तम् (unstated, falling back to its default), or is न्यूनम् (missing).
#
# vaak/graph.py is the same algorithm in Python, and the two are held to
# identical output. Both walk the कोशः syntax tree both parsers produce,
# visiting keys in sorted order, so nothing depends on the order a dictionary
# happened to be built in.

# पाणिनेः नियमः — एकः कर्ता, एकम् कर्म।
ध्रुव सूची एककारकाणि = ["कर्ता", "कर्म"]।

# ------------------------------------------------------------------ भ्रमणम्
# पूर्वक्रमेण, कुञ्जिकाः क्रमिताः, अन्तर्गतस्य नामितकार्यस्य स्तूपेन सह।
कार्यम् भ्रम(किमपि पदम्, कार्यम् दर्शकः, सूची स्तूपः) {
    शब्दः प्र = प्रकार(पदम्)।
    यदि (प्र == "सूची") {
        प्रत्येकम् (अङ्गम् अन्तः पदम्) { भ्रम(अङ्गम्, दर्शकः, स्तूपः)। }
        प्रत्यागच्छ।
    }
    यदि (प्र != "कोशः") { प्रत्यागच्छ। }
    दर्शकः(पदम्, स्तूपः)।
    सत्यता घोषणा = अस्ति(पदम्, "रूपम्") च पदम्["रूपम्"] == "कार्यघोषणा"।
    यदि (घोषणा) { योजय(स्तूपः, पदम्["नाम"])। }
    प्रत्येकम् (कुञ्जिका अन्तः क्रम(कुञ्जिकाः(पदम्))) {
        किमपि उप = पदम्[कुञ्जिका]।
        शब्दः उपप्र = प्रकार(उप)।
        यदि (उपप्र == "कोशः" वा उपप्र == "सूची") { भ्रम(उप, दर्शकः, स्तूपः)। }
    }
    यदि (घोषणा) { निष्कास(स्तूपः)। }
}

कार्यम् रूपम्_अस्य(किमपि पदम्) : किमपि {
    यदि (प्रकार(पदम्) != "कोशः") { प्रत्यागच्छ शून्य। }
    यदि (न अस्ति(पदम्, "रूपम्")) { प्रत्यागच्छ शून्य। }
    प्रत्यागच्छ पदम्["रूपम्"]।
}

कार्यम् क्षेत्रम्(किमपि पदम्, शब्दः कुञ्जिका, किमपि अभावे) : किमपि {
    यदि (प्रकार(पदम्) == "कोशः" च अस्ति(पदम्, कुञ्जिका)) { प्रत्यागच्छ पदम्[कुञ्जिका]। }
    प्रत्यागच्छ अभावे।
}

# ------------------------------------------------------------------ नामपदम्
# प्राचलस्य लघु नाम, यथा चित्रे पठ्यते।
कार्यम् नामपदम्(किमपि पदम्) : शब्दः {
    किमपि रू = रूपम्_अस्य(पदम्)।
    यदि (रू == "नाम") { प्रत्यागच्छ पदम्["नाम"]। }
    यदि (रू == "मूल्यम्") {
        किमपि म = क्षेत्रम्(पदम्, "मूल्यम्", शून्य)।
        यदि (प्रकार(म) == "शब्दः") { प्रत्यागच्छ "\"" + म + "\""। }
        प्रत्यागच्छ शब्द(म)।
    }
    यदि (रू == "आह्वानम्") {
        किमपि आह्वेयम् = क्षेत्रम्(पदम्, "कार्यपदम्", शून्य)।
        यदि (रूपम्_अस्य(आह्वेयम्) == "नाम") { प्रत्यागच्छ आह्वेयम्["नाम"] + "(…)"। }
        प्रत्यागच्छ "…(…)"।
    }
    यदि (रू == "अनामकार्यम्") { प्रत्यागच्छ "कार्यम्(…)"। }
    यदि (रू == "सूचीरचना") { प्रत्यागच्छ "[…]"। }
    यदि (रू == "कोशरचना") { प्रत्यागच्छ "{…}"। }
    प्रत्यागच्छ "…"।
}

# ------------------------------------------------------------------ क्रिया
कार्यम् क्रियाम्_रचय(कोशः घोषणा) : कोशः {
    किमपि प्राचलाः = क्षेत्रम्(घोषणा, "प्राचलाः", [])।
    यदि (प्राचलाः == शून्य) { प्राचलाः = []। }
    सूची दोषाः = []।
    प्रत्येकम् (भूमिका अन्तः एककारकाणि) {
        पूर्णाङ्कः गणना = ०।
        प्रत्येकम् (प्रा अन्तः प्राचलाः) {
            यदि (क्षेत्रम्(प्रा, "कारकम्", शून्य) == भूमिका) { गणना += १। }
        }
        यदि (गणना > १) { योजय(दोषाः, भूमिका + " इति " + शब्द(गणना) + " वारम्")। }
    }
    सूची रूपाणि = []।
    प्रत्येकम् (प्रा अन्तः प्राचलाः) {
        योजय(रूपाणि, { "नाम": प्रा["नाम"],
                        "प्रकारः": क्षेत्रम्(प्रा, "प्रकारः", "किमपि"),
                        "कारकम्": क्षेत्रम्(प्रा, "कारकम्", शून्य),
                        "मूलम्": क्षेत्रम्(प्रा, "मूलमस्ति", असत्य) == सत्य })।
    }
    प्रत्यागच्छ { "नाम": घोषणा["नाम"],
                  "पङ्क्तिः": क्षेत्रम्(घोषणा, "पङ्क्तिः", ०),
                  "प्रतिफलम्": क्षेत्रम्(घोषणा, "प्रतिफलप्रकारः", "किमपि"),
                  "प्राचलाः": रूपाणि,
                  "दोषाः": दोषाः }।
}

# ------------------------------------------------------------------ वाक्यम्
# आह्वानम् कार्यस्य स्थानानि कथम् पूरयति — यन्त्रे यत् क्रियते तदेव, वृक्षे एव।
कार्यम् वाक्यम्_रचय(कोशः आह्वानम्, कोशः घोषणा, किमपि आवरकम्) : कोशः {
    किमपि प्राचलाः = क्षेत्रम्(घोषणा, "प्राचलाः", [])।
    यदि (प्राचलाः == शून्य) { प्राचलाः = []। }
    किमपि अर्थाः = क्षेत्रम्(आह्वानम्, "प्राचलाः", [])।
    यदि (अर्थाः == शून्य) { अर्थाः = []। }
    किमपि कारकाः = क्षेत्रम्(आह्वानम्, "कारकाः", [])।
    यदि (कारकाः == शून्य) { कारकाः = []। }

    पूर्णाङ्कः न् = दीर्घता(प्राचलाः)।
    सूची स्थानम् = []।
    सूची रीतिः = []।
    पूर्णाङ्कः क = ०।
    यावत् (क < न्) { योजय(स्थानम्, शून्य)। योजय(रीतिः, शून्य)। क += १। }
    सूची दोषाः = []।

    क = ०।
    यावत् (क < दीर्घता(अर्थाः)) {
        किमपि भूमिका = शून्य।
        यदि (क < दीर्घता(कारकाः)) { भूमिका = कारकाः[क]। }
        यदि (भूमिका != शून्य) {
            पूर्णाङ्कः यत्र = ० - १।
            पूर्णाङ्कः ज = ०।
            यावत् (ज < न्) {
                यदि (यत्र < ० च क्षेत्रम्(प्राचलाः[ज], "कारकम्", शून्य) == भूमिका) { यत्र = ज। }
                ज += १।
            }
            यदि (यत्र < ०) {
                योजय(दोषाः, भूमिका + " इति कारकम् नास्ति")।
            } अन्यथा यदि (स्थानम्[यत्र] != शून्य) {
                योजय(दोषाः, भूमिका + " द्विः")।
            } अन्यथा {
                स्थानम्[यत्र] = क।
                रीतिः[यत्र] = "नाम्ना"।
            }
        }
        क += १।
    }

    क = ०।
    यावत् (क < दीर्घता(अर्थाः)) {
        किमपि भूमिका = शून्य।
        यदि (क < दीर्घता(कारकाः)) { भूमिका = कारकाः[क]। }
        यदि (भूमिका == शून्य) {
            पूर्णाङ्कः यत्र = ० - १।
            पूर्णाङ्कः ज = ०।
            यावत् (ज < न्) {
                यदि (यत्र < ० च स्थानम्[ज] == शून्य) { यत्र = ज। }
                ज += १।
            }
            यदि (यत्र < ०) {
                योजय(दोषाः, "अतिरिक्तम्")।
            } अन्यथा {
                स्थानम्[यत्र] = क।
                रीतिः[यत्र] = "स्थानेन"।
            }
        }
        क += १।
    }

    सूची बन्धाः = []।
    क = ०।
    यावत् (क < न्) {
        कोशः प्रा = प्राचलाः[क]।
        किमपि भूमिका = क्षेत्रम्(प्रा, "कारकम्", शून्य)।
        यदि (स्थानम्[क] != शून्य) {
            योजय(बन्धाः, { "प्राचलः": प्रा["नाम"], "कारकम्": भूमिका,
                           "रीतिः": रीतिः[क], "मूल्यम्": नामपदम्(अर्थाः[स्थानम्[क]]) })।
        } अन्यथा यदि (क्षेत्रम्(प्रा, "मूलमस्ति", असत्य) == सत्य) {
            योजय(बन्धाः, { "प्राचलः": प्रा["नाम"], "कारकम्": भूमिका,
                           "रीतिः": "अनुक्तम्", "मूल्यम्": शून्य })।
        } अन्यथा {
            योजय(बन्धाः, { "प्राचलः": प्रा["नाम"], "कारकम्": भूमिका,
                           "रीतिः": "न्यूनम्", "मूल्यम्": शून्य })।
            यदि (भूमिका == शून्य) { योजय(दोषाः, "न्यूनम्: " + प्रा["नाम"])। }
            अन्यथा { योजय(दोषाः, "न्यूनम्: " + भूमिका)। }
        }
        क += १।
    }

    प्रत्यागच्छ { "कार्यम्": घोषणा["नाम"],
                  "पङ्क्तिः": क्षेत्रम्(आह्वानम्, "पङ्क्तिः", ०),
                  "अन्तः": आवरकम्,
                  "बन्धाः": बन्धाः,
                  "दोषाः": दोषाः }।
}

# ------------------------------------------------------------------ रचय
कार्यम् रचय(कोशः वृक्षः) : कोशः {
    सूची क्रियाः = []।
    कोशः प्रथमाः = {}।
    कार्यम् सङ्ग्रह(कोशः पदम्, सूची स्तूपः) {
        यदि (रूपम्_अस्य(पदम्) == "कार्यघोषणा") {
            योजय(क्रियाः, क्रियाम्_रचय(पदम्))।
            यदि (न अस्ति(प्रथमाः, पदम्["नाम"])) { प्रथमाः[पदम्["नाम"]] = पदम्। }
        }
    }
    भ्रम(वृक्षः, सङ्ग्रह, [])।

    सूची वाक्यानि = []।
    कार्यम् आह्वानानि(कोशः पदम्, सूची स्तूपः) {
        यदि (रूपम्_अस्य(पदम्) != "आह्वानम्") { प्रत्यागच्छ। }
        किमपि आह्वेयम् = क्षेत्रम्(पदम्, "कार्यपदम्", शून्य)।
        यदि (रूपम्_अस्य(आह्वेयम्) != "नाम") { प्रत्यागच्छ। }
        यदि (न अस्ति(प्रथमाः, आह्वेयम्["नाम"])) { प्रत्यागच्छ। }
        किमपि आवरकम् = शून्य।
        यदि (दीर्घता(स्तूपः) > ०) { आवरकम् = स्तूपः[-१]। }
        योजय(वाक्यानि, वाक्यम्_रचय(पदम्, प्रथमाः[आह्वेयम्["नाम"]], आवरकम्))।
    }
    भ्रम(वृक्षः, आह्वानानि, [])।

    प्रत्यागच्छ { "कार्याणि": क्रियाः, "आह्वानानि": वाक्यानि }।
}

# ------------------------------------------------------------------ जेसन्
# वाक्-मुद्रणम् शब्देषु उद्धरणचिह्नानि न रक्षति, अतः पृष्ठाय स्वकीयः लेखकः।
# Vāk's own printing does not escape quotes inside strings, so the page gets a
# writer of its own. Object keys are sorted, so the text is stable.
कार्यम् उद्धर(शब्दः स) : शब्दः {
    शब्दः फलम् = "\""।
    प्रत्येकम् (अक्षरम् अन्तः स) {
        यदि (अक्षरम् == "\"") { फलम् = फलम् + "\\\""। }
        अन्यथा यदि (अक्षरम् == "\\") { फलम् = फलम् + "\\\\"। }
        अन्यथा यदि (अक्षरम् == "\n") { फलम् = फलम् + "\\n"। }
        अन्यथा यदि (अक्षरम् == "\t") { फलम् = फलम् + "\\t"। }
        अन्यथा यदि (अक्षरम् == "\r") { फलम् = फलम् + "\\r"। }
        अन्यथा यदि (अक्षरम् == "\0") { फलम् = फलम् + "\\u0000"। }
        अन्यथा { फलम् = फलम् + अक्षरम्। }
    }
    प्रत्यागच्छ फलम् + "\""।
}

कार्यम् जेसन्(किमपि मूल्यम्) : शब्दः {
    शब्दः प्र = प्रकार(मूल्यम्)।
    यदि (प्र == "शून्यम्") { प्रत्यागच्छ "null"। }
    यदि (प्र == "सत्यता") {
        यदि (मूल्यम्) { प्रत्यागच्छ "true"। }
        प्रत्यागच्छ "false"।
    }
    यदि (प्र == "पूर्णाङ्कः" वा प्र == "दशांशः") { प्रत्यागच्छ शब्द(मूल्यम्)। }
    यदि (प्र == "शब्दः") { प्रत्यागच्छ उद्धर(मूल्यम्)। }
    यदि (प्र == "सूची") {
        सूची भागाः = []।
        प्रत्येकम् (अङ्गम् अन्तः मूल्यम्) { योजय(भागाः, जेसन्(अङ्गम्))। }
        प्रत्यागच्छ "[" + संयोज(भागाः, ",") + "]"।
    }
    यदि (प्र == "कोशः") {
        सूची भागाः = []।
        प्रत्येकम् (कुञ्जिका अन्तः क्रम(कुञ्जिकाः(मूल्यम्))) {
            योजय(भागाः, उद्धर(शब्द(कुञ्जिका)) + ":" + जेसन्(मूल्यम्[कुञ्जिका]))।
        }
        प्रत्यागच्छ "{" + संयोज(भागाः, ",") + "}"।
    }
    प्रत्यागच्छ "null"।
}
