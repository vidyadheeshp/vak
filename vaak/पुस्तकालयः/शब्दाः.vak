# शब्दाः — the string module of the Vāk standard library.
# स्वयम् वाक्-भाषायाम् एव लिखितम् / written in Vāk itself.
#
#     आनय "शब्दाः" तः विलोमः_वा, पुनरावृत्तिः।

कार्यम् आदौ_अस्ति(अधिकरणम् शब्दः पूर्णः, कर्म शब्दः आदिः) : सत्यता {
    पूर्णाङ्कः न् = दीर्घता(आदिः)।
    यदि (न् > दीर्घता(पूर्णः)) {
        प्रत्यागच्छ असत्य।
    }
    प्रत्येकम् (क अन्तः परास(०, न्)) {
        यदि (पूर्णः[क] != आदिः[क]) {
            प्रत्यागच्छ असत्य।
        }
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् अन्ते_अस्ति(अधिकरणम् शब्दः पूर्णः, कर्म शब्दः अन्तः_) : सत्यता {
    पूर्णाङ्कः न् = दीर्घता(अन्तः_)।
    पूर्णाङ्कः म् = दीर्घता(पूर्णः)।
    यदि (न् > म्) {
        प्रत्यागच्छ असत्य।
    }
    प्रत्येकम् (क अन्तः परास(०, न्)) {
        यदि (पूर्णः[म् - न् + क] != अन्तः_[क]) {
            प्रत्यागच्छ असत्य।
        }
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् पुनरावृत्तिः(कर्म शब्दः स, पूर्णाङ्कः वारम्) : शब्दः {
    शब्दः फलम् = ""।
    आवृत्तिः (वारम्) {
        फलम् = फलम् + स।
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् पूरय(कर्म शब्दः स, पूर्णाङ्कः दैर्घ्यम्, शब्दः अक्षरम्) : शब्दः {
    शब्दः फलम् = स।
    यावत् (दीर्घता(फलम्) < दैर्घ्यम्) {
        फलम् = अक्षरम् + फलम्।
    }
    प्रत्यागच्छ फलम्।
}

# अक्षरशः विभजनम् — वर्णैः न, अक्षरैः। "वाक्" → ["वा", "क्"]
कार्यम् अक्षरसूची(कर्म शब्दः स) : सूची {
    प्रत्यागच्छ अक्षराणि(स)।
}

कार्यम् विलोमः_वा(कर्म शब्दः स) : सत्यता {
    प्रत्यागच्छ स == विपर्यय(स)।
}

कार्यम् गणय_अक्षरम्(कर्म शब्दः अक्षरम्, अधिकरणम् शब्दः वाक्यम्) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = ०।
    प्रत्येकम् (अ अन्तः वाक्यम्) {
        यदि (अ == अक्षरम्) {
            गणना = गणना + १।
        }
    }
    प्रत्यागच्छ गणना।
}

कार्यम् शब्दगणना(अधिकरणम् शब्दः वाक्यम्) : कोशः {
    कोशः गणना = {}।
    प्रत्येकम् (पदम् अन्तः विभज(वाक्यम्, " ")) {
        यदि (पदम् != "") {
            यदि (अस्ति(गणना, पदम्)) {
                गणना[पदम्] = गणना[पदम्] + १।
            } अन्यथा {
                गणना[पदम्] = १।
            }
        }
    }
    प्रत्यागच्छ गणना।
}

# छिन्द — रिक्ताक्षराणि उभयतः त्यजति / drop whitespace from both ends.
# आदौ_छिन्द तथा अन्ते_छिन्द एकैकस्मात् पार्श्वात्।
कार्यम् रिक्तम्_वा(कर्म शब्दः अ) : सत्यता {
    प्रत्यागच्छ अ == " " वा अ == "\t" वा अ == "\n" वा अ == "\r"।
}

कार्यम् आदौ_छिन्द(कर्म शब्दः स) : शब्दः {
    पूर्णाङ्कः आदिः = ०।
    यावत् (आदिः < दीर्घता(स) च रिक्तम्_वा(स[आदिः])) {
        आदिः = आदिः + १।
    }
    प्रत्यागच्छ अंशः(स, आदिः, दीर्घता(स))।
}

कार्यम् अन्ते_छिन्द(कर्म शब्दः स) : शब्दः {
    पूर्णाङ्कः अन्तिमः = दीर्घता(स)।
    यावत् (अन्तिमः > ० च रिक्तम्_वा(स[अन्तिमः - १])) {
        अन्तिमः = अन्तिमः - १।
    }
    प्रत्यागच्छ अंशः(स, ०, अन्तिमः)।
}

कार्यम् छिन्द(कर्म शब्दः स) : शब्दः {
    प्रत्यागच्छ अन्ते_छिन्द(आदौ_छिन्द(स))।
}

# प्रतिस्थापय — पुरातनस्य सर्वाणि आगमनानि नूतनेन स्थापयति।
#
# कारकाणि: वाक्यम् अधिकरणम् — यत्र स्थापनम् भवति; पुरातनम् कर्म — यत् अपनीयते;
# नूतनम् करणम् — येन स्थाप्यते।  The sentence is the locus the replacing happens
# in, the old text is what the action acts on, and the new text is the means.
#
# The scan steps over the replacement rather than through it, so a नूतनम् that
# contains पुरातनम् does not feed itself — प्रतिस्थापय("अअ", "अ", "अअ") gives
# "अअअअ" and not an endless string.  An empty पुरातनम् matches everywhere and
# would never advance, so it returns वाक्यम् untouched.
कार्यम् प्रतिस्थापय(अधिकरणम् शब्दः वाक्यम्, कर्म शब्दः पुरातनम्,
                    करणम् शब्दः नूतनम्) : शब्दः {
    पूर्णाङ्कः न् = दीर्घता(पुरातनम्)।
    यदि (न् == ०) {
        प्रत्यागच्छ वाक्यम्।
    }
    शब्दः फलम् = ""।
    पूर्णाङ्कः क = ०।
    पूर्णाङ्कः सीमा = दीर्घता(वाक्यम्)।
    यावत् (क < सीमा) {
        यदि (क + न् <= सीमा च अंशः(वाक्यम्, क, क + न्) == पुरातनम्) {
            फलम् = फलम् + नूतनम्।
            क = क + न्।
        } अन्यथा {
            फलम् = फलम् + वाक्यम्[क]।
            क = क + १।
        }
    }
    प्रत्यागच्छ फलम्।
}
