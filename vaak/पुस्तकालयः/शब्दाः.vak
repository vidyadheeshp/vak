# शब्दाः — the string module of the Vāk standard library.
# स्वयम् वाक्-भाषायाम् एव लिखितम् / written in Vāk itself.
#
#     आनय "शब्दाः" तः विलोमः_वा, पुनरावृत्तिः।

कार्यम् आदौ_अस्ति(अधिकरणम् शब्दः पूर्णः, कर्म शब्दः आदिः) : सत्यता {
    पूर्णाङ्कः न् = दीर्घता(आदिः)।
    यदि (न् > दीर्घता(पूर्णः)) {
        प्रत्यागच्छ असत्य।
    }
    प्रत्येकम् (क अन्तः परास(०, न्)) {
        यदि (पूर्णः[क] != आदिः[क]) {
            प्रत्यागच्छ असत्य।
        }
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् अन्ते_अस्ति(अधिकरणम् शब्दः पूर्णः, कर्म शब्दः अन्तः_) : सत्यता {
    पूर्णाङ्कः न् = दीर्घता(अन्तः_)।
    पूर्णाङ्कः म् = दीर्घता(पूर्णः)।
    यदि (न् > म्) {
        प्रत्यागच्छ असत्य।
    }
    प्रत्येकम् (क अन्तः परास(०, न्)) {
        यदि (पूर्णः[म् - न् + क] != अन्तः_[क]) {
            प्रत्यागच्छ असत्य।
        }
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् पुनरावृत्तिः(कर्म शब्दः स, पूर्णाङ्कः वारम्) : शब्दः {
    शब्दः फलम् = ""।
    आवृत्तिः (वारम्) {
        फलम् = फलम् + स।
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् पूरय(कर्म शब्दः स, पूर्णाङ्कः दैर्घ्यम्, शब्दः अक्षरम्) : शब्दः {
    शब्दः फलम् = स।
    यावत् (दीर्घता(फलम्) < दैर्घ्यम्) {
        फलम् = अक्षरम् + फलम्।
    }
    प्रत्यागच्छ फलम्।
}

# अक्षरशः विभजनम् — वर्णैः न, अक्षरैः। "वाक्" → ["वा", "क्"]
कार्यम् अक्षरसूची(कर्म शब्दः स) : सूची {
    प्रत्यागच्छ अक्षराणि(स)।
}

कार्यम् विलोमः_वा(कर्म शब्दः स) : सत्यता {
    प्रत्यागच्छ स == विपर्यय(स)।
}

कार्यम् गणय_अक्षरम्(कर्म शब्दः अक्षरम्, अधिकरणम् शब्दः वाक्यम्) : पूर्णाङ्कः {
    पूर्णाङ्कः गणना = ०।
    प्रत्येकम् (अ अन्तः वाक्यम्) {
        यदि (अ == अक्षरम्) {
            गणना = गणना + १।
        }
    }
    प्रत्यागच्छ गणना।
}

कार्यम् शब्दगणना(अधिकरणम् शब्दः वाक्यम्) : कोशः {
    कोशः गणना = {}।
    प्रत्येकम् (पदम् अन्तः विभज(वाक्यम्, " ")) {
        यदि (पदम् != "") {
            यदि (अस्ति(गणना, पदम्)) {
                गणना[पदम्] = गणना[पदम्] + १।
            } अन्यथा {
                गणना[पदम्] = १।
            }
        }
    }
    प्रत्यागच्छ गणना।
}
