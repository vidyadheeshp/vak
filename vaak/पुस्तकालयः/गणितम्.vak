# गणितम् — the mathematics module of the Vāk standard library.
# स्वयम् वाक्-भाषायाम् एव लिखितम् / written in Vāk itself.
#
#     आनय "गणितम्"।
#     मुद्रय गणितम्.क्रमगुणितम्(५)।

ध्रुव दशांशः पाई = ३.१४१५९२६५३५८९७९३।
ध्रुव दशांशः ई = २.७१८२८१८२८४५९०४५।

कार्यम् वर्गः(अङ्कः क) : अङ्कः {
    प्रत्यागच्छ क * क।
}

कार्यम् घनः(अङ्कः क) : अङ्कः {
    प्रत्यागच्छ क * क * क।
}

कार्यम् निरपेक्षम्(अङ्कः क) : अङ्कः {
    यदि (क < ०) {
        प्रत्यागच्छ ० - क।
    }
    प्रत्यागच्छ क।
}

कार्यम् चिह्नम्(अङ्कः क) : पूर्णाङ्कः {
    यदि (क > ०) { प्रत्यागच्छ १। }
    यदि (क < ०) { प्रत्यागच्छ -१। }
    प्रत्यागच्छ ०।
}

कार्यम् क्रमगुणितम्(पूर्णाङ्कः न्) : पूर्णाङ्कः {
    यदि (न् < ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "क्रमगुणितम् ऋणसंख्यायाः नास्ति" }।
    }
    पूर्णाङ्कः फलम् = १।
    प्रत्येकम् (क अन्तः परास(२, न् + १)) {
        फलम् = फलम् * क।
    }
    प्रत्यागच्छ फलम्।
}

# वर्गमूलम् — the square root, by Newton's method.  There is no floating-point
# सञ्चयः in the built-ins, so this is the arithmetic the language already has:
# guess, average the guess with न्/guess, repeat.  Twenty rounds is far more
# than double precision can distinguish.
कार्यम् वर्गमूलम्(अङ्कः क) : दशांशः {
    यदि (क < ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "वर्गमूलम् ऋणसंख्यायाः नास्ति" }।
    }
    यदि (क == ०) {
        प्रत्यागच्छ ०.०।
    }
    दशांशः अनुमानम् = क / २.०।
    आवृत्तिः (२०) {
        अनुमानम् = (अनुमानम् + क / अनुमानम्) / २.०।
    }
    प्रत्यागच्छ अनुमानम्।
}

# महत्तमः साधारणः भाजकः — the greatest common divisor (Euclid)
कार्यम् मसाभा(पूर्णाङ्कः अ, पूर्णाङ्कः ब) : पूर्णाङ्कः {
    पूर्णाङ्कः क = पूर्ण(निरपेक्षम्(अ))।
    पूर्णाङ्कः ख = पूर्ण(निरपेक्षम्(ब))।
    यावत् (ख != ०) {
        पूर्णाङ्कः शेषः = क % ख।
        क = ख।
        ख = शेषः।
    }
    प्रत्यागच्छ क।
}

# लघुत्तमः साधारणः गुणकः — the least common multiple
कार्यम् लसागु(पूर्णाङ्कः अ, पूर्णाङ्कः ब) : पूर्णाङ्कः {
    यदि (अ == ० वा ब == ०) {
        प्रत्यागच्छ ०।
    }
    प्रत्यागच्छ पूर्ण(निरपेक्षम्(अ * ब) / मसाभा(अ, ब))।
}

कार्यम् अभाज्यः_वा(पूर्णाङ्कः न्) : सत्यता {
    यदि (न् < २) { प्रत्यागच्छ असत्य। }
    पूर्णाङ्कः भाजकः = २।
    यावत् (भाजकः * भाजकः <= न्) {
        यदि (न् % भाजकः == ०) {
            प्रत्यागच्छ असत्य।
        }
        भाजकः = भाजकः + १।
    }
    प्रत्यागच्छ सत्य।
}

कार्यम् अभाज्याः_यावत्(पूर्णाङ्कः सीमा) : सूची {
    सूची फलम् = []।
    प्रत्येकम् (क अन्तः परास(२, सीमा + १)) {
        यदि (अभाज्यः_वा(क)) {
            योजय(फलम्, क)।
        }
    }
    प्रत्यागच्छ फलम्।
}

कार्यम् माध्यम्(अपादानम् सूची अङ्काः) : अङ्कः {
    यदि (दीर्घता(अङ्काः) == ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "रिक्तायाः सूच्याः माध्यमम् नास्ति" }।
    }
    प्रत्यागच्छ योग(अङ्काः) / दीर्घता(अङ्काः)।
}

कार्यम् मध्यमा(अपादानम् सूची अङ्काः) : अङ्कः {
    सूची क्रमिताः = क्रम(अङ्काः)।
    पूर्णाङ्कः न् = दीर्घता(क्रमिताः)।
    यदि (न् == ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "रिक्तायाः सूच्याः मध्यमा नास्ति" }।
    }
    यदि (न् % २ == १) {
        प्रत्यागच्छ क्रमिताः[पूर्ण(न् / २)]।
    }
    प्रत्यागच्छ (क्रमिताः[पूर्ण(न् / २) - १] + क्रमिताः[पूर्ण(न् / २)]) / २।
}

कार्यम् घातः(अङ्कः आधारः, पूर्णाङ्कः घाताङ्कः) : अङ्कः {
    प्रत्यागच्छ आधारः ^ घाताङ्कः।
}

# बहुलकः — सर्वाधिकं वारं आगच्छन् अङ्कः / the value that occurs most often.
#
# The list is sorted and the longest run taken, rather than counted in a कोशः,
# because that settles the tie rule as a side effect: when two values occur
# equally often the smaller is returned, and the answer does not depend on the
# order the values arrived in.  Say so, since "the mode" of a multi-modal list
# is otherwise a matter of opinion.
कार्यम् बहुलकः(अपादानम् सूची अङ्काः) : अङ्कः {
    पूर्णाङ्कः न् = दीर्घता(अङ्काः)।
    यदि (न् == ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "रिक्तायाः सूच्याः बहुलकः नास्ति" }।
    }
    सूची क्रमिताः = क्रम(अङ्काः)।
    अङ्कः श्रेष्ठम् = क्रमिताः[०]।
    पूर्णाङ्कः श्रेष्ठगणना = १।
    अङ्कः वर्तमानम् = क्रमिताः[०]।
    पूर्णाङ्कः गणना = १।
    प्रत्येकम् (क अन्तः परास(१, न्)) {
        यदि (क्रमिताः[क] == वर्तमानम्) {
            गणना = गणना + १।
        } अन्यथा {
            वर्तमानम् = क्रमिताः[क]।
            गणना = १।
        }
        यदि (गणना > श्रेष्ठगणना) {
            श्रेष्ठगणना = गणना।
            श्रेष्ठम् = वर्तमानम्।
        }
    }
    प्रत्यागच्छ श्रेष्ठम्।
}

# विचरणम् — समष्टिविचरणम् / the population variance: the mean of the squared
# deviations from the mean.  Population and not sample, so the divisor is न्
# and not न् − १; a single value therefore has a variance of zero rather than
# an error, which is the right answer for a population of one.
कार्यम् विचरणम्(अपादानम् सूची अङ्काः) : दशांशः {
    पूर्णाङ्कः न् = दीर्घता(अङ्काः)।
    यदि (न् == ०) {
        उत्सृज { "प्रकारः": "मूल्यदोषः", "सन्देशः": "रिक्तायाः सूच्याः विचरणम् नास्ति" }।
    }
    अङ्कः मध्यम् = माध्यम्(अङ्काः)।
    दशांशः योगः = ०.०।
    प्रत्येकम् (अ अन्तः अङ्काः) {
        दशांशः अन्तरम् = अ - मध्यम्।
        योगः = योगः + अन्तरम् * अन्तरम्।
    }
    प्रत्यागच्छ योगः / न्।
}

# प्रमाणविचलनम् — विचरणस्य वर्गमूलम् / the standard deviation.
कार्यम् प्रमाणविचलनम्(अपादानम् सूची अङ्काः) : दशांशः {
    प्रत्यागच्छ वर्गमूलम्(विचरणम्(अङ्काः))।
}
