{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vāk",
  "scopeName": "source.vak",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#karaka"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#control"
    },
    {
      "include": "#import"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#operator-word"
    },
    {
      "include": "#print"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#number"
    },
    {
      "include": "#danda"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.vak",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.vak",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vak",
          "match": "\\\\."
        }
      ]
    },
    "karaka": {
      "name": "entity.name.tag.karaka.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(सम्प्रदानम्|अधिकरणम्|अपादानम्|करणम्|कर्ता|कर्म)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "declaration": {
      "name": "storage.type.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(कार्यम्|dhruva|karyam|kāryam|karya|kārya|कार्य|ध्रुव|mana|māna|मान)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "control": {
      "name": "keyword.control.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(pratyagaccha|pratyāgaccha|प्रत्यागच्छ|प्रत्येकम्|pratyekam|prayatnah|prayatnaḥ|प्रत्येकम|anuvarta|vikalpah|vikalpaḥ|आवृत्तिः|प्रयत्नः|antatah|antataḥ|anyatha|anyathā|avrttih|grihana|pratida|pratidā|āvṛttiḥ|अनुवर्त|आवृत्ति|प्रतिदा|प्रयत्न|विकल्पः|gṛhāṇa|kshipa|pakshe|utsrja|utsṛja|virama|अन्ततः|अन्यथा|उत्सृज|विकल्प|antah|antaḥ|doshe|kṣipa|pakṣe|yavat|yāvat|अन्तः|अन्ते|क्षिप|गृहाण|पक्षे|यावत्|doṣe|kuru|yadi|कुरु|दोषे|यावत|विरम|यदि)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "import": {
      "name": "keyword.control.import.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(anaya|ānaya|iti|tah|taḥ|आनय|इति|तः)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "constant": {
      "name": "constant.language.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(asatya|shunya|satya|sunya|śūnya|असत्य|शून्य|सत्य)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "operator-word": {
      "name": "keyword.operator.word.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(ca|na|va|vā|वा|च|न)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "print": {
      "name": "keyword.other.print.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(mudraya|मुद्रय)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "type": {
      "name": "support.type.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(dashamshah|पूर्णाङ्कः|purnankah|pūrṇāṅkaḥ|पूर्णाङ्क|satyata|shabdah|shunyam|शून्यम्|kimapi|koshah|दशांशः|सत्यता|ankah|suchi|अङ्कः|किमपि|दशांश|शब्दः|अङ्क|कोशः|सूची|कोश)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])"
    },
    "builtin": {
      "name": "support.function.builtin.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])(sanchikapanktayah|khandam_chalaya|sanchikanashaya|सञ्चिकापङ्क्तयः|pratichchhedah|sanchikayojaya|dakshinasarah|sanchikapatha|sanchikalikh|sanchikasti|खण्डम्_चालय|प्रतिच्छेदः|सञ्चिकानाशय|सञ्चिकायोजय|सञ्चिकास्ति|adhikatama|devanagari|nirdeshika|yadrcchika|दक्षिणसारः|निर्देशिका|सञ्चिकालिख|aksharani|doshalikh|lakshanam|nyunatama|prachalah|vamasarah|viparyaya|कुञ्जिकाः|यादृच्छिक|सञ्चिकापठ|dirghata|nishkasa|samyogah|अक्षराणि|देवनागरी|प्राचलाः|मूल्यानि|kunjika|mulyani|prakara|purakah|samyoja|sanketa|sankhya|vibhaja|viyogah|दीर्घता|निष्कास|न्यूनतम|प्रयुज्|लक्षणम्|वामसारः|विपर्यय|parasa|prayuj|shabda|yojaya|अधिकतम|दोषलिख|प्रकार|वियोगः|संकेतः|संख्या|संयोगः|amsha|dosha|krama|patha|purna|suchi|varna|अस्ति|पूरकः|पूर्ण|वर्णः|संयोज|asti|kala|likh|mula|yoga|अंशः|क्रम|परास|योजय|विभज|शब्द|सूची|काल|दोष|मूल|योग|लिख|पठ)(?![\\w\\u0900-\\u0963\\u0966-\\u097F])(?=\\s*\\()"
    },
    "number": {
      "name": "constant.numeric.vak",
      "match": "(?<![\\w\\u0900-\\u0963\\u0966-\\u097F])[०-९0-9][०-९0-9._]*"
    },
    "danda": {
      "name": "punctuation.terminator.danda.vak",
      "match": "[।॥;]"
    },
    "function-call": {
      "name": "entity.name.function.vak",
      "match": "[\\w\\u0900-\\u0963\\u0966-\\u097F]+(?=\\s*\\()"
    },
    "operator": {
      "name": "keyword.operator.vak",
      "match": "\\+=|-=|\\*=|/=|%=|\\^=|==|!=|<=|>=|[+\\-*/%^<>=]"
    }
  }
}